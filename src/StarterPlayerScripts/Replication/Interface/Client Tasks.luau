	SukunaSlice = function(Params)
		local Character = Params.char
		local HRP       = Character.HumanoidRootPart
		local stage     = Params.stage

		local TweenService  = game:GetService("TweenService")
		local Debris        = game:GetService("Debris")
		local Lighting      = game:GetService("Lighting")
		local LocalPlayer   = game:GetService("Players").LocalPlayer
		local isOwner       = LocalPlayer.Character == Character

		local Assets = Resources.Sukuna1Assets

		-- [[ Helper: emit all ParticleEmitters in a model ]]:
		local function emitGroup(root)
			if not root then return end
			for _, v in pairs(root:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 10)
				end
			end
		end

		-- [[ Helper: set enabled on all emitters/beams in a model ]]:
		local function setEnabled(root, enabled)
			if not root then return end
			for _, v in pairs(root:GetDescendants()) do
				if v:IsA("ParticleEmitter") or v:IsA("Beam") then
					v.Enabled = enabled
				end
			end
		end

		-- [[ Helper: clone effect model, anchor parts, parent to Effects ]]:
		local function cloneEffect(template, pivotCF, lifetime)
			if not template then return nil end
			local clone = template:Clone()
			clone.Parent = workspace.Effects
			for _, part in pairs(clone:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
					part.Anchored   = true
				end
			end
			pcall(function() clone:PivotTo(pivotCF) end)
			Debris:AddItem(clone, lifetime or 5)
			return clone
		end

		-- =====================================================================
		if stage == "Start" then

			local hrpCF = Params.hrpCF

			-- [[ Wind shockwave wind-up at caster position ]]:
			local wind = cloneEffect(Assets.Wind, hrpCF, 3)
			if wind then
				setEnabled(wind, false)
				emitGroup(wind)
			end

			-- [[ Cleave slash VFX slightly in front of caster ]]:
			task.delay(0.35, function()
				local cleave = cloneEffect(Assets.Cleave, hrpCF * CFrame.new(0, 0, -3), 3)
				if cleave then
					setEnabled(cleave, false)
					emitGroup(cleave:FindFirstChild("K"))
					task.delay(0.05, function() emitGroup(cleave:FindFirstChild("K2")) end)
					task.delay(0.1,  function() emitGroup(cleave:FindFirstChild("K3")) end)
				end

				-- [[ Cleave2 ground slashes ]]:
				local cleave2 = cloneEffect(Assets.Cleave2, hrpCF * CFrame.new(0, 0, -3), 3.5)
				if cleave2 then
					setEnabled(cleave2, false)
					emitGroup(cleave2:FindFirstChild("Attachment"))
					emitGroup(cleave2:FindFirstChild("GroundSlashes"))
					task.delay(0.05, function()
						if cleave2:FindFirstChild("Particle_1") then cleave2.Particle_1:Emit(cleave2.Particle_1:GetAttribute("EmitCount") or 10) end
						if cleave2:FindFirstChild("Particle_2") then cleave2.Particle_2:Emit(cleave2.Particle_2:GetAttribute("EmitCount") or 10) end
						if cleave2:FindFirstChild("Particle_3") then cleave2.Particle_3:Emit(cleave2.Particle_3:GetAttribute("EmitCount") or 10) end
						if cleave2:FindFirstChild("Particle_4") then cleave2.Particle_4:Emit(cleave2.Particle_4:GetAttribute("EmitCount") or 10) end
					end)
				end
			end)

			-- [[ Owner color correction — dark slash flash ]]:
			if isOwner then
				task.delay(0.35, function()
					local cc = Instance.new("ColorCorrectionEffect")
					cc.Name   = "CleaverRushCC"
					cc.Parent = Lighting

					-- [[ Sharp white flash then desaturate into the slash ]]:
					local t1 = TweenService:Create(cc, TweenInfo.new(1/60, Enum.EasingStyle.Linear), {
						TintColor = Color3.fromRGB(255, 255, 255), Brightness = 1.5, Contrast = 2, Saturation = -1
					}) t1:Play()
					t1.Completed:Once(function()
						local t2 = TweenService:Create(cc, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {
							TintColor = Color3.fromRGB(180, 180, 180), Brightness = 0, Contrast = 0, Saturation = 0
						}) t2:Play()
						t2.Completed:Once(function()
							task.wait(2.0)
							local tf = TweenService:Create(cc, TweenInfo.new(0.3, Enum.EasingStyle.Linear), {
								TintColor = Color3.fromRGB(255, 255, 255), Brightness = 0, Contrast = 0, Saturation = 0
							}) tf:Play()
							tf.Completed:Once(function()
								if cc and cc.Parent then cc:Destroy() end
							end)
						end)
					end)
				end)
			end

			-- =====================================================================
		elseif stage == "Hit" then

			local enemyHrpCF = Params.enemyHrpCF

			-- [[ Blood splatter at enemy ]]:
			local blood = cloneEffect(Assets.Blood, CFrame.new(enemyHrpCF.Position), 4)
			if blood then emitGroup(blood:FindFirstChild("Attachment")) end

			-- [[ Dissect sparks/stars at enemy ]]:
			local dissect = cloneEffect(Assets.Dissect, CFrame.new(enemyHrpCF.Position), 4)
			if dissect then
				setEnabled(dissect, false)
				emitGroup(dissect:FindFirstChild("A"))
				emitGroup(dissect:FindFirstChild("A2"))
				task.delay(0.033, function()
					if dissect then
						emitGroup(dissect:FindFirstChild("Cut1"))
						emitGroup(dissect:FindFirstChild("Dots1"))
						emitGroup(dissect:FindFirstChild("K"))
					end
				end)
				task.delay(0.066, function()
					if dissect then
						for _, name in pairs({"Sparks4", "Sparksend", "Stars1", "star", "star2", "star3"}) do
							emitGroup(dissect:FindFirstChild(name))
						end
					end
				end)
			end

			-- [[ Red slash flash for owner on each hit ]]:
			if isOwner then
				local cc = Instance.new("ColorCorrectionEffect")
				cc.Parent = Lighting
				local t1 = TweenService:Create(cc, TweenInfo.new(1/60, Enum.EasingStyle.Linear), {
					TintColor = Color3.fromRGB(220, 60, 60), Brightness = 0.3, Contrast = 1, Saturation = -0.5
				}) t1:Play()
				t1.Completed:Once(function()
					TweenService:Create(cc, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {
						TintColor = Color3.fromRGB(255, 255, 255), Brightness = 0, Contrast = 0, Saturation = 0
					}):Play()
					task.delay(0.1, function()
						if cc and cc.Parent then cc:Destroy() end
					end)
				end)
			end

			-- =====================================================================
		elseif stage == "End" then
			-- server handles all cleanup
		end
	end,

	SukunaQuadDismantle = function(Params)
		local Character = Params.char
		local HRP       = Character.HumanoidRootPart
		local stage     = Params.stage

		local TweenService = game:GetService("TweenService")
		local Debris       = game:GetService("Debris")
		local Lighting     = game:GetService("Lighting")
		local LocalPlayer  = game:GetService("Players").LocalPlayer
		local isOwner      = LocalPlayer.Character == Character

		local Assets = Resources.Sukuna1Assets

		-- [[ Helpers ]]:
		local function emitGroup(root)
			if not root then return end
			for _, v in pairs(root:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 10)
				end
			end
		end

		local function cloneEffect(template, pivotCF, lifetime)
			if not template then return nil end
			local clone = template:Clone()
			clone.Parent = workspace.Effects
			for _, part in pairs(clone:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
					part.Anchored   = true
				end
			end
			pcall(function() clone:PivotTo(pivotCF) end)
			Debris:AddItem(clone, lifetime or 5)
			return clone
		end

		-- [[ Owner slash flash — alternates between wide and tight based on strikeIndex ]]:
		local function slashFlash(strikeIndex)
			if not isOwner then return end
			local isWide = (strikeIndex % 2 == 0)

			local cc = Instance.new("ColorCorrectionEffect")
			cc.Parent = Lighting

			local t1 = TweenService:Create(cc, TweenInfo.new(1/60, Enum.EasingStyle.Linear), {
				TintColor  = isWide and Color3.fromRGB(255, 200, 100) or Color3.fromRGB(255, 255, 255),
				Brightness = isWide and 0.8 or 1.2,
				Contrast   = 2,
				Saturation = -1,
			}) t1:Play()
			t1.Completed:Once(function()
				TweenService:Create(cc, TweenInfo.new(0.12, Enum.EasingStyle.Linear), {
					TintColor  = Color3.fromRGB(255, 255, 255),
					Brightness = 0, Contrast = 0, Saturation = 0,
				}):Play()
				task.delay(0.12, function()
					if cc and cc.Parent then cc:Destroy() end
				end)
			end)
		end

		-- =====================================================================
		if stage == "Start" then

			local hrpCF = Params.hrpCF

			-- [[ Dismantle slash wind-up at caster ]]:
			local dismantle = cloneEffect(Assets.Dismantle, hrpCF * CFrame.new(0, 0, -3), 2.5)
			if dismantle then emitGroup(dismantle:FindFirstChild("K")) end

			-- [[ Owner: dark desaturate into the move ]]:
			if isOwner then
				local cc = Instance.new("ColorCorrectionEffect")
				cc.Name   = "QuadDismantleCC"
				cc.Parent = Lighting

				local t1 = TweenService:Create(cc, TweenInfo.new(0.15, Enum.EasingStyle.Linear), {
					TintColor = Color3.fromRGB(160, 160, 160), Brightness = -0.2, Contrast = 0.5, Saturation = -0.5,
				}) t1:Play()
				t1.Completed:Once(function()
					task.wait(1.5)
					TweenService:Create(cc, TweenInfo.new(0.3, Enum.EasingStyle.Linear), {
						TintColor = Color3.fromRGB(255, 255, 255), Brightness = 0, Contrast = 0, Saturation = 0,
					}):Play()
					task.delay(0.3, function()
						if cc and cc.Parent then cc:Destroy() end
					end)
				end)
			end

			-- =====================================================================
		elseif stage == "Hit" then

			local strikeIndex = Params.strikeIndex
			local enemyHrpCF  = Params.enemyHrpCF
			local hrpCF       = Params.hrpCF
			local isWide      = (strikeIndex % 2 == 0)

			-- [[ Slash VFX at caster — alternates Cleave (tight) and Cleave2 (wide) ]]:
			if isWide then
				local cleave2 = cloneEffect(Assets.Cleave2, hrpCF * CFrame.new(0, 0, -3), 2)
				if cleave2 then
					emitGroup(cleave2:FindFirstChild("Attachment"))
					emitGroup(cleave2:FindFirstChild("GroundSlashes"))
					task.delay(0.05, function()
						for i = 1, 4 do
							local p = cleave2:FindFirstChild("Particle_" .. i)
							if p then p:Emit(p:GetAttribute("EmitCount") or 10) end
						end
					end)
				end
			else
				local cleave = cloneEffect(Assets.Cleave, hrpCF * CFrame.new(0, 0, -3), 2)
				if cleave then
					emitGroup(cleave:FindFirstChild("K"))
					task.delay(0.04, function() emitGroup(cleave and cleave:FindFirstChild("K2")) end)
					task.delay(0.08, function() emitGroup(cleave and cleave:FindFirstChild("K3")) end)
				end
			end

			-- [[ Blood + Dissect at enemy ]]:
			local blood = cloneEffect(Assets.Blood, CFrame.new(enemyHrpCF.Position), 4)
			if blood then emitGroup(blood:FindFirstChild("Attachment")) end

			local dissect = cloneEffect(Assets.Dissect, CFrame.new(enemyHrpCF.Position), 4)
			if dissect then
				emitGroup(dissect:FindFirstChild("A"))
				emitGroup(dissect:FindFirstChild("A2"))
				task.delay(0.033, function()
					if dissect then
						emitGroup(dissect:FindFirstChild("Cut1"))
						emitGroup(dissect:FindFirstChild("Dots1"))
						emitGroup(dissect:FindFirstChild("K"))
					end
				end)
				task.delay(0.066, function()
					if dissect then
						for _, name in pairs({"Sparks4", "Sparksend", "Stars1", "star", "star2", "star3"}) do
							local obj = dissect:FindFirstChild(name)
							if obj and obj:IsA("ParticleEmitter") then
								obj:Emit(obj:GetAttribute("EmitCount") or 10)
							end
						end
					end
				end)
			end

			-- [[ Per-strike flash ]]:
			slashFlash(strikeIndex)

			-- =====================================================================
		elseif stage == "End" then
			-- server handles cleanup
		end
	end,

	Obliteration = function(Params)
		local stage     = Params.stage
		local Character = Params.char   -- attacker character Model
		local Enemy     = Params.enemy  -- victim character Model (already Model, not Player)

		local TweenService      = game:GetService("TweenService")
		local Debris            = game:GetService("Debris")
		local Lighting          = game:GetService("Lighting")
		local Players           = game:GetService("Players")
		local RunService        = game:GetService("RunService")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local LocalPlayer       = Players.LocalPlayer
		local Camera            = workspace.CurrentCamera
		local isOwner           = Character and LocalPlayer.Character == Character
		local isVictim          = Enemy     and LocalPlayer.Character == Enemy

		-- [[ Asset path ]]:
		local ObliterationAssets = ReplicatedStorage.Resources.Shinji.obliteration
		local Particles          = ObliterationAssets.Particles.Emotes.Obliteration
		local Cutscenes          = ObliterationAssets.Cutscenes.Obliteration

		local HRP      = Character and Character:FindFirstChild("HumanoidRootPart")
		local EnemyHRP = Enemy     and Enemy:FindFirstChild("HumanoidRootPart")

		local hrpCF      = Params.hrpCF      or (HRP      and HRP.CFrame)
		local enemyHrpCF = Params.enemyHrpCF or (EnemyHRP and EnemyHRP.CFrame)

		local function getEnemyCF()
			if EnemyHRP then return CFrame.new(EnemyHRP.Position) end
			if enemyHrpCF then return CFrame.new(enemyHrpCF.Position) end
			return nil
		end

		local function getCharCF()
			if HRP then return CFrame.new(HRP.Position) end
			if hrpCF then return CFrame.new(hrpCF.Position) end
			return nil
		end

		local function emitGroup(root)
			if not root then return end
			for _, v in pairs(root:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 12)
				end
			end
		end

		local function setEnabled(root, enabled)
			if not root then return end
			for _, v in pairs(root:GetDescendants()) do
				if v:IsA("ParticleEmitter") or v:IsA("Beam") then
					v.Enabled = enabled
				end
			end
		end

		local function cloneAtCF(template, cf, lifetime)
			if not template or not cf then return nil end
			local c = template:Clone()
			c.Parent = workspace.Effects
			for _, p in pairs(c:GetDescendants()) do
				if p:IsA("BasePart") then p.CanCollide = false; p.Anchored = true end
			end
			pcall(function() c:PivotTo(cf) end)
			Debris:AddItem(c, lifetime or 4)
			return c
		end

		local function ccFlash(r, g, b, bright, contrast, sat, fade)
			if not isOwner then return end
			local cc = Instance.new("ColorCorrectionEffect")
			cc.Parent = Lighting
			local t = TweenService:Create(cc, TweenInfo.new(1/60), {
				TintColor = Color3.fromRGB(r,g,b), Brightness = bright, Contrast = contrast, Saturation = sat,
			})
			t:Play()
			t.Completed:Once(function()
				TweenService:Create(cc, TweenInfo.new(fade, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					TintColor = Color3.fromRGB(255,255,255), Brightness = 0, Contrast = 0, Saturation = 0,
				}):Play()
				task.delay(fade, function() if cc and cc.Parent then cc:Destroy() end end)
			end)
		end

		local function playSound(sfxName, parent)
			local s = ObliterationAssets:FindFirstChild(sfxName, true)
			if s and s:IsA("Sound") then
				local clone = s:Clone()
				clone.Parent = parent or workspace
				clone:Play()
				Debris:AddItem(clone, clone.TimeLength + 1)
			end
		end

		local function beamBurst(model, duration)
			for _, v in pairs(model:GetDescendants()) do
				if v:IsA("Beam") then
					v.Enabled = true
					task.delay(duration or 0.4, function()
						if v and v.Parent then v.Enabled = false end
					end)
				end
			end
		end

		-- ── STAGES ────────────────────────────────────────────────────────

		if stage == "ObliterationCam" then
			if not isOwner then return end
			local fovFolder = Cutscenes:FindFirstChild("FOV")
			if not fovFolder then return end
			local c = fovFolder:Clone()
			c.Parent = workspace
			Debris:AddItem(c, 14)
			if HRP then pcall(function() c:PivotTo(HRP.CFrame) end)
			elseif hrpCF then pcall(function() c:PivotTo(hrpCF) end) end
			local primaryPart = c:FindFirstChild("Primary", true)
			local attachPoint = c:FindFirstChild("Attach",  true)
			if primaryPart then
				local oldCamType = Camera.CameraType
				Camera.CameraType = Enum.CameraType.Scriptable
				local conn
				conn = RunService.RenderStepped:Connect(function()
					if not (primaryPart and primaryPart.Parent) then
						conn:Disconnect()
						Camera.CameraType = oldCamType
						return
					end
					if attachPoint and attachPoint.Parent then
						Camera.CFrame = attachPoint.WorldCFrame
					else
						Camera.CFrame = primaryPart.CFrame
					end
				end)
				task.delay(14, function()
					pcall(function() conn:Disconnect() end)
					Camera.CameraType = oldCamType
				end)
			end

		elseif stage == "ObliterationSFX" then
			if not isOwner then return end
			playSound("ObliterationEmote", HRP)

		elseif stage == "ObliterationKick" then
			local pos = getEnemyCF()
			if pos then
				local contact = cloneAtCF(Particles.Contact, pos, 3)
				if contact then
					emitGroup(contact)
					local ring = contact:FindFirstChild("ring")
					if ring then setEnabled(ring, true) end
				end
				local kick = cloneAtCF(Particles.Kick, pos, 3)
				if kick then
					emitGroup(kick)
					local ring = kick:FindFirstChild("ring")
					if ring then setEnabled(ring, true) end
				end
			end
			ccFlash(255, 225, 190, 0.7, 1.0, -0.3, 0.2)

		elseif stage == "ObliterationKick1Release" then
			local pos = getEnemyCF()
			if pos then
				local ek3 = cloneAtCF(Particles.EmoteKick3, pos, 2.5)
				if ek3 then emitGroup(ek3) end
			end

		elseif stage == "ObliterationKick2" then
			local pos = getEnemyCF()
			if pos then
				local contact = cloneAtCF(Particles.Contact, pos, 3)
				if contact then emitGroup(contact) end
				local kick = cloneAtCF(Particles.Kick, pos, 2.5)
				if kick then emitGroup(kick) end
			end
			ccFlash(255, 215, 175, 0.8, 1.2, -0.3, 0.2)

		elseif stage == "ObliterationSlash1" then
			local pos = getEnemyCF()
			if pos then
				local slash = cloneAtCF(Particles.Slash, pos, 3)
				if slash then emitGroup(slash) end
				local contact = cloneAtCF(Particles.Contact, pos, 2.5)
				if contact then emitGroup(contact) end
			end
			ccFlash(220, 220, 255, 0.6, 0.9, -0.2, 0.15)

		elseif stage == "ObliterationKick3" then
			local pos = getEnemyCF()
			if pos then
				local contact = cloneAtCF(Particles.Contact, pos, 3)
				if contact then emitGroup(contact) end
				local ek3 = cloneAtCF(Particles.EmoteKick3, pos, 2.5)
				if ek3 then emitGroup(ek3) end
			end
			ccFlash(255, 218, 175, 0.9, 1.3, -0.4, 0.2)

		elseif stage == "ObliterationSwordSpin" then
			-- Fires twice: once with enemy, once with char — handle both
			local targetPos = getEnemyCF() or getCharCF()
			if targetPos then
				local spin = cloneAtCF(Particles.EmoteSwordSpin, targetPos, 4)
				if spin then
					emitGroup(spin)
					local ring = spin:FindFirstChild("ring")
					if ring then setEnabled(ring, true) end
					if spin:FindFirstChild("BeamSlash") then beamBurst(spin, 0.5) end
				end
			end
			local charPos = getCharCF()
			if charPos then
				local gs = cloneAtCF(Particles.EmoteSwordSpin, charPos, 3)
				if gs then
					local g = gs:FindFirstChild("GroundSw")
					if g then emitGroup(g) end
				end
			end
			ccFlash(200, 225, 255, 1.2, 2.0, -0.8, 0.3)

		elseif stage == "SwordSpinEnd" then
			local charPos = getCharCF()
			if charPos then
				local spin = cloneAtCF(Particles.EmoteSwordSpin, charPos, 3)
				if spin then
					local lw = spin:FindFirstChild("LightWind1")
					if lw then emitGroup(lw) end
					local m2 = spin:FindFirstChild("mesh2")
					if m2 then emitGroup(m2) end
				end
			end

		elseif stage == "ObliterationSlash2"
			or stage == "ObliterationSlash3"
			or stage == "ObliterationSlash4"
			or stage == "ObliterationSlash5"
			or stage == "ObliterationSlash6"
			or stage == "ObliterationSlash7" then
			local pos = getEnemyCF()
			if pos then
				local slash = cloneAtCF(Particles.Slash, pos, 2.5)
				if slash then emitGroup(slash) end
				local num = tonumber(stage:match("%d+$"))
				if num and num % 2 == 0 then
					local contact = cloneAtCF(Particles.Contact, pos, 2)
					if contact then emitGroup(contact) end
				end
			end
			ccFlash(215, 218, 255, 0.5, 0.7, -0.15, 0.12)

		elseif stage == "ObliterationSpinDrop" then
			local pos = getEnemyCF()
			if pos then
				local spin = cloneAtCF(Particles.EmoteSwordSpin, pos, 3.5)
				if spin then
					emitGroup(spin)
					local ring = spin:FindFirstChild("ring")
					if ring then setEnabled(ring, true) end
					beamBurst(spin, 0.4)
				end
				local contact = cloneAtCF(Particles.Contact, pos, 3)
				if contact then emitGroup(contact) end
			end
			local charPos = getCharCF()
			if charPos then
				local gs = cloneAtCF(Particles.EmoteSwordSpin, charPos, 3)
				if gs then
					local g = gs:FindFirstChild("GroundSw")
					if g then emitGroup(g) end
				end
			end
			ccFlash(190, 215, 255, 1.4, 2.2, -0.9, 0.3)

		elseif stage == "ObliterationBlitz" then
			local pos = getEnemyCF()
			if pos then
				local fc = cloneAtCF(Particles.FinalCut, pos, 5)
				if fc then emitGroup(fc) end
				local contact = cloneAtCF(Particles.Contact, pos, 3)
				if contact then emitGroup(contact) end
				local kick = cloneAtCF(Particles.Kick, pos, 3)
				if kick then
					emitGroup(kick)
					local ring = kick:FindFirstChild("ring")
					if ring then setEnabled(ring, true) end
				end
				local spin = cloneAtCF(Particles.EmoteSwordSpin, pos, 4)
				if spin then
					emitGroup(spin)
					beamBurst(spin, 0.6)
				end
			end
			local charPos = getCharCF()
			if charPos then
				local camFX = cloneAtCF(Particles.CamFX, charPos, 4)
				if camFX then emitGroup(camFX) end
			end
			playSound("ObliterationFinalCutEmc", EnemyHRP or workspace)
			ccFlash(255, 255, 255, 2.5, 3.0, -1.5, 0.5)

		elseif stage == "ObliterationBlitzV" then
			if not isVictim then return end
			local cc = Instance.new("ColorCorrectionEffect")
			cc.Parent = Lighting
			TweenService:Create(cc, TweenInfo.new(1/60), {
				TintColor = Color3.fromRGB(255,255,255), Brightness = 3, Contrast = 4, Saturation = -2,
			}):Play()
			task.delay(0.06, function()
				TweenService:Create(cc, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					TintColor = Color3.fromRGB(255,255,255), Brightness = 0, Contrast = 0, Saturation = 0,
				}):Play()
				task.delay(1.2, function() if cc and cc.Parent then cc:Destroy() end end)
			end)

		elseif stage == "ObliterationSlice" then
			local pos = getEnemyCF()
			if pos then
				local slash = cloneAtCF(Particles.Slash, pos, 5)
				if slash then emitGroup(slash) end
				local fc = cloneAtCF(Particles.FinalCut, pos, 5)
				if fc then emitGroup(fc) end
			end
			playSound("ObliterationOutsideEmo", EnemyHRP or workspace)

		elseif stage == "CObliteration" then
			local charPos = getCharCF()
			if charPos then
				local container = cloneAtCF(Particles.Container, charPos, 3)
				if container then emitGroup(container) end
			end
			if isOwner then
				for _, v in pairs(Lighting:GetChildren()) do
					if v:IsA("ColorCorrectionEffect") then
						TweenService:Create(v, TweenInfo.new(0.5), {
							Brightness = 0, Contrast = 0, Saturation = 0,
							TintColor  = Color3.fromRGB(255,255,255),
						}):Play()
						task.delay(0.5, function() if v and v.Parent then v:Destroy() end end)
					end
				end
				Camera.CameraType = Enum.CameraType.Custom
			end
		end
	end,



	GlobalWeld = function(Params)
		local action  = Params.action
		local target  = Params.target   -- victim Model
		local anchor  = Params.anchor   -- attacker HumRP (ConnectWeld only)
		local part    = Params.part     -- victim HumRP (ConnectWeld only)
		local offset  = Params.offset   -- CFrame offset (ConnectWeld only)

		if not target then return end

		-- Store welds per target in _G so DisconnectWeld can find them
		if not _G.GlobalWelds then _G.GlobalWelds = {} end

		if action == "ConnectWeld" then
			if not anchor or not part then return end

			-- Disconnect any existing weld first
			if _G.GlobalWelds[target] then
				pcall(function() _G.GlobalWelds[target]:Destroy() end)
				_G.GlobalWelds[target] = nil
			end

			-- Anchor victim in place
			part.Anchored = true
			part.CanCollide = false

			local weld = Instance.new("Weld")
			weld.Name = "GlobalWeld"
			weld.Part0 = anchor
			weld.Part1 = part
			weld.C0 = offset or CFrame.new(0, 0, -3) * CFrame.Angles(0, math.pi, 0)
			weld.Parent = anchor

			part.Anchored = false

			_G.GlobalWelds[target] = weld

		elseif action == "DisconnectWeld" then
			if _G.GlobalWelds[target] then
				pcall(function() _G.GlobalWelds[target]:Destroy() end)
				_G.GlobalWelds[target] = nil
			end

			-- Unanchor victim
			local hrp = target:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.Anchored = false
				hrp.CanCollide = true
			end
		end
	end,

	GoodbyeNowTheSorrowInYou = function(Params)
		local Stage     = Params.Stage
		local Character = Params.char
		local Enemy     = Params.enemy

		local TweenService = game:GetService("TweenService")
		local Debris       = game:GetService("Debris")
		local RunService   = game:GetService("RunService")
		local Lighting     = game:GetService("Lighting")
		local Players      = game:GetService("Players")
		local LocalPlayer  = Players.LocalPlayer
		local Camera       = workspace.CurrentCamera
		local defaultFOV   = Camera.FieldOfView

		local isOwner = Character and LocalPlayer.Character == Character

		local assets = Resources["SolemnLament"]
		local VFX    = assets.VFX

		local hrpCF   = Params.hrpCF
		local enemyCF = Params.enemyCF

		local HRP     = Character and Character:FindFirstChild("HumanoidRootPart")
		local LeftArm = Character and (Character:FindFirstChild("Left Arm") or Character:FindFirstChild("LeftLowerArm"))

		-- ── Helpers ───────────────────────────────────────────────────────

		local function camShake(intensity, duration)
			if not isOwner then return end
			local start = tick()
			local conn
			conn = RunService.RenderStepped:Connect(function()
				if tick() - start > duration then conn:Disconnect(); return end
				Camera.CFrame = Camera.CFrame * CFrame.new(
					(math.random() - 0.5) * intensity,
					(math.random() - 0.5) * intensity,
					(math.random() - 0.5) * intensity
				)
			end)
		end

		local function camZoom(targetFOV, time)
			if not isOwner then return end
			TweenService:Create(
				Camera,
				TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ FieldOfView = targetFOV }
			):Play()
		end

		local function screenEffect(duration)
			if not isOwner then return end
			local tint = Lighting:FindFirstChild("HitTint")
			if not tint then return end
			tint.TintColor  = Color3.fromRGB(170, 200, 255)
			tint.Saturation = -0.4
			tint.Brightness = -0.05
			tint.Contrast   = 0.1
			task.delay(duration, function()
				TweenService:Create(tint, TweenInfo.new(0.25), {
					TintColor  = Color3.fromRGB(255, 255, 255),
					Saturation = 0, Brightness = 0, Contrast = 0,
				}):Play()
			end)
		end

		-- Shot VFX attached to left arm so it moves with the player during dashes
		local function emitVFXOnArm(vfxName)
			if not LeftArm then return end
			local template = VFX:FindFirstChild(vfxName)
			if not template then return end
			local clone = template:Clone()
			clone.Parent = workspace.Effects
			clone:PivotTo(LeftArm.CFrame)
			local weld  = Instance.new("WeldConstraint")
			weld.Part0  = LeftArm
			weld.Part1  = clone
			weld.Parent = clone
			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 25)
				end
			end
			task.delay(0.1, function()
				for _, v in ipairs(clone:GetDescendants()) do
					if v:IsA("ParticleEmitter") then
						TweenService:Create(v, TweenInfo.new(0.3), { Rate = 0 }):Play()
					end
				end
			end)
			Debris:AddItem(clone, 0.5)
		end

		local function emitVFX(vfxName, cf)
			local template = VFX:FindFirstChild(vfxName)
			if not template then return end
			local clone = template:Clone()
			clone.Parent = workspace.Effects
			pcall(function() clone:PivotTo(cf) end)
			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 25)
				end
			end
			task.delay(0.1, function()
				for _, v in ipairs(clone:GetDescendants()) do
					if v:IsA("ParticleEmitter") then
						TweenService:Create(v, TweenInfo.new(0.3), { Rate = 0 }):Play()
					end
				end
			end)
			Debris:AddItem(clone, 0.5)
		end

		-- ── Stages ────────────────────────────────────────────────────────

		if Stage == "shot" then
			emitVFXOnArm(Params.vfx)
			camShake(0.2, 0.15)
			camZoom(80, 0.06)
			task.wait(0.06)
			camZoom(defaultFOV, 0.12)

		elseif Stage == "roar" then
			-- Big AOE finisher — screen effect, dramatic zoom out then back
			if hrpCF then
				emitVFX("endShot", CFrame.new(hrpCF.Position))
			end
			screenEffect(1.5)
			camShake(0.4, 0.3)
			camZoom(35, 1)
			task.wait(0.08)
			camZoom(150, 0.5)
			task.wait(1.5)
			camZoom(defaultFOV, 0.15)

		elseif Stage == "hit" then
			if enemyCF then
				emitVFX("hit", CFrame.new(enemyCF.Position))
			end
		end
	end,

