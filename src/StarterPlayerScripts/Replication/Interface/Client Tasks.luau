	grandfissurewall = function(Params)
		local Character: Model = Params.Char
		local Stage = Params.Stage

		if Stage == "Start" then
			local Wall = Resources.Suiryu.GrandFissure.Wall:Clone()
			Wall:AddTag(Params.Bind.Name .. "Wall")
			Wall:PivotTo(Params.MainCF * CFrame.new(0.131, 15.279, -9.156) * CFrame.Angles(0, math.pi, 0))
			Wall.Parent = workspace.Thrown

			task.spawn(function()
				local GroundRay = workspace:Raycast(Wall.RootPart.Position + Vector3.new(0, 3, 0), Vector3.new(0, -40, 0), MapRayParams)
				if GroundRay then
					Wall.MaterialPart.Color = GroundRay.Instance.Color
					Wall.MaterialPart.Material = GroundRay.Instance.Material
				end
			end)


			local MissAnimation = Wall.AnimationController.Animator:LoadAnimation(Wall.Miss)

			MissAnimation:GetMarkerReachedSignal("hitground"):Once(function()
				shared.repfire("grandfissurestart", { 
					Char = Character,
					AnimationId = Params.AnimationId,
					MainCF = Params.MainCF,
					byp = true
				})

				task.spawn(function()
					local Intensity = 7

					for i = 1, 0.7/0.03 do
						shared.addshake(Intensity)

						Intensity *= 0.9

						task.wait(0.03)
					end
				end)

				Wall:Destroy()
			end)


			MissAnimation:Play()

			Wall.MaterialPart.WallRise:Play()
			local WallDownSound = SoundsModule:AddSound(Wall.MaterialPart.WallDown, Wall.MaterialPart.Position)

			Wall:GetAttributeChangedSignal("DestroyDownSound"):Once(function()
				WallDownSound:Destroy()
			end)

		elseif Stage == "Hit" then
			local Wall = CollectionService:GetTagged(Params.Bind.Name .. "Wall")[1]						
			if not Wall then return end

			for _,v in Wall.AnimationController.Animator:GetPlayingAnimationTracks() do
				v:Stop()
			end

			Wall.RootPart.Anchored = false
			Wall.RootPart.Weld.Part0 = Character.HumanoidRootPart


			local HitAnimation = Wall.AnimationController.Animator:LoadAnimation(Wall.Hit)

			HitAnimation:GetMarkerReachedSignal("hidewall"):Once(function()
				for _, Part in Wall:GetDescendants() do
					if Part:IsA("MeshPart") or Part:IsA("Part") then
						TS:Create(Part, TweenInfo.new(0.5), {
							Transparency = 1
						}):Play()
					end
				end

				Debris:AddItem(Wall, 0.5)
			end)

			HitAnimation:Play()

			Wall:SetAttribute("DestroyDownSound", true)
		end
	end,

