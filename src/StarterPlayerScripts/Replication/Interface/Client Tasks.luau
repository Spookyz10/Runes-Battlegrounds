	strike = function(Params)
		local character = Params.char

		local TweenService = game:GetService("TweenService")
		local Debris = game:GetService("Debris")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")

		local HumRP = character:FindFirstChildOfClass("Humanoid").RootPart
		local Visuals = ReplicatedStorage.Assets.Visuals.Madara

		-- Strike lands 30 studs in front
		local StrikePos = HumRP.CFrame * CFrame.new(0, 0, -30)

		local StrikeClone = Visuals.LightningStrike:Clone()
		StrikeClone.Parent = workspace.Effects
		StrikeClone.CFrame = StrikePos
		for _, v in StrikeClone:GetDescendants() do
			if v:IsA("ParticleEmitter") then v:Emit(30) end
		end

		for i = 1, math.random(4, 8) do
			local Velocity = 35
			local bits = Visuals.FlyingRocks:Clone()
			bits.Parent = workspace.Effects
			bits.CFrame = StrikeClone.CFrame
			bits.Size = Vector3.one * 1.5
			bits.Material = Enum.Material.Concrete
			bits.Color = Color3.new(0.258, 0.258, 0.258)

			local vel = Instance.new("BodyVelocity", bits)
			vel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			vel.Velocity = bits.CFrame.LookVector * math.random(-Velocity, Velocity) * 2
				+ Vector3.new(math.random(-Velocity, Velocity), math.random(0, Velocity), math.random(-Velocity, Velocity))

			task.delay(0.25, function()
				if bits.Parent then bits.CanCollide = true; vel:Destroy() end
			end)
			task.delay(3, function()
				if bits.Parent then
					TweenService:Create(bits, TweenInfo.new(0.5), { Size = Vector3.new(0, 0, 0) }):Play()
					Debris:AddItem(bits, 1)
				end
			end)
			task.wait()
		end

		Debris:AddItem(StrikeClone, 5)
	end,

	meteor = function(Params)
		local character = Params.char

		local TweenService = game:GetService("TweenService")
		local Debris = game:GetService("Debris")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")

		local HumRP = character:FindFirstChildOfClass("Humanoid").RootPart
		local Visuals = ReplicatedStorage.Resources.Madara

		-- Land 80 studs in front at ground level
		local LandPos = (HumRP.CFrame * CFrame.new(0, 0, -80)).Position
		local SpawnPos = LandPos + Vector3.new(0, 400, 0)

		local MeteorClone = Visuals.Meteor:Clone()
		MeteorClone.Parent = workspace.Effects
		MeteorClone.CFrame = CFrame.new(SpawnPos)

		-- Enable trail
		for _, v in MeteorClone:GetDescendants() do
			if v:IsA("Trail") then v.Enabled = true end
		end

		-- Tween meteor down to land position
		local TweenMove = TweenService:Create(MeteorClone, TweenInfo.new(1, Enum.EasingStyle.Linear, Enum.EasingDirection.In), {
			CFrame = CFrame.new(LandPos)
		})
		TweenMove:Play()
		TweenMove.Completed:Once(function()
			-- Fade out meteor
			TweenService:Create(MeteorClone, TweenInfo.new(0.1), { Transparency = 1 }):Play()
			if MeteorClone:FindFirstChild("Outer") then
				TweenService:Create(MeteorClone.Outer, TweenInfo.new(0.1), { Transparency = 1 }):Play()
			end
			Debris:AddItem(MeteorClone, 0.5)

			-- Explosion VFX
			local ExplosionClone = Visuals.MeteorExplosion:Clone()
			ExplosionClone.Parent = workspace.Effects
			ExplosionClone.CFrame = CFrame.new(LandPos)
			for _, v in ExplosionClone:GetDescendants() do
				if v:IsA("ParticleEmitter") then v:Emit(50) end
			end
			Debris:AddItem(ExplosionClone, 5)

			-- Flying rocks
			for i = 1, math.random(4, 8) do
				local Velocity = 85
				local bits = Visuals.FlyingRocks:Clone()
				bits.Parent = workspace.Effects
				bits.CFrame = CFrame.new(LandPos)
				bits.Size = Vector3.new(math.random(2, 6), math.random(2, 6), math.random(2, 6))
				bits.Material = Enum.Material.Concrete
				bits.Color = Color3.new(0.258, 0.258, 0.258)
				bits.Anchored = false

				local vel = Instance.new("BodyVelocity", bits)
				vel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
				vel.Velocity = Vector3.new(
					math.random(-Velocity, Velocity),
					math.random(20, Velocity),
					math.random(-Velocity, Velocity)
				)

				task.delay(0.25, function()
					if bits.Parent then bits.CanCollide = true; vel:Destroy() end
				end)
				task.delay(3, function()
					if bits.Parent then
						TweenService:Create(bits, TweenInfo.new(0.5), { Size = Vector3.new(0, 0, 0) }):Play()
						Debris:AddItem(bits, 1)
					end
				end)
				task.wait(0.1)
			end
		end)
	end,

	beatdownStartup = function(Params)
		local character = Params.char
		local id = Params.id

		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local HumRP = character:FindFirstChildOfClass("Humanoid").RootPart

		local Anim = nil
		for _, v in character:FindFirstChildOfClass("Humanoid"):FindFirstChildOfClass("Animator"):GetPlayingAnimationTracks() do
