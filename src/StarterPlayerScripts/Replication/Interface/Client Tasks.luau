	Beatdown = function(Params)
		local Character: Model = Params.Char
		local Humanoid: Humanoid = Character.Humanoid
		local HumRP: BasePart = Character.HumanoidRootPart

		local Stage = Params.Stage

		local MetalUtils = RS.Resources.MetalUtils
		local sfxAssets = MetalUtils.SFX
		local animAssets = MetalUtils.Animations.Beatdown

		local Packages = RS.Packages
		local Tweening = require(Packages.Modules.DevModules.Tjanime.EffectsFunctions.Tweening)
		local VFX_Utility = ServicesModule:GetService("VFX_Utility")

		if Stage == "pa" then

			local MissTrack = nil
			for _, playingTrack in pairs(Humanoid.Animator:GetPlayingAnimationTracks()) do
				if playingTrack.Animation.AnimationId == Params.Animation then
					MissTrack = playingTrack
					break
				end
			end
			if not MissTrack then return end

			SoundsModule:AddSound(sfxAssets["Swing"], HumRP)

			local Events = {}

			Events["hit"] = MissTrack:GetMarkerReachedSignal("hit"):Connect(function()
				if Players:GetPlayerFromCharacter(Character) == LocalPlayer then
					shared.repfire("ShakeCamera", {
						Magnitude = 4,
						Roughness = 12,
						FadeInTime = 0,
						FadeOutTime = 0.25
					})
				end
			end)

			MissTrack.Stopped:Once(function()
				for _, v in Events do
					v:Disconnect()
				end
			end)

		elseif Stage == "grab" then
			local Victim: Model = Params.Victim

			SoundsModule:AddSound(sfxAssets["Heavy Hit 1"], HumRP)

			if Players:GetPlayerFromCharacter(Character) == LocalPlayer
				or Players:GetPlayerFromCharacter(Victim) == LocalPlayer then

				shared.repfire("ShakeCamera", {
					Magnitude = 6,
					Roughness = 14,
					FadeInTime = 0,
					FadeOutTime = 0.3
				})

				-- Slight FOV punch in
				TS:Create(CurrentCamera, TweenInfo.new(0.1), {
					["FieldOfView"] = 80
				}):Play()
				task.delay(0.1, function()
					TS:Create(CurrentCamera, TweenInfo.new(0.25), {
						["FieldOfView"] = 70
					}):Play()
				end)
			end


			-- // STAGE: "damage" — Mid-combo hit \\ --

		elseif Stage == "damage" then
			local Victim: Model = Params.Victim

			SoundsModule:AddSound(sfxAssets["Heavy Hit 1"], HumRP)

			if Players:GetPlayerFromCharacter(Character) == LocalPlayer
				or Players:GetPlayerFromCharacter(Victim) == LocalPlayer then

				shared.repfire("ShakeCamera", {
					Magnitude = 5,
					Roughness = 12,
					FadeInTime = 0,
					FadeOutTime = 0.2
				})
			end


			-- // STAGE: "ender" — Normal ending slam \\ --

		elseif Stage == "ender" then
			local Victim: Model = Params.Victim
			local VictimHumRP: BasePart = Victim and Victim:FindFirstChild("HumanoidRootPart")

			SoundsModule:AddSound(sfxAssets["Ground"], VictimHumRP or HumRP)

			if Players:GetPlayerFromCharacter(Character) == LocalPlayer
				or Players:GetPlayerFromCharacter(Victim) == LocalPlayer then

				shared.repfire("ShakeCamera", {
					Magnitude = 9,
					Roughness = 16,
					FadeInTime = 0,
					FadeOutTime = 0.45
				})

				TS:Create(CurrentCamera, TweenInfo.new(0.1), {
					["FieldOfView"] = 85
				}):Play()
				task.delay(0.1, function()
					TS:Create(CurrentCamera, TweenInfo.new(0.3), {
						["FieldOfView"] = 70
					}):Play()
				end)
			end


			-- // STAGE: "f_start" — Finisher begins \\ --

		elseif Stage == "f_start" then
			local Victim: Model = Params.Victim

			SoundsModule:AddSound(sfxAssets["Ground"], HumRP)

			-- Load the cutscene camera for attacker and victim
			local isInvolved = LocalPlayer == Players:GetPlayerFromCharacter(Character)
				or LocalPlayer == Players:GetPlayerFromCharacter(Victim)

			if isInvolved then
				-- Blur + FOV zoom in to signal finisher
				TS:Create(game.Lighting.Blur, TweenInfo.new(0.3), {
					["Size"] = 12
				}):Play()
				TS:Create(CurrentCamera, TweenInfo.new(0.3, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {
					["FieldOfView"] = 35
				}):Play()

				task.delay(0.3, function()
					TS:Create(game.Lighting.Blur, TweenInfo.new(0.4), {
						["Size"] = 0
					}):Play()
					TS:Create(CurrentCamera, TweenInfo.new(0.3), {
						["FieldOfView"] = 70
					}):Play()

					shared.repfire("ShakeCamera", {
						Magnitude = 8,
						Roughness = 16,
						FadeInTime = 0,
						FadeOutTime = 0.4
					})
				end)
			end


			-- // STAGE: "f_hit" — Finisher mid slam \\ --

		elseif Stage == "f_hit" then
			local Victim: Model = Params.Victim
			local VictimHumRP: BasePart = Victim and Victim:FindFirstChild("HumanoidRootPart")

			SoundsModule:AddSound(sfxAssets["Ground"], VictimHumRP or HumRP)

			if Players:GetPlayerFromCharacter(Character) == LocalPlayer
				or Players:GetPlayerFromCharacter(Victim) == LocalPlayer then

				shared.repfire("ShakeCamera", {
					Magnitude = 11,
					Roughness = 18,
					FadeInTime = 0,
					FadeOutTime = 0.5
				})

				TS:Create(game.Lighting.Blur, TweenInfo.new(0.1), {
					["Size"] = 8
				}):Play()
				task.delay(0.1, function()
					TS:Create(game.Lighting.Blur, TweenInfo.new(0.4), {
						["Size"] = 0
					}):Play()
				end)
			end


			-- // STAGE: "f_lasthit" — Final finisher blow \\ --

		elseif Stage == "f_lasthit" then
			local Victim: Model = Params.Victim
			local VictimHumRP: BasePart = Victim and Victim:FindFirstChild("HumanoidRootPart")

			SoundsModule:AddSound(sfxAssets["Ground"], VictimHumRP or HumRP)

			if Players:GetPlayerFromCharacter(Character) == LocalPlayer
				or Players:GetPlayerFromCharacter(Victim) == LocalPlayer then

				shared.repfire("ShakeCamera", {
					Magnitude = 15,
					Roughness = 18,
					FadeInTime = 0,
					FadeOutTime = 0.65
				})

				-- Big flash blur on final hit
				game.Lighting.Blur.Size = 24
				TS:Create(game.Lighting.Blur, TweenInfo.new(0.5), {
					["Size"] = 0
				}):Play()

				TS:Create(CurrentCamera, TweenInfo.new(0.1), {
					["FieldOfView"] = 90
				}):Play()
				task.delay(0.1, function()
					TS:Create(CurrentCamera, TweenInfo.new(0.35), {
						["FieldOfView"] = 70
					}):Play()
				end)
			end

		end
	end,

