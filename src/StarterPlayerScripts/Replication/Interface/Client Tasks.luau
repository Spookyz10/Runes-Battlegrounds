	EnergyTrail = function(Params)
		local lifeTime = Params.lifeTime or 0.2
		local limbNames = Params.limbNames or {
			"Right Arm",
		}

		for i, v in Params.char:GetChildren() do
			if v:IsA("BasePart") then
				if table.find(limbNames, v.Name) then
					local waterPalm = Resources.Dawi.DivergentFist.fist:Clone()
					local weld = Instance.new("Weld")

					weld.Part0 = v

					weld.Part1 = waterPalm
					weld.Parent = waterPalm

					waterPalm.Parent = workspace.Thrown
					waterPalm.CFrame = v.CFrame

					emitAllParticles(waterPalm)

					local randomSFX = {
						"rbxassetid://134954620908460",
						"rbxassetid://122032496591558",
						"rbxassetid://94969223006290",
					}

					local sfx = shared.sfx({
						SoundId = randomSFX[math.random(1, #randomSFX)],
						RollOffMaxDistance = 150,
						RollOffMinDistance = 8.5,
						Volume = 1.25,
						Parent = waterPalm
					})

					sfx:Play()

					task.delay(lifeTime, function()
						for i, v in waterPalm:GetDescendants() do
							if v:IsA("Trail") then
								BoatTween:Create(v, {
									Time = 0.55,
									EasingStyle = "EntranceExpressive",
									EasingDirection = "In",

									Reverses = false,
									DelayTime = 0,
									RepeatCount = 0,

									StepType = "Heartbeat",

									Goal = {
										Transparency = NumberSequence.new(1, 1)
									},
								}):Play()
							elseif v:IsA("ParticleEmitter") then
								v.Enabled = false
							end
						end
						Debris:AddItem(waterPalm, 0.65)
					end)
				end
			end
		end
	end,
	
