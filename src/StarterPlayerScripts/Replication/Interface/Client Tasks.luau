		elseif not Params.Heat and not Params.Wind then
			warn("Fist Smoke must have one smoke type specified as true.")
			return
		end

		if Params.Sound then
			local Sound = Resources.Misc.Sounds.Heat:Clone()
			Sound.Parent = RightArm
			Sound.Volume = 3
			Sound:Play()
		end

		local Debris = game:GetService("Debris")

		if Params.Wind and not Params.Heat then
			local VFX1 = Resources.Misc["Fist Smoke"].Smoke.Smoke4:Clone()
			local VFX2 = Resources.Misc["Fist Smoke"].Smoke.Smoke5:Clone()

			VFX1.Parent = arm
			VFX2.Parent = arm
			VFX1.Enabled = true
			VFX2.Enabled = true

			Debris:AddItem(VFX1, Dur + 0.6)
			Debris:AddItem(VFX2, Dur + 0.6)

			task.delay(Dur, function()
				VFX1.Enabled = false
				VFX2.Enabled = false
			end)
		end

		if Params.Heat and not Params.Wind then
			local VFX1 = Resources.Misc["Fist Smoke"].Smoke.Smoke4:Clone()
			local VFX2 = Resources.Misc["Fist Smoke"].Smoke.Smoke5:Clone()

			local Sound = Resources.Misc.Sounds.Heat:Clone()
			Sound.Parent = VFX1
			Sound.Volume = 3
			Sound:Play()

			VFX1.Parent = arm
			VFX2.Parent = arm
			VFX1.Enabled = true
			VFX2.Enabled = true

			Debris:AddItem(VFX1, Dur + 0.6)
			Debris:AddItem(VFX2, Dur + 0.6)

