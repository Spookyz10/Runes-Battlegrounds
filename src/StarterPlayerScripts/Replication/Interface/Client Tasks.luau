				return TweenInfo.new(tweenInfo.time, Enum.EasingStyle[tweenInfo.style], Enum.EasingDirection[tweenInfo.direction], tonumber(tweenInfo.Repeat), tweenInfo.reverse, (tonumber(tweenInfo.delay)))
