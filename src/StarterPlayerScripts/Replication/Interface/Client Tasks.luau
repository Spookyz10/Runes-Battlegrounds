	shakeTree = function(Params)
		local tree = Params.Tree
		local windShakeParts = {}

		if LocalConfigFolder:FindFirstChild('Fast Mode') and LocalConfigFolder['Fast Mode'].Value == true then
			return
		else
			if not Params.Time then
				Params.Time = 1
			end

			if Params.Leaves then
				local leafParts = {}
				for _, part in pairs(tree:GetChildren()) do
					if part.Name == "MeshPart" and part.Material == Enum.Material.Grass then
						local leavesParticle = part:FindFirstChild("Leaves") or LegacyReplication.Leaves:Clone()
						leavesParticle.Parent = part

						local xAccel = 0
						local minYAccel = 3
						local maxYAccel = 20
						local rng = RandomSeed

						if not maxYAccel and minYAccel then
							maxYAccel = minYAccel
							minYAccel = 1
						end
						if not maxYAccel and not minYAccel then
							minYAccel = 0
							maxYAccel = 1
						end

						leavesParticle.Acceleration = Vector3.new(xAccel, -rng:NextNumber(minYAccel, maxYAccel), 0)
						leavesParticle.Size = NumberSequence.new(getRandomValue(0.3, 0.4))
						leavesParticle:Emit(2)
						table.insert(leafParts, part)
					end
				end
			end

			for _, part in pairs(tree:GetChildren()) do
				if CollectionService:HasTag(part, "WindShake") then
					table.insert(windShakeParts, part)
				end
			end

			local minMultiplier = 1
			local maxMultiplier = 3
			local rng = RandomSeed

			if not maxMultiplier and minMultiplier then
				maxMultiplier = minMultiplier
				minMultiplier = 1
			end
			if not maxMultiplier and not minMultiplier then
				minMultiplier = 0
				maxMultiplier = 1
			end

			local intensityMultiplier = rng:NextNumber(minMultiplier, maxMultiplier)
			local windPower = Params.Intensity * intensityMultiplier
			local valueConnections = {}
			local valueInstances = {}

			for _, part in pairs(windShakeParts) do
				if Params.From then
					local attrName = "WindDirection"
					local minX = -0.25
					local maxX = 0.25
					local rng = RandomSeed

					if not maxX and minX then
						maxX = minX
						minX = 1
					end
					if not maxX and not minX then
						minX = 0
						maxX = 1
					end

					local x = rng:NextNumber(minX, maxX)
					minX = -0.25
					maxX = 0.25
					local y = rng:NextNumber(minX, maxX)
					local z = getRandomValue(-0.25, 0.25)

					part:SetAttribute(attrName, Vector3.new(x, y, z))
				end

				local valueObj = Instance.new("NumberValue")
				table.insert(valueInstances, valueObj)

				local connection = valueObj:GetPropertyChangedSignal("Value"):Connect(function()
					part:SetAttribute("WindPower", valueObj.Value)
				end)
				table.insert(valueConnections, connection)

				valueObj.Value = windPower

				local timeMin = Params.Time - 0.25
				local timeMax = Params.Time + 0.25
				local tweenTime = RandomSeed:NextNumber(timeMin, timeMax)

				TS:Create(valueObj, TweenInfo.new(tweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Value = 0.5
				}):Play()

				task.delay(tweenTime, function()
					part:SetAttribute("WindPower", nil)
				end)
			end
		end
	end,
	
