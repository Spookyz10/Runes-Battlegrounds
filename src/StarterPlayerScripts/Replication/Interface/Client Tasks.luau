	ManjiKick = function(Params)
		local Character: Model = Params.Char
		local HumRP: BasePart, Humanoid: Humanoid, Torso: Part
		if Character then
			HumRP = Character.HumanoidRootPart
			Humanoid = Character.Humanoid
			Torso = Character.Torso
		end
		
		
		local Stage = Params.Stage
		local AssetsFolder = Resources.Dawi.ManjiKick
		
		
		if Stage == "Disappear" then
			local transparencyStorage = {}

			for i, v in Character:GetDescendants() do
				if v:IsA("BasePart") or v:IsA("Decal") then
