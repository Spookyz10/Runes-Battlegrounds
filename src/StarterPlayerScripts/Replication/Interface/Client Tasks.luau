local function emitAllParticles(instance)
	if not instance then
		return
	end

	for i, v in instance:GetDescendants() do
		if v:IsA("ParticleEmitter") then
			local emitDelay = v:GetAttribute("EmitDelay") or 0

			task.delay(emitDelay, function()
				v:Emit(v:GetAttribute("EmitCount") or 1)
			end)
		end
	end
end

local function weld(object1: Instance, object2: Instance, parent: Instance?): WeldConstraint
	local obj = Instance.new("WeldConstraint")
	obj.Part0 = object1
	obj.Part1 = object2
	obj.Parent = parent or object2

	return obj
end

local function BodyPositionForwardVelocity(BasePart: BasePart, Velocity: number, Lifetime: number, TNInfo: { Time: number, EasingStyle: EnumItem, EasingDirection: EnumItem }, GoalProperties: { P: number, D: number }, Power: number, Dampening: number, MaxForce: Vector3, Bind: Accessory): BodyPosition
	Power = Power or 12500
	Dampening = Dampening or 300

	for _, VelocityInstance in BasePart:GetChildren() do
		if VelocityInstance:IsA("BodyVelocity") or VelocityInstance:IsA("LinearVelocity") or VelocityInstance:IsA("BodyPosition") then
			VelocityInstance:Destroy()
		end
	end

	GoalProperties = GoalProperties or {
		P = 5000, 
		D = 600
	}


	local BodyPosition = Instance.new("BodyPosition")
	BodyPosition.P = Power
	BodyPosition.D = Dampening
	BodyPosition.MaxForce = MaxForce or Vector3.new(30000, 0, 30000)
	BodyPosition.Parent = BasePart
	Debris:AddItem(BodyPosition, Lifetime)

	TS:Create(BodyPosition, TweenInfo.new(table.unpack(TNInfo)), GoalProperties):Play()


	local BPStep
	BPStep = RNS.PreRender:Connect(function()
		if not BodyPosition or not BodyPosition.Parent then
			BPStep:Disconnect()

			return
		end

		BodyPosition.Position = CFrame.fromOrientation(0, Vector3.new(BasePart.CFrame:ToOrientation()).Y, 0).Rotation.LookVector * Velocity + BasePart.Position
	end)


	local BindConnection: RBXScriptConnection
	if Bind then
		BindConnection = Bind.Destroying:Once(function()
			BodyPosition:Destroy()
		end)
	end

	task.delay(Lifetime, function()
		BPStep:Disconnect()

		if BindConnection then
			BindConnection:Disconnect()
			BindConnection = nil
		end
	end)


	return BodyPosition
end

local function miniDebris(Parameters: { MinimumRocks: number, MaximumRocks: number, MinimumVelocity: number, MaximumVelocity: number, CFrame: CFrame, Material: EnumItem, Color: Color3 })
	task.spawn(function()
		local flyRocksNumber = math.random(Parameters.MinimumRocks, Parameters.MaximumRocks * 1.15)

		if LocalConfigFolder["Fast Mode"].Value == true then
			flyRocksNumber /= 2
		end

		for i = 1, flyRocksNumber do
			local lifeTime = RandomSeed:NextNumber(4, 6)

			local flyingDebris = Resources.Rocks.rockCircle.DefaultPart:Clone()
			flyingDebris.CFrame = Parameters.CFrame * CFrame.new(0, 0.25, 0)
			flyingDebris.Anchored = false
			flyingDebris.CollisionGroup = "NonPColDebri"
			flyingDebris.CanCollide = true
			flyingDebris.Material = Parameters.Material
			flyingDebris.Color = Parameters.Color
			flyingDebris.Size = Vector3.new(0.5, 0.5, 0.5) * math.random(1, 2)
			flyingDebris.Parent = workspace.Terrain
			flyingDebris.AssemblyAngularVelocity = Vector3.new(RandomSeed:NextNumber(-25, 25), RandomSeed:NextNumber(-25, 25), RandomSeed:NextNumber(-25, 25))
			flyingDebris.AssemblyLinearVelocity = (CFrame.Angles(0, 2 * math.pi * i/flyRocksNumber + rad(RandomSeed:NextNumber(-25, 25)), 0) * CFrame.Angles(rad(RandomSeed:NextNumber(25, 30)), 0, 0)).UpVector * (RandomSeed:NextNumber(Parameters.MinimumVelocity, Parameters.MaximumVelocity) * Parameters.MaximumRocks)
			Debris:AddItem(flyingDebris, lifeTime + 1)

			task.delay(lifeTime, function()
				TS:Create(flyingDebris, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Size = Vector3.zero, Transparency = 1 }):Play()
			end)
		end
	end)
end

local function QuickFX(Parameters)
	local FX = Parameters.FX
	local AnchorPoint = Parameters.Anchor
	local Maid = Parameters.Maid

	FX = FX:Clone()

	if FX:IsA("Model") then
		FX:PivotTo(AnchorPoint)
	elseif FX:IsA("BasePart") then
		FX.CFrame = AnchorPoint
	end

	if FX:IsA("Attachment") then
		FX.Parent = AnchorPoint
	else
		FX.Parent = workspace.Thrown
	end

	if Maid then
		Maid:Add(FX)
	else
		Debris:AddItem(FX, 30)
	end

	return FX
end

local function EmitAttachment(attachment)
	local maxLifetime = 0

	for _, descendant in ipairs(attachment:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			local attributes = descendant:GetAttributes()
			local enableDuration = attributes.EnableDuration or 0
			local emitCount = attributes.EmitCount or 1
			local emitDelay = attributes.EmitDelay or 0

			if emitDelay > 0 then
				task.delay(emitDelay, descendant.Emit, descendant, emitCount)
			else
				descendant:Emit(emitCount)
			end

			if enableDuration > 0 then
				descendant.Enabled = true
				task.delay(enableDuration, function()
					descendant.Enabled = false
				end)
			end

			maxLifetime = math.max(
				maxLifetime,
				descendant.Lifetime.Min + descendant.Lifetime.Max + (emitDelay + enableDuration) / descendant.TimeScale
			)

		elseif descendant:IsA("PointLight") then
			local lightAttributes = descendant:GetAttributes()
			local lightDuration = lightAttributes.EnableDuration or 0

			if lightDuration > 0 then
				local fadeIn = lightAttributes.StartFade or 0
				local fadeOut = lightAttributes.EndFade or 0
				local fadeInStyle = lightAttributes.StartFadeStyle or "Cubic"
				local fadeOutStyle = lightAttributes.EndFadeStyle or "Cubic"
				local brightness = lightAttributes.Brightness or descendant.Brightness

				if fadeIn > 0 then
					descendant.Brightness = 0
					TS:Create(descendant, TweenInfo.new(fadeIn, Enum.EasingStyle[fadeInStyle], Enum.EasingDirection.Out), {
						Brightness = brightness
					}):Play()
				else
					descendant.Brightness = brightness
				end

				descendant.Enabled = true
				task.delay(lightDuration, function()
					if fadeOut > 0 then
						TS:Create(descendant, TweenInfo.new(fadeOut, Enum.EasingStyle[fadeOutStyle], Enum.EasingDirection.Out), {
							Brightness = 0
						}):Play()
						task.delay(fadeOut, function()
							descendant.Enabled = false
							descendant.Brightness = brightness
						end)
						return
					else
						descendant.Enabled = false
						return
					end
				end)

				maxLifetime = math.max(maxLifetime, fadeIn + fadeOut + lightDuration)
			end
		end
	end

	task.delay(maxLifetime, attachment.Destroy, attachment)
end

local function GetTrackById(animationId: string, animator: Animator)
	local foundTrack = nil
	local startTime = os.clock()

	while not foundTrack and os.clock() - startTime < 1 do
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			if track.Animation.AnimationId == animationId then
				foundTrack = track
				break
			end
		end
		task.wait()
	end

	return foundTrack
end

local function RemoveActive(character)
	if ActiveJobs[character] then
		ActiveJobs[character] = nil
	end
end

local function Task(item)
	if item ~= nil then
		Tasks[item] = true
	end
	return item
end

local function CreateAnimationRetriever(character: Model, animationData)
	if not character or not character.Parent then
		return
	end

	RemoveActive(character)

	local torso = character:FindFirstChild("Torso")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = humanoid and humanoid.RootPart
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")

	if not torso or not humanoid or not rootPart or not animator then
		error("Failed to get model children")
	end

	local animationTrack = GetTrackById(animationData.AnimationId, animator)
	if not animationTrack then
		error("Failed to get server animation on client — it probably isn't playing")
	end

	if not animationTrack.IsPlaying then
		return nil
	end

	local job = Task

	Task(function()
		if ActiveJobs[character] then
			ActiveJobs[character] = nil
		end
	end)

	Task(character.AncestryChanged:Connect(function(_, newParent)
		if not newParent then
			RemoveActive(character)
		end
	end))

	Task(animationTrack.Stopped:Connect(function()
		RemoveActive(character)
	end))

	ActiveJobs[character] = job

	return {
		Animation = animationTrack,
		Job = job,
		Torso = torso,
		Humanoid = humanoid,
		RootPart = rootPart,
		Animator = animator
	}
end

local QuadraticBezier = function(pointA, pointB, pointC, t)
	local firstLerp = pointA + (pointB - pointA) * t
	return firstLerp + (pointB + (pointC - pointB) * t - firstLerp) * t
end

