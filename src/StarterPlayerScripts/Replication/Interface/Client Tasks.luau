	SlaughterCursed = function(Params)
		local stage = Params.Stage
		local character = Params.Char
		local victimPlayer = Params.Victim
		local animId = Params.AnimId

		local TweenService = game:GetService("TweenService")
		local Debris = game:GetService("Debris")
		local Players = game:GetService("Players")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")

		local victim = victimPlayer and victimPlayer.Character or nil
		local Assets = ReplicatedStorage.Resources.Yuji.SlaugherCursed
		local isInvolved = Players.LocalPlayer.Character == character
			or Players.LocalPlayer.Character == victim

		local function EmitAll(model, parent, cf)
			local clone = model:Clone()
			clone.Parent = parent
			clone.CFrame = cf
			for _, v in clone:GetDescendants() do
				if v:IsA("ParticleEmitter") then v:Emit(v:GetAttribute("EmitCount") or 10) end
			end
			Debris:AddItem(clone, 5)
		end

		if stage == "Start" then
			if not character then return end
			local HumRP = character:FindFirstChild("HumanoidRootPart")
			if not HumRP then return end

			-- Right arm VFX welded to arm
			local RightArm = character:FindFirstChild("Right Arm")
			if RightArm then
				local ra = Assets.RightArm:Clone()
				ra.Parent = RightArm
				ra.CFrame = RightArm.CFrame

				local weld = Instance.new("ManualWeld", ra)
				weld.Part0 = RightArm
				weld.Part1 = ra
				weld.C0 = CFrame.new(0, 0, 0)

				-- Find anim and destroy arm when it stops
				if animId then
					local Anim = nil
					for _, v in character:FindFirstChildOfClass("Humanoid"):FindFirstChildOfClass("Animator"):GetPlayingAnimationTracks() do
						if v.Animation.AnimationId == animId then Anim = v; break end
					end
					if Anim then
						Anim.Stopped:Once(function() ra:Destroy() end)
					else
						Debris:AddItem(ra, 1.5)
					end
				end
			end

		elseif stage == "Slash1" or stage == "Slash3" then
			if not character then return end
			local HumRP = character:FindFirstChild("HumanoidRootPart")
			if not HumRP then return end
			EmitAll(Assets.Slash1, workspace.Effects, HumRP.CFrame)

		elseif stage == "Slash2" then
			if not character then return end
			local HumRP = character:FindFirstChild("HumanoidRootPart")
			if not HumRP then return end
			EmitAll(Assets.Slash2, workspace.Effects, HumRP.CFrame)

		elseif stage == "Hit" then
			if not victim then return end
			local VictimHumRP = victim:FindFirstChild("HumanoidRootPart")
			if not VictimHumRP then return end

			local hit = Assets.hit.Hit:Clone()
			hit.Parent = VictimHumRP
			for _, v in hit:GetDescendants() do
				if v:IsA("ParticleEmitter") then v:Emit(v:GetAttribute("EmitCount") or 10) end
			end
			Debris:AddItem(hit, 2)
		end
	end,

	Railgun = function(Params)
		local stage = Params.Stage
		local character = Params.Char
		local victimPlayer = Params.Victim
		local animId = Params.AnimId
		local friendAnimId = Params.FriendAnimId
		local playerId = Params.PlayerId
		local hitPosition = Params.HitPosition

		local TweenService = game:GetService("TweenService")
		local Debris = game:GetService("Debris")
		local Lighting = game:GetService("Lighting")
		local Players = game:GetService("Players")
		local RunService = game:GetService("RunService")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")

		local victim = victimPlayer and victimPlayer.Character or nil
		local Persist = ReplicatedStorage.Persist.Railgun
		local isLocal = Players.LocalPlayer.Character == character
		local isInvolved = isLocal or Players.LocalPlayer.Character == victim

		-- Store per-character state in a table keyed by character
		if not _G.RailgunState then _G.RailgunState = {} end
		local state = _G.RailgunState[character]

		if stage == "Start" then
			if not character then return end
			local HumRP = character:FindFirstChild("HumanoidRootPart")
			if not HumRP then return end

			-- Create state table for this character
			state = {}
			_G.RailgunState[character] = state

			-- RailGun parented to CHARACTER (not workspace) like original v20.Parent = v13
			local gun = Persist.RailGun:Clone()
			-- Anchor all parts to prevent physics from dragging character
			for _, part in gun:GetDescendants() do
				if part:IsA("BasePart") then
					part.Anchored = false
					part.CanCollide = false
				end
			end
			gun.Parent = character
			state.gun = gun

			local bodyHandle = gun:FindFirstChild("Body") and gun.Body:FindFirstChild("BodyHandle")
			if bodyHandle then
				local motor = Instance.new("Motor6D")
				motor.Name = "BodyHandle"
				motor.C0 = CFrame.new(-1.125, 1.273, -0.69)
				motor.C1 = CFrame.new(0.5, -1, -0.625)
				motor.Part0 = HumRP
				motor.Part1 = bodyHandle
				motor.Parent = HumRP
				state.bodyMotor = motor
			end

			-- EffectPart parented to workspace.Effects, Motor6D drives it from HumRP
			-- Part1 = effectPart (a single BasePart, not a model) so Motor6D works fine here
			local effectPart = Persist.EffectPart:Clone()
			effectPart.Parent = workspace.Effects
			state.effectPart = effectPart

			local effectMotor = Instance.new("Motor6D")
			effectMotor.Name = "EffectPart"
			effectMotor.C0 = CFrame.new(-0.969, 1.361, -9.973)
			effectMotor.Part0 = HumRP
			effectMotor.Part1 = effectPart
			effectMotor.Parent = HumRP
			state.effectMotor = effectMotor

			-- Spawn Friend NPC
			local friend = Persist.Friend:Clone()
			friend.Parent = workspace.Effects
			state.friend = friend

			-- Weld friend behind character
			local friendWeld = Instance.new("ManualWeld", friend:FindFirstChild("HumanoidRootPart") or friend.PrimaryPart)
			if friend.PrimaryPart then
				friendWeld.Part0 = HumRP
				friendWeld.Part1 = friend.PrimaryPart
				friendWeld.C0 = CFrame.new(0, 0, 3.947)
			end

			-- Apply friend's appearance from userId
			if playerId then
				task.spawn(function()
					local desc = pcall(function()
						local d = Players:GetHumanoidDescriptionFromUserId(playerId)
						local friendHum = friend:FindFirstChildOfClass("Humanoid")
						if friendHum and d then friendHum:ApplyDescription(d) end
					end)
				end)
			end

			-- Create Animator on Friend if missing (Friend has Humanoid but no Animator)
			local friendHumanoid = friend:FindFirstChildOfClass("Humanoid")
			if friendHumanoid then
				local friendAnimator = friendHumanoid:FindFirstChildOfClass("Animator")
				if not friendAnimator then
					friendAnimator = Instance.new("Animator", friendHumanoid)
				end

				-- Find user anim track
				local userAnim = nil
				if animId then
					for _, v in character:FindFirstChildOfClass("Humanoid"):FindFirstChildOfClass("Animator"):GetPlayingAnimationTracks() do
						if v.Animation.AnimationId == animId then userAnim = v; break end
					end
				end

				local friendAnim = Persist.RailgunAnim.Friend
				local friendTrack = friendAnimator:LoadAnimation(friendAnim)
				friendTrack:Play(0)
				state.friendTrack = friendTrack

				-- Sync friend anim to user anim every frame
				if userAnim then
					state.syncConn = RunService.PreAnimation:Connect(function()
						if friendTrack.IsPlaying and userAnim.IsPlaying then
							friendTrack.TimePosition = userAnim.TimePosition
						end
					end)
				end

				friendTrack.Stopped:Once(function()
					if state.syncConn then state.syncConn:Disconnect() end
					if friend and friend.Parent then friend:Destroy() end
				end)
			end

		elseif stage == "ChargeStart" then
			if not state then return end
			local gun = state.gun
			if not gun then return end

			-- Enable charge up FX on gun plate
			local chargeUpFX = gun:FindFirstChild("Plate") and gun.Plate:FindFirstChild("ChargeUpFX")
			if chargeUpFX then
				for _, v in chargeUpFX:GetDescendants() do
					if v:IsA("ParticleEmitter") or v:IsA("PointLight") or v:IsA("SpotLight") then
						v.Enabled = true
					end
					if v:IsA("Beam") then v.Enabled = true end
				end
			end

			-- FOV tween for local player
			if isLocal then
				TweenService:Create(workspace.CurrentCamera, TweenInfo.new(4), { FieldOfView = 40 }):Play()
			end

		elseif stage == "ChargeReady" then
			if not state then return end
			local gun = state.gun
			if not gun then return end

			local plate = gun:FindFirstChild("Plate")
			if plate then
				local barrel = plate:FindFirstChild("BarrelHandle")
				if barrel then
					for _, child in { barrel:FindFirstChild("ChargeComplete"), barrel:FindFirstChild("FinishedCharge") } do
						if child then
							for _, v in child:GetDescendants() do
								if v:IsA("ParticleEmitter") then v.Enabled = true end
								if v:IsA("Beam") then v.Enabled = true end
							end
						end
					end
				end
			end

		elseif stage == "Shoot" then
			if not state then return end
			local effectPart = state.effectPart
			local gun = state.gun

			-- Destroy charge FX
			if gun then
				local plate = gun:FindFirstChild("Plate")
				if plate then
					pcall(function() plate.ChargeUpFX:Destroy() end)
					local barrel = plate:FindFirstChild("BarrelHandle")
					if barrel then
						pcall(function() barrel.ChargeComplete:Destroy() end)
						pcall(function() barrel.FinishedCharge:Destroy() end)
					end
				end
			end

			-- Enable beam on effectPart
			if effectPart then
				local beamFolder = effectPart:FindFirstChild("BeamFolder")
				if beamFolder then
					for _, v in beamFolder:GetChildren() do
						if v:IsA("Beam") then v.Enabled = true end
					end
				end

				local shotTaken = effectPart:FindFirstChild("ShotTaken")
				if shotTaken then
					for _, v in shotTaken:GetDescendants() do
						if v:IsA("ParticleEmitter") then v:Emit(v:GetAttribute("EmitCount") or 20) end
					end
				end
			end

			-- Local effects
			if isInvolved then
				-- Impact highlights
				local h1 = Persist.ImpactHighlight:Clone()
				h1.Parent = character
				local h2 = Persist.ImpactHighlight:Clone()
				h2.Parent = victim or character

				local cc = Persist.ColorCorrection:Clone()
				cc.Parent = Lighting

				task.delay(0.075, function()
					cc.Brightness = -10
					h1.FillColor = Color3.fromRGB(255, 255, 255)
					h2.FillColor = Color3.fromRGB(255, 255, 255)
					task.delay(0.075, function()
						h1:Destroy(); h2:Destroy(); cc:Destroy()
					end)
				end)

				-- Big FOV punch + cam shake
