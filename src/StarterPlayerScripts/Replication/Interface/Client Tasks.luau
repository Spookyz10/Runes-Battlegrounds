	ThornyRelease = function(Params)
		local Character: Model = Params.Char
		local humanoid: Humanoid = Character.Humanoid
		local rootPart: BasePart = Character.HumanoidRootPart


		local Stage = Params.Stage


		local assets = Resources.Black
		local vfxAssets = assets.VFX
		local sfxAssets = assets.SFX


		local rocksService = ServicesModule:GetService("RocksService")
		local VFX_Utility_Black = ServicesModule:GetService("VFX_Utility")
		

		local function playMeshEmit(meshFx, cframe)
			for _, meshPart in meshFx:GetChildren() do
				VFX_Utility_Black.meshEmit(meshPart.Start, cframe * meshPart.Start.Offset.C0)
			end
		end
		
		local v54 = workspace:GetServerTimeNow()
		local v_u_55 = workspace:GetServerTimeNow() - v54

		local function playProjectileTrail(time, startCFrame, endCFrame, index, mod)
			local elapsed = 0
			local disconnectConnection = nil
			local proj = vfxAssets.Base["Thorny Release"].Projectile:Clone()
			Debris:AddItem(proj, time + proj.Trail.Lifetime)
			proj.Parent = workspace.Thrown

			task.delay(time, function()
				proj.Trail.Enabled = false
				if disconnectConnection then
					disconnectConnection:Disconnect()
					disconnectConnection = nil
				end
			end)

			local curve = Instance.new("Vector3Curve")
			Debris:AddItem(curve, time)
			local curveX = curve:X()
			local curveY = curve:Y()
			local curveZ = curve:Z()
			local lookCFrame = CFrame.new(startCFrame.Position, endCFrame.Position)
			local randomOffset = 5 * math.random(-1, 1)

			if index ~= nil and mod ~= nil then
				randomOffset = 5 * (-2 + mod)
				if index > 1 then
					randomOffset = 6 * (-2 + mod + index)
				end
			end

			disconnectConnection = RNS.Heartbeat:Connect(function(dt)
				elapsed = elapsed + dt
				if time < elapsed then
					if disconnectConnection then
						disconnectConnection:Disconnect()
						disconnectConnection = nil
					end
				else
					local cframeToEnd = lookCFrame * CFrame.new(0, 0, -(endCFrame.Position - lookCFrame.Position).Magnitude)
					local arcCFrame = lookCFrame:Lerp(cframeToEnd, 0.5) * CFrame.new(randomOffset, mod == 2 and index == 1 and 8 or 5, 0)
					local points = { lookCFrame.Position, arcCFrame.Position, cframeToEnd.Position }
					local t = 0
					for _, pt in points do
						curveX:InsertKey(FloatCurveKey.new(t, pt.X))
						curveY:InsertKey(FloatCurveKey.new(t, pt.Y))
						curveZ:InsertKey(FloatCurveKey.new(t, pt.Z))
						t = t + time / #points / time
					end
					local ratio = elapsed / time
					local curveResult = curve
					local v = table.unpack(curveResult:GetValueAtTime(ratio))
					local pos = Vector3.new(v)
					proj.CFrame = CFrame.new(pos, pos + lookCFrame.LookVector)
					table.clear(points)
				end
			end)
		end

		if Stage == "pa" then
			local mod = Params.mod
			if mod > 1 then
				-- stop anims 0.1
			end

			local modIndex = mod == 3 and 4 or mod
			SoundsModule:AddSound(sfxAssets.Base["Thorny Release"][modIndex].Cloth, Character.Torso)

			local delayForThrow = modIndex == 4 and 0 or 0.1

			task.delay(delayForThrow, function()
				SoundsModule:AddSound(sfxAssets.Base["Thorny Release"][modIndex].Throw, rootPart)
			end)

			if Params.mod == 2 then
				local delayFunc = task.delay
				local delayTime = 0.61 - v_u_55

				delayFunc(math.max(delayTime, 0), function()
					SoundsModule:AddSound(sfxAssets.Base["Thorny Release"][3].Cloth, Character.Torso)

					task.delay(0.1, function()
						SoundsModule:AddSound(sfxAssets.Base["Thorny Release"][3].Throw, rootPart)
					end)
				end)
				return
			end

		elseif Stage == "s_Shards" then
			local spawnPos = Params.spawnPosition
			local index = Params.index
			local idxNum = tonumber(index)
			local mod = Params.mod
			local hitRay = workspace:Raycast(spawnPos.Position, Vector3.new(-0, -30, -0), MapRayParams)
			local groundCFrame

			if hitRay then
				groundCFrame = CFrame.new(hitRay.Position)
			else
				groundCFrame = spawnPos
			end

			playProjectileTrail(0.2, rootPart.CFrame, groundCFrame, idxNum, mod)
			task.wait(0.1)

			if hitRay then
				local nRange = NumberRange.new
				local hitScale = idxNum / 1.4
				local scaleMin = math.max(1, hitScale) * 2
				local scaleMax = math.max(1, idxNum / 1.4) * 7
				local scaleRange = nRange(scaleMin, scaleMax)
				local shakeChance = math.random(3, 10) / 10
				local smashCFrame = CFrame.new(hitRay.Position + Vector3.new(0, 2, 0), hitRay.Position + Vector3.new(0, 2, 0) - Vector3.new(0, 1, 0))

				if (CurrentCamera.CFrame.Position - spawnPos.Position).Magnitude < 60 or LocalCharacter == Character then
					shared.repfire("ShakeCamera", { Magnitude = 10, Roughness = 16, FadeInTime = 0, FadeOutTime = 0.35 })
				end

				local spikes = vfxAssets.Base["Thorny Release"].Spikes:Clone()
				Debris:AddItem(spikes, 4)
				spikes.CFrame = CFrame.new(hitRay.Position)
				spikes.Parent = workspace.Thrown

				task.delay(0.02, function()
					for _, part in spikes:GetDescendants() do
						VFX_Utility_Black.emit_effect(part)
					end
				end)

				playMeshEmit(vfxAssets.Base["Thorny Release"].MeshFX.Spikes, CFrame.new(hitRay.Position))
				local soundBase = sfxAssets.Base["Thorny Release"]
				local soundIndex = idxNum - 1
				SoundsModule:AddSound(soundBase[mod + math.max(soundIndex, 0)].Explode, spikes)

				coroutine.wrap(rocksService.CircularSmash)(smashCFrame, 1.85, 1.5, 1, 0.02, 15, nil, nil, {
					["MatchRaycastBehavior"] = true
				}, {
					["segments"] = function(_, _)
						return math.random(3, 5)
					end,
					["rotation_offset"] = function(_, _, i, seg, segmentIdx)
						local offset = CFrame.Angles(0, 0, math.rad(math.random(-360, 360) * (i - 1)))
						local segOffset = CFrame.Angles(1.5707963267948966, math.rad(360 / seg) * segmentIdx, 0)
						return offset * segOffset
					end,
					["part_size"] = function(_, i, _, _)
						return Vector3.new(
							math.random(300, 500) / 100 * i,
							math.random(150, 500) / 100,
							math.random(200, 300) / 100
						)
					end,
					["part_offset"] = function(_, _, _, _)
						return CFrame.new(0, 0, -1) * CFrame.Angles(math.rad(math.random(35, 90)), math.rad(math.random(-1, 1)), 0)
					end,
					["part_offset2"] = function(_, _, _, _)
						return CFrame.new(0, -0.5, 0)
					end
				}, 0.3, 4, 2)

				coroutine.wrap(rocksService.ParticleImpact)(smashCFrame, 3, 0.5, 3, 0, 10, "Cubic", nil, nil, {
					["MatchRaycastBehavior"] = true,
					["Anchored"] = false,
					["CanCollide"] = true,
					["CollisionGroup"] = "NonPColDebri"
				}, {
					["part_size"] = function(_, _, _)
						return Vector3.new(
							math.random(20, 229.99999999999997) / 100,
							math.random(20, 229.99999999999997) / 100,
							math.random(20, 229.99999999999997) / 100
						)
					end,
					["part_offset"] = function(_, _, _)
						return CFrame.new(0, 0, 3) * CFrame.Angles(
							math.rad(math.random(-0, 0)),
							math.rad(math.random(-0, 0)),
							math.rad(math.random(-0, 0))
						)
					end,
					["force"] = function(cf)
						return (-cf.LookVector + Vector3.new(
							math.random(-200, 200) / 100,
							math.random(2, 5),
							math.random(-100, 100) / 100
							)) * math.random(100, 2000) / 100
					end,
					["angular_force"] = function()
						return Vector3.new(
							math.random(-3, 3),
							math.random(-3, 3),
							math.random(-3, 3)
						)
					end,
					["j"] = 0.4
				}, 0.15, 3)

				for i = -1, 1, 0.6 do
					for j = -1, 1, 0.6 do
						local isCenter = Vector2.new(i, j).Magnitude == 0
						if isCenter or math.random(0, shakeChance * 10) / 10 ~= 0 then
							local mag = math.max(Vector2.new(-1, 1).Magnitude - Vector2.new(i, j).Magnitude, 0.5)
							local scale = mag * math.max(1, idxNum / 1.4)
							local hitPos = hitRay.Position
							local dX = i * math.random(scaleRange.Min, scaleRange.Max)
							local dZ = j * math.random(scaleRange.Min, scaleRange.Max)
							local shardHit = workspace:Raycast(hitPos + Vector3.new(dX, 5, dZ), Vector3.new(-0, -10, -0), MapRayParams)
							if shardHit then
								local shardCFrame = CFrame.new(shardHit.Position, shardHit.Position + shardHit.Normal) * CFrame.Angles(1.5707963267948966, 0, 0)
								local shard = vfxAssets.Base["Thorny Release"].Shard:Clone()
								Debris:AddItem(shard, 3.7)
								local rotAmount = isCenter and 20 or 35
								shard.CFrame = shardCFrame * CFrame.Angles(
									math.rad(math.random(-rotAmount, rotAmount)),
									math.rad(math.random(-360, 360)),
									math.rad(math.random(-rotAmount, rotAmount))
								) * CFrame.new(0, 10, 0)

								coroutine.wrap(function()
									local tweenTime = math.random(1, 20) / 100
									TS:Create(shard, TweenInfo.new(tweenTime), { CFrame = shardCFrame }):Play()
									task.delay(1.85, function()
										TS:Create(shard, TweenInfo.new(0.3), {
											CFrame = shardCFrame * CFrame.new(0, 10, 0),
											Size = Vector3.new(0, 0, 0)
										}):Play()
									end)
								end)()
								shard.Size = shard.Size * scale
								shard.Parent = workspace.Thrown
							end
						end
					end
				end
			end

		elseif Stage == "final" then
			local spawnPos = Params.spawnPosition
			local groundCheck = Params.groundCheck
			local dropDelay = 0.6 - v_u_55
			local safeDelay = math.max(dropDelay, 0)
			playProjectileTrail(0.2, rootPart.CFrame, spawnPos)
			playProjectileTrail(0.2, rootPart.CFrame, spawnPos)
			task.wait(0.1)

			local rootPartFx = vfxAssets.Base["Thorny Release"]._rootPart:Clone()
			Debris:AddItem(rootPartFx, safeDelay * 2)
			rootPartFx.CFrame = CFrame.new(spawnPos.Position)
			rootPartFx.Parent = workspace.Thrown

			local spawnBall = vfxAssets.Base["Thorny Release"].SpawnBall:Clone()
			Debris:AddItem(spawnBall, 4)
			spawnBall.CFrame = rootPartFx.CFrame
			spawnBall.Parent = workspace.Thrown

			task.delay(0.02, function()
				for _, part in spawnBall:GetDescendants() do
					VFX_Utility_Black.emit_effect(part)
				end
			end)

			SoundsModule:AddSound(sfxAssets.Base["Thorny Release"][4].Form, rootPartFx)

			for _ = 0, 20 do
				local shard = vfxAssets.Base["Thorny Release"].Shard:Clone()
				shard.Parent = rootPartFx
				shard.Anchored = false
				shard.CanCollide = false
				shard.CFrame = rootPartFx.CFrame
				shard.Weld.Part0 = rootPartFx
				shard.Weld.C0 = CFrame.Angles(
					math.rad(math.random(-180, 180)),
					math.rad(math.random(-180, 180)),
					math.rad(math.random(-180, 180))
				)
				local shardGrow = shard.Size * math.random(8, 25) / 10
				shard.Size = shard.Size * 0

				coroutine.wrap(function()
					local tweenTime = math.random(1, 3) / 10
					TS:Create(shard, TweenInfo.new(tweenTime), { Size = shardGrow }):Play()
					task.delay(safeDelay + 0.1, function()
						TS:Create(shard, TweenInfo.new(0.05), { Size = Vector3.new(0, 0, 0) }):Play()
					end)
				end)()
			end

			task.delay(safeDelay / 1.2, function()
				playMeshEmit(vfxAssets.Base["Thorny Release"].MeshFX.BallDrop, rootPartFx.CFrame)
			end)

			task.delay(safeDelay, function()
				SoundsModule:AddSound(sfxAssets.Base["Thorny Release"][4].Cloth2, rootPart)

				TS:Create(rootPartFx, TweenInfo.new(0.1), {
					CFrame = CFrame.new(groundCheck.Position)
				}):Play()

				if (CurrentCamera.CFrame.Position - groundCheck.Position).Magnitude < 60 or LocalCharacter == Character then
					shared.repfire("ShakeCamera", { Magnitude = 16, Roughness = 19, FadeInTime = 0, FadeOutTime = 0.45 })
				end

				local finalFx = vfxAssets.Base["Thorny Release"].Final:Clone()
				Debris:AddItem(finalFx, 4)
				finalFx.CFrame = CFrame.new(groundCheck.Position)
				finalFx.Parent = workspace.Thrown

				task.delay(0.02, function()
					for _, part in finalFx:GetDescendants() do
						VFX_Utility_Black.emit_effect(part)
