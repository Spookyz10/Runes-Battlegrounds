	PlayAwakeningMusic = function(Params: { any })
		local Att: Attachment = Params.MusAtt
		local Character: Model = Att.Parent.Parent
		local MusicVolume = Params.Volume or 1
		local MusicId = Params.Id

		local Music = Instance.new('Sound')
		Music.Parent = Att
		Music.SoundId = MusicId
		Music.Name = "AwakeningMusic"
		Music.SoundGroup = game.SoundService.Sounds
		if LocalPlayer.Configuration['Awakening Music'].Value == false then
			Music.Volume = 0
		else
			Music.Volume = MusicVolume
		end
		Music:Play()


		local changedConnection: RBXResourcesConnection = LocalPlayer.Configuration['Awakening Music']:GetPropertyChangedSignal('Value'):Connect(function()
			if LocalPlayer.Configuration['Awakening Music'].Value == false then
				TS:Create(Music, TweenInfo.new(1), {
					Volume = 0
				}):Play()

			else
				local goalVolume
				if Character:GetAttribute("MuteMusic") == true then
					goalVolume = 0
				else
					goalVolume = MusicVolume
				end

				TS:Create(Music, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
					Volume = goalVolume
				}):Play()
			end
		end)

