	BodyGyro = function(Params)
		local character = Params.char
		local bindPart = Params.Bind
		local primaryPart = character.PrimaryPart

		local existingGyro = primaryPart:FindFirstChildOfClass("BodyGyro")
		if existingGyro then
			existingGyro:Destroy()
		end

		local bodyGyro = Instance.new("BodyGyro")
		bodyGyro.Name = "BODYGYRO"
		bodyGyro.D = 250
		bodyGyro.MaxTorque = Vector3.new(1, 1, 1, 0) * 1e999

		local bodyVelocity = nil
		if not Params.Server then
			bodyVelocity = Instance.new("BodyVelocity")
			bodyVelocity.MaxForce = Vector3.new(40000000, 40000000, 40000000, 0)
			if Params.NoY then
				bodyVelocity.MaxForce *= Vector3.new(1, 0, 1, 0)
			end
			bodyVelocity.Velocity = Vector3.zero
			bodyVelocity.Parent = character.Torso
		end

		local currentCamera = workspace.CurrentCamera
		local gyroConnection = nil

		do
			local gyroRef = bodyGyro
			local primaryPartRef = primaryPart
			local bindRef = bindPart
			local cameraRef = currentCamera
			local velocityRef = bodyVelocity

			gyroConnection = game:GetService("RunService").Stepped:Connect(function()
				if not primaryPartRef.Parent or not bindRef.Parent then
					gyroRef:Destroy()
					if velocityRef then
						velocityRef:Destroy()
					end
					return gyroConnection:Disconnect()
				else
					local lookVector = cameraRef.CFrame.LookVector
					gyroRef.CFrame = CFrame.new(primaryPartRef.Position, primaryPartRef.Position + Vector3.new(lookVector.X, lookVector.Y, lookVector.Z))
					return
				end
			end)

			bodyGyro.Parent = primaryPart
		end
	end,
	
	velocityForward = function(params)
		local character = LocalPlayer.Character
		local humanoidRootPart = character.HumanoidRootPart

		local bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.Name = "VelForwardBv"
		bodyVelocity.MaxForce = Vector3.new(40000, 40000, 40000, 0)
		bodyVelocity.Velocity = humanoidRootPart.CFrame.LookVector * (params.Distance or 55)

		if params.StunCheck then
			bodyVelocity:SetAttribute("StunCheck", true)
		end

		if params.Up then
			bodyVelocity.Velocity += Vector3.new(0, params.Up, 0)
		end

		if params.HeadFirst then
			bodyVelocity.MaxForce = Vector3.new(400000, 400000, 400000, 0)
		end

		if params.Jetdive then
			task.spawn(function()
				local startTime = tick()
				repeat
					task.wait()
				until
				performRaycast({
					orig = humanoidRootPart.Position,
					dir = Vector3.new(0, -7, 0, 0)
				}) or tick() - startTime > 5

				local animModule = require(
					character.Client:FindFirstChild("AnimationPlayer")
						or character.Client:WaitForChild("AnimationPlayer")
				)

				local function playJetdiveAnim(animationId)
					return animModule.playAnimation(game.FindFirstChild(character, "Humanoid"), animationId)
				end

				bodyVelocity:Destroy()
				playJetdiveAnim(71702065996809):Play()
			end)
		end

		bodyVelocity.Parent = params.Alternate or humanoidRootPart
		game:GetService("Debris"):AddItem(bodyVelocity, params.Time or 0.15)

		return bodyVelocity
	end,
	
