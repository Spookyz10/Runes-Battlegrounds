	bulletbarrage = function(Params)
		local Character: Model = Params.Char
		local HumRP: BasePart, Humanoid: Humanoid
		if Character then
			HumRP = Character.HumanoidRootPart
			Humanoid = Character.Humanoid
		end

		local EnemyCharacter: Model = Params.EChar
		local EnemyHumRP: BasePart
		if EnemyCharacter then
			EnemyHumRP = EnemyCharacter.HumanoidRootPart
		end


		local Stage = Params.Stage
		local AssetsFolder = Resources.Suiryu.bulletbarrage


		if Stage == "Barrage" then
			local Bind: Accessory = Character:WaitForChild(Params.BindName)
			local AssetsTable = {}


			local function EnableTrail(TrailPart, TrailVFX, Lifetime)
				local TrailsTable = {}
				table.insert(AssetsTable, TrailVFX)

				local Attachment0 = TrailVFX.Attachment0:Clone()
				table.insert(AssetsTable, Attachment0)

				local Attachment1 = TrailVFX.Attachment1:Clone()
				table.insert(AssetsTable, Attachment1)

				Attachment0.Parent = TrailPart
				Attachment1.Parent = TrailPart


				for _, Trail in TrailVFX:GetChildren() do
					if Trail:IsA("Trail") then
						local TrailClone = Trail:Clone()
						TrailClone.Attachment0 = Attachment0
						TrailClone.Attachment1 = Attachment1
						TrailClone.Parent = TrailPart
						Debris:AddItem(TrailClone, Lifetime)

						table.insert(TrailsTable, TrailClone)
					end
				end

				table.insert(TrailsTable, Attachment0)
				table.insert(TrailsTable, Attachment1)


				return TrailsTable
			end


			task.spawn(function()
				EnableTrail(Character["Left Leg"], AssetsFolder.Trail:Clone(), 3)


				task.wait(1)


				EnableTrail(Character["Left Leg"], AssetsFolder.Trail2:Clone(), 2)
				EnableTrail(Character["Right Leg"], AssetsFolder.Trail2:Clone(), 2)
			end)


			task.wait(0.3)


			if not Bind.Parent then return end


			for _ = 1, 15 do
				if not Bind.Parent then return end


				for i = 1, 2 do
					if not Bind.Parent then return end


					local Last = AssetsFolder.Last:Clone()
					Last:ScaleTo(RandomSeed:NextNumber(0.2, 0.3))

					if i == 2 then
						Last.Start.Decal.Color3 = Color3.fromRGB(45, 45, 185)
					end

					Last:PivotTo(Character["Left Leg"].CFrame * CFrame.new(0, 5, 0) * CFrame.Angles(0, math.rad(math.random(0, 360)), 1.5707963267948966))


					task.spawn(function()
						local StartPart = Last.Start
						local EndPart = Last.End

						Last.PrimaryPart = StartPart


						for _, BasePart in pairs(Last:GetChildren()) do
							if BasePart:IsA("BasePart") then
								BasePart.CanCollide = false
								BasePart.Anchored = true
							end
						end


						StartPart.Transparency = 1
						EndPart.Transparency = 1

						Last.Parent = workspace.Thrown


						local StartDecal = StartPart.Decal
						local StartMesh = StartPart.Mesh
						local EndMesh = EndPart.Mesh
						local EndDecal = EndPart.Decal

						EndDecal.Transparency = 1


						TS:Create(StartMesh, TweenInfo.new(0.08, Enum.EasingStyle.Sine), {
							Scale = EndMesh.Scale
						}):Play()


						for _, Decal in StartPart:GetChildren() do
							if Decal:IsA("Decal") then
								TS:Create(Decal, TweenInfo.new(0.08, Enum.EasingStyle.Sine), {
									Transparency = 1
								}):Play()
							end
						end


						TS:Create(StartPart, TweenInfo.new(0.08, Enum.EasingStyle.Sine), {
							Size = EndPart.Size, 
							CFrame = EndPart.CFrame
						}):Play()


						Debris:AddItem(Last, 0.08)
					end)
				end

				task.wait(0.05)
			end

		elseif Stage == "Knockback1" then
			for _,v in HumRP:GetChildren() do
				if v:IsA("BodyVelocity") or v:IsA("LinearVelocity") then
					v:Destroy()
				end
			end


			local BodyVelocity = Instance.new("BodyVelocity")
			BodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 40000
			BodyVelocity.Velocity = HumRP.CFrame.LookVector * 57 + Vector3.new(0, 35, 0)
			BodyVelocity.Parent = HumRP
			Debris:AddItem(BodyVelocity, 0.4)

			shared.addshake(3)

			local StartTick = tick()
			local StopLoop = nil
			StopLoop = shared.loop(function()
				if not BodyVelocity.Parent or tick() - StartTick > 5 then
					StopLoop()
				else
					BodyVelocity.Velocity *= 0.875
				end
			end, 60)

		elseif Stage == "Knockback2" then
			for _,v in HumRP:GetChildren() do
				if v:IsA("BodyVelocity") or v:IsA("LinearVelocity") then
					v:Destroy()
				end
			end


			local BodyVelocity = Instance.new("BodyVelocity")
			BodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 40000
			BodyVelocity.Velocity = HumRP.CFrame.LookVector * 57 + Vector3.new(0, 105, 0)
			BodyVelocity.Parent = HumRP
			Debris:AddItem(BodyVelocity, 0.15)

			shared.addshake(3)

			local StartTick = tick()
			local StopLoop = nil
			StopLoop = shared.loop(function()
				if not BodyVelocity.Parent or tick() - StartTick > 5 then
					StopLoop()
				else
					BodyVelocity.Velocity *= 0.875
				end
			end, 60)

		elseif Stage == "Knockback3" then
			for _,v in HumRP:GetChildren() do
				if v:IsA("BodyVelocity") or v:IsA("LinearVelocity") then
					v:Destroy()
				end
			end


			local BodyVelocity = Instance.new("BodyVelocity")
			BodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 40000
			BodyVelocity.Velocity = HumRP.CFrame.LookVector * 19 + Vector3.new(0, 40, 0)
			BodyVelocity.Parent = HumRP
			Debris:AddItem(BodyVelocity, 1)

			shared.addshake(3)

			local StartTick = tick()
			local StopLoop = nil
			StopLoop = shared.loop(function()
				if not BodyVelocity.Parent or tick() - StartTick > 5 then
					StopLoop()
				else
					BodyVelocity.Velocity *= 0.96
				end
			end, 60)

		elseif Stage == "Knockback4" then
			if Params.Finisher == true then
				Humanoid.HipHeight = 0.5


				shared.clearVelocities(HumRP)


				local ForwardVelocity = 84
				local UpVelocity = 150
				local UpFallout = 0.92

				local BodyVelocity = Instance.new("BodyVelocity")
				BodyVelocity.Name = "VUP"
				BodyVelocity.MaxForce = Vector3.new(40000, 40000, 40000)
				BodyVelocity.Parent = HumRP

				local StopLoop = nil
				StopLoop = shared.loop(function()
					if not BodyVelocity.Parent or not HumRP.Parent or not Character.Parent then
						return StopLoop()
					end


					BodyVelocity.Velocity = HumRP.CFrame.LookVector * ForwardVelocity + Vector3.new(0, UpVelocity, 0)

					if UpFallout == 0.92 then
						UpVelocity *= UpFallout

					else
						UpVelocity -= 3

					end

					if UpVelocity <= 5 and UpVelocity > 0 then
						UpFallout = 1.1
						UpVelocity *= -1

					end

					ForwardVelocity *= 0.98
				end, 60)



				local Landed: RBXScriptConnection
				Landed = Character:GetAttributeChangedSignal("SkateLand"):Connect(function()
					Landed:Disconnect()
					StopLoop()
					BodyVelocity:Destroy()


					local moveme = Instance.new("BodyVelocity")
					moveme.Name = "moveme"
					moveme.MaxForce = Vector3.new(100000, 0, 100000)
					moveme:SetAttribute("Speed", 125)
					moveme:SetAttribute("End", 1)
					moveme:SetAttribute("Fallout", 0.98)
					moveme.Parent = HumRP

					task.delay(1.483, function()
						moveme:SetAttribute("Fallout", 0.6)

						Humanoid.HipHeight = 0
					end)
				end)

				task.delay(3.6, function()
					Landed:Disconnect()
				end)

			else
				for _,v in HumRP:GetChildren() do
					if v:IsA("BodyVelocity") or v:IsA("LinearVelocity") then
						v:Destroy()
					end
				end


				local BodyVelocity = Instance.new("BodyVelocity")
				BodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 40000
				BodyVelocity.Velocity = HumRP.CFrame.LookVector * 0 + Vector3.new(0, 100, 0)
				BodyVelocity.Parent = HumRP
				Debris:AddItem(BodyVelocity, 0.15)

				shared.addshake(3)

				local StartTick = tick()
				local StopLoop = nil
				StopLoop = shared.loop(function()
					if not BodyVelocity.Parent or tick() - StartTick > 5 then
						StopLoop()
					else
						BodyVelocity.Velocity *= 0.875
					end
				end, 60)

			end

		end
	end,
	
