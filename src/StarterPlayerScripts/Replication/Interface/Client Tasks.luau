		if UIS.TouchEnabled then
			LocalHumanoid:GetPropertyChangedSignal("MoveDirection"):Connect(function()
				if LocalHumanoid.MoveDirection == Vector3.new() then
					for Index, _ in Velocities do
						Velocities[Index] = 0
					end

				else
					local LookVectorDot = LocalHumanoid.MoveDirection:Dot(workspace.CurrentCamera.CFrame.LookVector)
					local RightVectorDot = LocalHumanoid.MoveDirection:Dot(workspace.CurrentCamera.CFrame.RightVector)

					if RightVectorDot < 0 then
						Velocities.Left = RightVectorDot
						Velocities.Right = 0
					else
						Velocities.Left = 0
						Velocities.Right = RightVectorDot
					end

					if LookVectorDot > 0 then
						Velocities.Forward = LookVectorDot
						Velocities.Backward = 0

					else
						Velocities.Backward = LookVectorDot
						Velocities.Forward = 0

					end
				end
			end)
		end
	end,
	
