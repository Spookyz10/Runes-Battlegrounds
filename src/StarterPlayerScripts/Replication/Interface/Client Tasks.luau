local function checkDistance(Start: Part, Goal: Part): number
	if not Start or not Goal then return end

	if typeof(Start) ~= "Vector3" or typeof(Start) == "CFrame" then
		Start = Start.Position
	end

	if typeof(Goal) ~= "Vector3" or typeof(Goal) == "CFrame" then
		Goal = Goal.Position
	end

	return (Goal - Start).Magnitude
end

local function KJEmit(emitter, shouldDestroy)
	local emittersToProcess = emitter
	if emitter:IsA("ParticleEmitter") then
		emittersToProcess = {emitter}
	elseif typeof(emitter) ~= "table" then
		emittersToProcess = emitter:GetDescendants()
	end

	local maxDelay = 0 
	
	for _, currentEmitter in ipairs(emittersToProcess) do
		if currentEmitter:IsA("ParticleEmitter") and currentEmitter:GetAttribute("EmitCount") then
			local lifetime = (typeof(currentEmitter.Lifetime) == "NumberRange" and currentEmitter.Lifetime.Max or currentEmitter.Lifetime) / currentEmitter.TimeScale
			local emitDelay = currentEmitter:GetAttribute("EmitDelay")

			if emitDelay and emitDelay > 0 then
				lifetime = lifetime + emitDelay
				task.delay(emitDelay, function()
					currentEmitter:Emit(currentEmitter:GetAttribute("EmitCount"))
				end)
			else
				currentEmitter:Emit(currentEmitter:GetAttribute("EmitCount"))
			end

			if shouldDestroy then
				task.delay(lifetime, function()
					currentEmitter:Destroy()
				end)

				if maxDelay < lifetime then
					maxDelay = lifetime
				end
			end
		end
	end

	if shouldDestroy and typeof(emitter) == "Instance" then
		task.delay(maxDelay, function()
			emitter:Destroy()
		end)
	end
end



