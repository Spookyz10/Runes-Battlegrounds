local function PlayMesh(MeshContainer)
	task.spawn(function()
		local Model = MeshContainer.Model
		local TweenInformation = MeshContainer.Info or TweenInfo.new(1, Enum.EasingStyle.Sine)
		local StartPart = Model:FindFirstChild("Start")
		local EndPart = Model:FindFirstChild("End")
		local NoDelete = MeshContainer.Stay
		local GoalCFrame = MeshContainer.Anchor
		local GoalTransparency = MeshContainer.EndT or 1
		local ExtraLifetime = MeshContainer.Del
		local Skip = MeshContainer.Skip


		Model.PrimaryPart = StartPart


		if not Skip then
			for _, eyes in pairs(Model:GetChildren()) do
				if eyes:IsA("BasePart") then
					eyes.CanCollide = false
					eyes.Anchored = true
				end
			end
		end

		if GoalCFrame then
			Model:PivotTo(GoalCFrame)
		end

		if MeshContainer.T then
			StartPart.Transparency = MeshContainer.T
		end


		EndPart.Transparency = 1
		Model.Parent = workspace.Thrown


		local StartDecal = StartPart:FindFirstChildOfClass("Decal")
		local StartMesh = StartPart:FindFirstChildOfClass("SpecialMesh")
		local EndMesh = EndPart:FindFirstChildOfClass("SpecialMesh")
		local EndDecal = EndPart:FindFirstChildOfClass("Decal")

		if EndDecal and not Skip then
			EndDecal.Transparency = 1
		end


		local Tween = nil

		if ExtraLifetime then
			TS:Create(StartPart, TweenInformation, {
				Size = EndPart.Size, 
				CFrame = EndPart.CFrame
			}):Play()

			task.delay(ExtraLifetime, function()
				Tween = TS:Create(StartPart, TweenInformation, {
					Transparency = GoalTransparency
				})

				Tween:Play()

				if StartDecal then
					for _, Decal in pairs(StartPart:GetChildren()) do
						if Decal:IsA("Decal") then
							TS:Create(Decal, TweenInformation, {
								Transparency = GoalTransparency
							}):Play()
						end
					end
				end

				if StartMesh then
					Tween = TS:Create(StartMesh, TweenInformation, {
						Scale = EndMesh.Scale
					}):Play()
				end
			end)

		else
			if StartMesh then
				TS:Create(StartMesh, TweenInformation, {
					Scale = EndMesh.Scale
				}):Play()
			end

			if StartDecal then
				for _, randomVFX in pairs(StartPart:GetChildren()) do
					if randomVFX:IsA("Decal") then
						TS:Create(randomVFX, TweenInformation, {
							Transparency = GoalTransparency
						}):Play()
					end
				end

				Tween = TS:Create(StartPart, TweenInformation, {
					Size = EndPart.Size, 
					CFrame = EndPart.CFrame
				})

				Tween:Play()
			else
				Tween = TS:Create(StartPart, TweenInformation, {
					Size = EndPart.Size, 
					Transparency = GoalTransparency, 
					CFrame = EndPart.CFrame
				})

				Tween:Play()
			end
		end


		if not NoDelete then
			if ExtraLifetime then
				task.wait(ExtraLifetime + 0.1)
			end

			Tween.Completed:Connect(function()
				Model:Destroy()
			end)
		end
	end)
end

local function CreateObjectManager(container, objectList, cleanupDelay)
	local objectMap = {}

	for _, child in pairs(container:GetChildren()) do
		objectMap[child.Name] = child
	end

	local objectRetriever = setmetatable({}, {
		__index = function(_, key)
			return {
				Clone = function()
					local clonedObject = rawget(objectMap, key):Clone()
					if not table.find(objectList, clonedObject) then
						table.insert(objectList, clonedObject)
					end
					return clonedObject
				end
			}
		end
	})

	local objectManager = {
		_maid = {}
	}

	objectManager._maid.give = function(_, obj)
		if not table.find(objectList, obj) then
			table.insert(objectList, obj)
		end
		return obj
	end

	objectManager._maid.giveTask = function(_, taskObj)
		if not table.find(objectList, taskObj) then
			table.insert(objectList, taskObj)
		end
		return taskObj
	end

	local function cleanup()
		if objectRetriever and objectManager then
			table.clear(objectRetriever)
			table.clear(objectManager)
		end

		if objectMap then
			table.clear(objectMap)
			objectMap = nil
		end

		objectManager = nil
		objectRetriever = nil

		if objectList then
			for index, obj in pairs(objectList) do
				if typeof(obj) == "RBXScriptConnection" then
					obj:Disconnect()
				elseif typeof(obj) == "Instance" then
					obj:Destroy()
				end
				objectList[index] = nil
			end
			table.clear(objectList)
		end
		objectList = nil
	end

	task.delay(cleanupDelay or 10, cleanup)

	return objectRetriever, objectManager, cleanup
end

