local function handleEmittersAndBeams(object, debrisTime, tweenConfig)
	for _, descendant in pairs(object:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			local emitterAttributes = descendant:GetAttributes()
			local emitDelay = emitterAttributes.EmitDelay

			if emitDelay then
				task.delay(emitDelay, function()
					descendant:Emit(emitterAttributes.EmitCount)
				end)
			else
				descendant:Emit(emitterAttributes.EmitCount)
			end

			if emitterAttributes.EmitDuration then
				descendant.Enabled = true
				task.delay(emitterAttributes.EmitDuration, function()
					descendant.Enabled = false
				end)
			end
		end

		if descendant:IsA("Beam") then
			local beamAttributes = descendant:GetAttributes()
			local beamDuration = beamAttributes.Duration
			local tweenTime = tweenConfig and tweenConfig.TweenTime or 0.5

			local function createBeamTween()
				game:GetService("TweenService"):Create(
					descendant, 
					TweenInfo.new(tweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), 
					{ Width1 = 0, Width0 = 0 }
				):Play()
			end

			game:GetService("TweenService"):Create(
				descendant, 
				TweenInfo.new(tweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), 
				{ Width1 = beamAttributes.Width1, Width0 = beamAttributes.Width0 }
			):Play()

			if beamDuration then
				task.delay(beamDuration, function()
					createBeamTween()
				end)
			end
		end
	end

	if debrisTime then
		game.Debris:AddItem(object, debrisTime)
	end
end

