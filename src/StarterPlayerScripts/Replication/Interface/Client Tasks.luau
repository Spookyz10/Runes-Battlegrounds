local function MakeDarker(BaseColor, RedModifier, GreenModifier, BlueModifier)
	if typeof(RedModifier) ~= "number" then
		RedModifier = 10
	end

	if typeof(GreenModifier) ~= "number" then
		GreenModifier = 10
	end

	if typeof(BlueModifier) ~= "number" then
		BlueModifier = 10
	end


	local Red = BaseColor.R * 255 - RedModifier
	if Red < 0 then
		Red = 0
	end

	if Red > 255 then
		Red = 255
	end


	local Green = BaseColor.G * 255 - GreenModifier
	if Green < 0 then
		Green = 0
	end

	if Green > 255 then
		Green = 255
	end


	local Blue = BaseColor.B * 255 - BlueModifier
	if Blue < 0 then
		Blue = 0
	end

	if Blue > 255 then
		Blue = 255
	end


	return Color3.fromRGB(Red, Green, Blue)
end

local function GetTile(Position: Vector3, Height: number)
	if not Position then return end
	Height = Height or 7

	local Raycast = workspace:Raycast(Position, Vector3.new(0, -math.abs(Height), 0), TilesRaycastParams)
	if Raycast and Raycast.Instance and Raycast.Instance:GetAttribute("Destroyed") ~= true then
		return Raycast.Instance
	end
end

local function DestroyTile(Tile, ForwardVelocity, UpVelocity, Delays, RecoveryTime, Sound)
	if not Tile or not Tile.Parent or Tile:GetAttribute("Destroyed") then return end


	ForwardVelocity = ForwardVelocity or {
		20, 
		30
	}
	UpVelocity = UpVelocity or {
		60, 
		70
	}
	Sound = Sound or true
	Delays = Delays or {
		4, 
		5
	}

	Tile:SetAttribute("Destroyed", true)

	if Sound == true then
		SoundsModule:AddSound(Resources.Sounds.TileBreak, Tile.CFrame)
	end

	local BreakAngle = math.random(1, 2)
	local XSize = Tile.Size.X / 2
	local ZSize = Tile.Size.Z / 2
	local Folder = Instance.new("Folder")
	Folder.Name = "FlyingRocks"
	local TileClone = Tile:Clone()
	TileClone:SetAttribute("Destroyed", nil)
	TileClone.Anchored = false
	TileClone.CastShadow = true
	TileClone.Color = MakeDarker(Tile.Color, 5, 5, 5)
	TileClone.CollisionGroup = "NonPColDebri"

	if BreakAngle == 1 then
		TileClone.Size = Vector3.new(XSize, Tile.Size.Y + 0.075, TileClone.Size.Z)
	elseif BreakAngle == 2 then
		TileClone.Size = Vector3.new(TileClone.Size.X, 0, ZSize)
	end

	local TileClone2 = TileClone:Clone()
	if BreakAngle == 1 then
		TileClone.Position = TileClone.Position - Vector3.new(XSize / 2, 0, 0)
		TileClone2.Position = TileClone2.Position + Vector3.new(XSize / 2, 0, 0)
	elseif BreakAngle == 2 then
		TileClone.Position = TileClone.Position - Vector3.new(0, 0, ZSize / 2)
		TileClone2.Position = TileClone2.Position + Vector3.new(0, 0, ZSize / 2)
	end

	Tile.Position -= Vector3.new(0, 10, 0)

	TileClone.Parent = Folder
	TileClone2.Parent = Folder

	Folder.Parent = workspace.Thrown

	TileClone.AssemblyLinearVelocity = CFrame.new(Tile.Position, TileClone.Position).LookVector * Random.new():NextNumber(ForwardVelocity[1], ForwardVelocity[2]) + Vector3.new(0, Random.new():NextNumber(UpVelocity[1], UpVelocity[2]), 0)
	TileClone2.AssemblyLinearVelocity = CFrame.new(Tile.Position, TileClone2.Position).LookVector * Random.new():NextNumber(ForwardVelocity[1], ForwardVelocity[2]) + Vector3.new(0, Random.new():NextNumber(UpVelocity[1], UpVelocity[2]), 0)

	TileClone.AssemblyAngularVelocity = Vector3.new(math.random(2, 3), math.random(2, 3), math.random(2, 3))
	TileClone2.AssemblyAngularVelocity = Vector3.new(math.random(2, 3), math.random(2, 3), math.random(2, 3))


	local Tile1Delay = Random.new():NextNumber(Delays[1], Delays[2])
	local Tile2Delay = Random.new():NextNumber(Delays[1], Delays[2])

	Debris:AddItem(TileClone, Tile1Delay + 1.5)
	Debris:AddItem(TileClone2, Tile2Delay + 1.5)
	Debris:AddItem(Folder, math.max(Tile1Delay, Tile2Delay) + 1.5)

	task.delay(1.5, function()
		Tile.CanCollide = true
		Tile:SetAttribute("Destroyed", nil)
	end)

	task.delay(Tile1Delay, function()
		TS:Create(TileClone, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
			Transparency = 1
		}):Play()
	end)

	task.delay(Tile2Delay, function()
		TS:Create(TileClone2, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
			Transparency = 1
		}):Play()
	end)

	task.delay(RecoveryTime or Random.new():NextNumber(9, 13), function()
		Tile.Name = "TEMPORARY NAME"
		Tile.Transparency = 1
		Tile.CanCollide = false
		Tile.Position += Vector3.new(0, 10, 0)

		TS:Create(Tile, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
			Transparency = 0
		}):Play()
	end)
end

shared.clearVelocities = function(Part: Part, Ignore: BodyVelocity?)
	for _, Velocity in Part:GetDescendants() do
		if Velocity ~= Ignore and (Velocity:IsA("BodyVelocity") or Velocity:IsA("LinearVelocity") or Velocity:IsA("BodyPosition") or Velocity:IsA("BodyGyro") or Velocity:IsA("BodyAngularVelocity") or Velocity:IsA("BodyMover") or Velocity:IsA("BodyForce") or Velocity:IsA("BodyThrust") or Velocity:IsA("AngularVelocity") or Velocity:IsA("VelocityMotor")) then
			Velocity:Destroy()
		end
	end
end

