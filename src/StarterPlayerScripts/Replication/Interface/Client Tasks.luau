				VFX_2Weld.Part1 = VFX_2
				VFX_2Weld.C0 = CFrame.Angles(0, -1.5707963267948966, 0)
				VFX_2Weld.Parent = Character

				for _, ParticleEmitter in VFX_2:GetDescendants() do
