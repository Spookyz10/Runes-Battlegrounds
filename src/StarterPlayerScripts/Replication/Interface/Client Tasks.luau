	whirlwinddrop = function(Params)
		local Character: Model = Params.Char
		local HumRP: BasePart, Humanoid: Humanoid
		if Character then
			HumRP = Character.HumanoidRootPart
			Humanoid = Character.Humanoid
		end

		local EnemyCharacter: Model = Params.EChar
		local EnemyHumRP: BasePart
		if EnemyCharacter then
			EnemyHumRP = EnemyCharacter.HumanoidRootPart
		end


		local AssetsFolder = Resources.Suiryu.WhirlwindDrop
		local Stage = Params.Stage

		if Stage == "jump" then
			local Bind: Accessory = Character:WaitForChild(Params.BindName, 5)
			if not Bind then return end


			local BodyVelocity = Instance.new("BodyVelocity")
			BodyVelocity.MaxForce = Vector3.new(40000, 40000, 40000)
			BodyVelocity.Velocity = Vector3.new(0, 3, 0)
			BodyVelocity.Parent = HumRP
			Debris:AddItem(BodyVelocity, 1.4)


			local Velocity = 1.3
			if not workspace:raycast(HumRP.Position, Vector3.new(0, -15, 0), MapRayParams) then
				Velocity = 1.1
				Debris:AddItem(BodyVelocity, 0.3)
			end


			local StartTime = tick()
			local StopLoop = nil

			StopLoop = shared.loop(function()
				if not BodyVelocity or not BodyVelocity.Parent or tick() - StartTime > 5 or not Bind.Parent then
					if BodyVelocity and BodyVelocity.Parent then
						BodyVelocity:Destroy()
					end

					return StopLoop()

				else
					if Velocity >= 1 then
						BodyVelocity.Velocity *= Vector3.new(1, Velocity, 1)

					else
						BodyVelocity.Velocity *= Velocity

					end

					Velocity *= 0.99
				end
			end, 60)

		elseif Stage == "down" then
			local EasingTime = 0.27560944733796294
			local GoalCF: CFrame = Params.GoalCF


			local CFrameValue = Instance.new("CFrameValue")
			CFrameValue.Value = HumRP.CFrame

			TS:Create(CFrameValue, TweenInfo.new(EasingTime, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
				Value = GoalCF
			}):Play()

			local StepConnection = nil
			StepConnection = RNS.Heartbeat:Connect(function()
				if not Character or not Character.Parent then return StepConnection:Disconnect() end


				local CurrentCF = HumRP.CFrame
				local ValueCF = CFrameValue.Value

				CurrentCF = {
					CurrentCF:GetComponents()
				}

				CurrentCF[1] = ValueCF.X
				CurrentCF[2] = ValueCF.Y
				CurrentCF[3] = ValueCF.Z

				HumRP.CFrame = CFrame.new(unpack(CurrentCF))
			end)

			task.delay(EasingTime, function()
				StepConnection:Disconnect()
				CFrameValue:Destroy()
			end)


		elseif Stage == "VFX" then
			local AnimationTrack: AnimationTrack = nil

			for _, PlayingTrack in Humanoid.Animator:GetPlayingAnimationTracks() do
				if PlayingTrack.Animation.AnimationId == Params.AnimationId then
					AnimationTrack = PlayingTrack

					break
				end
			end


			if not AnimationTrack or not AnimationTrack.IsPlaying then return end

			Humanoid.Animator.AnimationPlayed:Connect(function(PlayingTrack)
				if PlayingTrack.Animation.AnimationId == "rbxassetid://88882521437636" then
					AnimationTrack = PlayingTrack
				end
			end)


			local function WindBeam(Scale1, Scale2, GoalBrightness, LifetimeMultiplier)
				local SpinBeam = AssetsFolder.SpinBeam:Clone()
				SpinBeam:ScaleTo(RandomSeed:NextNumber(Scale1, Scale2))

				SpinBeam:PivotTo(HumRP.CFrame * CFrame.Angles(math.rad((Random.new():NextNumber(-5, 10))), math.rad(RandomSeed:NextNumber(0, 360)), (math.rad((Random.new():NextNumber(-5, 10))))))
				SpinBeam.Parent = workspace.Thrown
				Debris:AddItem(SpinBeam, 0.37 * LifetimeMultiplier)

				for _, Beam in SpinBeam.PrimaryPart:GetDescendants() do
					if Beam:IsA("Beam") then
						local GoalWidth0 = Beam.Width0
						local GoalWidth1 = Beam.Width1

						Beam.Width0 = 0
						Beam.Width1 = 0


						TS:Create(Beam, TweenInfo.new(0.03 * LifetimeMultiplier, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
							Brightness = GoalBrightness
						}):Play()

						TS:Create(Beam, TweenInfo.new(0.25 * LifetimeMultiplier, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
							Width1 = GoalWidth1, 
							Width0 = GoalWidth0
						}):Play()

						task.delay(0.031, function()
							TS:Create(Beam, TweenInfo.new(0.3 * LifetimeMultiplier, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								Brightness = 0, 
								TextureSpeed = -1.5
							}):Play()
						end)
					end
				end
			end

			task.delay(0.135, function()
				for i = 1, 6 do
					if not AnimationTrack or not AnimationTrack.IsPlaying then return end

					local WindTrail = AssetsFolder.CharFX.WindTrail:Clone()
					WindTrail.Position = Vector3.new(Random.new():NextNumber(3, -3), Random.new():NextNumber(1.75, -1.75), Random.new():NextNumber(3, -3))
					WindTrail.Parent = Character.Torso
					Debris:AddItem(WindTrail, 1.5)

					task.delay(0.3, function()
						ParticlesModule.Enabled(WindTrail, false)
					end)


					task.wait(0.08)
				end
			end)


			local Spin = AssetsFolder.CharFX.Spin:Clone()
			Debris:AddItem(Spin, 1.4)

			task.delay(0.4, function()
				if not AnimationTrack or not AnimationTrack.IsPlaying then return end

				Spin.Parent = Character.Torso
			end)

			task.delay(0.35, function()
				if not AnimationTrack or not AnimationTrack.IsPlaying then return end

				for i = 1, 3 do
					if not AnimationTrack or not AnimationTrack.IsPlaying then return end					

					WindBeam(0.35, 0.65, 1.25, 1)


					task.wait(0.025)
				end
			end)

			task.delay(0.77, function()
				if not AnimationTrack or not AnimationTrack.IsPlaying then return end

				ParticlesModule.Enabled(Spin, false)

				local LegTrail = AssetsFolder.CharFX.LegTrail:Clone()
				LegTrail.Parent = Character["Left Leg"]
				Debris:AddItem(LegTrail, 0.33)
			end)

			task.delay(0.93, function()
				if not AnimationTrack or not AnimationTrack.IsPlaying then return end

				for i = 1, 4 do
					if not AnimationTrack or not AnimationTrack.IsPlaying then return end

					WindBeam(0.9, 2.5, 0.6, RandomSeed:NextNumber(1.3, 1.55))


					task.wait(0.012)
				end
			end)

			task.delay(0.89, function()
				if not AnimationTrack or not AnimationTrack.IsPlaying then return end

				local GroundImpact = AssetsFolder.GroundImpact:Clone()
				GroundImpact:PivotTo(HumRP.CFrame)
				GroundImpact.Parent = workspace.Thrown
				Debris:AddItem(GroundImpact, 7)


				ParticlesModule.Emit(GroundImpact.DownLines)


				task.wait()


				local GroundRay = raycast(HumRP.Position, Vector3.new(0, -200, 0))
				if GroundRay then
					GroundImpact:PivotTo(CFrame.new(GroundRay.Position))
				end


				task.wait(0.12)


				if not AnimationTrack or not AnimationTrack.IsPlaying then return end

				ParticlesModule.Emit(GroundImpact.Ground)


				local ShockwaveStart = GroundImpact.ShockwaveStart
				local ShockwaveEnd = GroundImpact.ShockwaveEnd

				ShockwaveStart.Decal.Transparency = 0

				TS:Create(ShockwaveStart, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					CFrame = ShockwaveEnd.CFrame
				}):Play()

				TS:Create(ShockwaveStart.Mesh, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Scale = ShockwaveEnd.Mesh.Scale
				}):Play()

				TS:Create(ShockwaveStart.Decal, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Transparency = 1
				}):Play()


				local Start = GroundImpact.Start
				Start.Transparency = 0.2

				ShockwaveEnd = GroundImpact.End

				TS:Create(Start, TweenInfo.new(0.75, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
					CFrame = ShockwaveEnd.CFrame, 
					Size = ShockwaveEnd.Size, 
					Transparency = 1
				}):Play()
			end)

		elseif Stage ==  "FinisherGroundKicks" then
			local Assets = Resources.Suiryu.HeadFirst


			task.spawn(function()
				local Thing = Assets.Thing:Clone()
				Thing:ScaleTo(0.75)
				Thing:PivotTo(HumRP.CFrame * CFrame.new(0, 0.5, 0) * CFrame.Angles(0, -1.5707963267948966, 0))
				Thing.Parent = workspace.Thrown


				local StartPart = Thing.Start
				local EndPart = Thing.End

				TS:Create(StartPart, TweenInfo.new(0.5, Enum.EasingStyle.Exponential), {
					Size = EndPart.Size, 
					Transparency = 1, 
					CFrame = EndPart.CFrame
				}):Play()


				Debris:AddItem(Thing, 0.5)
			end)

			task.spawn(function()
				local Thing = Assets.Thing:Clone()
				Thing:ScaleTo(0.4)
				Thing:PivotTo(HumRP.CFrame * CFrame.new(0, 0.5, 0) * CFrame.Angles(0, -1.5707963267948966, 0))
				Thing.Parent = workspace.Thrown


				local StartPart = Thing.Start
				local EndPart = Thing.End

				TS:Create(StartPart, TweenInfo.new(1, Enum.EasingStyle.Exponential), {
					Size = EndPart.Size, 
					Transparency = 1, 
					CFrame = EndPart.CFrame
				}):Play()


				Debris:AddItem(Thing, 1)
			end)

			task.spawn(function()
				local Br = Assets.Br:Clone()
				Br:ScaleTo(1.4)
				Br:PivotTo(HumRP.CFrame * CFrame.new(0, 0.5, 0) * CFrame.Angles(0, 0, 1.5707963267948966))
				Br.Parent = workspace.Thrown


				local TweeningInfo = TweenInfo.new(0.1, Enum.EasingStyle.Sine)
				local StartPart = Br.Start
				local EndPart = Br.End

				TS:Create(StartPart.Mesh, TweeningInfo, {
					Scale = EndPart.Mesh.Scale
				}):Play()

				TS:Create(StartPart.Decal, TweeningInfo, {
					Transparency = 1
				}):Play()

				TS:Create(StartPart, TweeningInfo, {
					Size = EndPart.Size, 
					CFrame = EndPart.CFrame
				}):Play()


				Debris:AddItem(Br, 0.1)
			end)


			task.wait(0.05)


			local Model = Assets.Model:Clone()
			Model.Part.Attachment["4"]:Destroy()
			Model:PivotTo(HumRP.CFrame * CFrame.new(1.25508118, -2.13430786, -1.32826233, 0.758894801, -0.0053775236, -0.65119195, 0.16220054, 0.970012307, 0.181017309, 0.630690575, -0.242996708, 0.737009406))
			Model:ScaleTo(Params.Scale)
			Model.Parent = workspace.Thrown
			ParticlesModule.Emit(Model)
			Debris:AddItem(Model, 1)

		end
	end,
	
	headfirst = function(Params)
		local Character: Model = Params.Char
		local HumRP: BasePart, Humanoid: Humanoid
		if Character then
			HumRP = Character.HumanoidRootPart
			Humanoid = Character.Humanoid
		end

		local EnemyCharacter: Model = Params.EChar
		local EnemyHumRP: BasePart
		if EnemyCharacter then
			EnemyHumRP = EnemyCharacter.HumanoidRootPart
		end


		local AssetsFolder = Params.Finisher and Resources.Suiryu.HeadFirstFinisher or Resources.Suiryu.HeadFirst
		local Stage = Params.Stage

		if Stage == "Trail" then
			local function EnableTrail(MainPart, TrailsContainer, Lifetime)
				local Trails = {}

				local Attachment0 = TrailsContainer.Attachment0:Clone()
				local Attachment1 = TrailsContainer.Attachment1:Clone()
				Attachment0.Parent = MainPart
				Attachment1.Parent = MainPart

				for _, Trail in TrailsContainer:GetChildren() do
					if Trail:IsA("Trail") then
						local TrailClone = Trail:Clone()
						TrailClone.Attachment0 = Attachment0
						TrailClone.Attachment1 = Attachment1
						TrailClone.Parent = MainPart
						table.insert(Trails, TrailClone)
					end
				end

				table.insert(Trails, Attachment0)
				table.insert(Trails, Attachment1)

				for _, Trail in pairs(Trails) do
					Debris:AddItem(Trail, Lifetime)
				end


				return Trails
			end

			EnableTrail(Character["Right Leg"], Resources.Suiryu.m1.FasterM1Trail, 0.25)
			EnableTrail(Character["Left Leg"], Resources.Suiryu.m1.FasterM1Trail, 0.25)
			EnableTrail(Character["Left Leg"], Resources.Suiryu.m1.M1Trail, 0.85)

