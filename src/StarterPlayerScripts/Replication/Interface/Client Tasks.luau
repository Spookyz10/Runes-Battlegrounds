	BakugoDivineRush = function(Params)
		local Character = Params.char
		local HRP = Character.HumanoidRootPart
		local stage = Params.stage

		local TweenService = game:GetService("TweenService")
		local Debris = game:GetService("Debris")
		local Lighting = game:GetService("Lighting")
		local LocalPlayer = game:GetService("Players").LocalPlayer
		local isOwner = LocalPlayer.Character == Character

		local Assets = Resources.BakugoAssets.Effects.Explosion

		if stage == "Start" then

			-- [[ Hide map for everyone ]]:
			local mapTransparencies = {}
			for _, obj in pairs(workspace.Map:GetDescendants()) do
				if obj:IsA("BasePart") then
					mapTransparencies[obj] = obj.Transparency
					obj.Transparency = 1
				end
			end
			local function restoreMap()
				for obj, transparency in pairs(mapTransparencies) do
					if obj and obj.Parent then obj.Transparency = transparency end
				end
			end

			if isOwner then
				task.spawn(function()
					local Camera = workspace.CurrentCamera

					-- [[ Use CFrame directly - no reconstruction needed ]]:
					local hrpCF = Params.hrpCF

					-- [[ Clone Skill4 VFX ]]:
					local function cloneModel(name, pivotCF)
						local template = Assets.Skill4:FindFirstChild(name)
						if not template then return nil end
						local clone = template:Clone()
						clone.Parent = workspace.Effects
						for _, part in pairs(clone:GetDescendants()) do
							if part:IsA("BasePart") then
								part.CanCollide = false
								part.Anchored = true
							end
						end
						pcall(function() clone:PivotTo(pivotCF) end)
						Debris:AddItem(clone, 6.5)
						return clone
					end

					local cutscene = cloneModel("Explosion04Cutscene", hrpCF)
					local dekuEnv  = cloneModel("DekuBEnviroment", hrpCF)
					local armWeld  = cloneModel("ArmWeld", hrpCF)
					local lineUp   = cloneModel("LineUp", hrpCF * CFrame.new(0, 0, 5))

					if armWeld then
						for _, motor in pairs(armWeld:GetDescendants()) do
							if motor:IsA("Motor6D") then
								local rightArm = Character:FindFirstChild("Right Arm") or Character:FindFirstChild("RightUpperArm")
								if rightArm then motor.Part0 = rightArm end
							end
						end
					end

					local function setEnabled(root, enabled)
						if not root then return end
						for _, obj in pairs(root:GetDescendants()) do
							if obj:IsA("ParticleEmitter") or obj:IsA("Beam") then obj.Enabled = enabled end
						end
					end

					local function emitGroup(root)
						if not root then return end
						for _, v in pairs(root:GetDescendants()) do
							if v:IsA("ParticleEmitter") then v:Emit(v:GetAttribute("EmitCount") or 10) end
						end
					end

					-- [[ VFX sequence ]]:
					if cutscene then setEnabled(cutscene:FindFirstChild("Atmosphere3"), true) end

					task.delay(0.467, function()
						if cutscene and cutscene:FindFirstChild("Warp") then
							local sl = cutscene.Warp:FindFirstChild("ADD") and cutscene.Warp.ADD:FindFirstChild("SurfaceLight")
							if sl then
								local t = TweenService:Create(sl, TweenInfo.new(0.067, Enum.EasingStyle.Linear), { Brightness = 15 })
								t:Play()
								t.Completed:Once(function()
									TweenService:Create(sl, TweenInfo.new(0.35, Enum.EasingStyle.Linear), { Brightness = 0 }):Play()
								end)
							end
						end
					end)

					task.delay(0.483, function()
						if cutscene then emitGroup(cutscene:FindFirstChild("Warp")) end
					end)

					task.delay(1, function()
						if cutscene then
							setEnabled(cutscene:FindFirstChild("Atmosphere3"), false)
							local auraCore = cutscene:FindFirstChild("AuraCore")
							if auraCore then
								setEnabled(auraCore, true)
								local ball = auraCore:FindFirstChild("Ball")
								if ball then ball.Transparency = 0 end
							end
						end
						if armWeld then setEnabled(armWeld, true) end
					end)

					task.delay(1.617, function()
						if cutscene then
							local auraCore = cutscene:FindFirstChild("AuraCore")
							if auraCore then
								setEnabled(auraCore, false)
								local ball = auraCore:FindFirstChild("Ball")
								if ball then ball.Transparency = 1 end
							end
						end
						if armWeld then setEnabled(armWeld, false) end
					end)

					task.delay(1.733, function()
						if cutscene then
							setEnabled(cutscene:FindFirstChild("Atmosphere3"), true)
							emitGroup(cutscene:FindFirstChild("Explodeing"))
						end
						if lineUp then
							for _, v in pairs(lineUp:GetDescendants()) do
								if v:IsA("ParticleEmitter") then v.Enabled = true end
							end
						end
					end)

					task.delay(1.783, function()
						if cutscene and cutscene:FindFirstChild("Explodeing") then
							local pl = cutscene.Explodeing:FindFirstChild("AA") and cutscene.Explodeing.AA:FindFirstChild("PointLight03")
							if pl then
								local t = TweenService:Create(pl, TweenInfo.new(0.083, Enum.EasingStyle.Linear), { Brightness = 12 })
								t:Play()
								t.Completed:Once(function()
									TweenService:Create(pl, TweenInfo.new(1.15, Enum.EasingStyle.Linear), { Brightness = 0 }):Play()
								end)
							end
						end
					end)

