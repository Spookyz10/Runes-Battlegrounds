	normalUppercut = function(Params)
		local hitTarget = Params.Hit

		local hit, hitPos = performRaycast({ orig = hitTarget.PrimaryPart.Position, dir = Vector3.new(0, -25, 0, 0)})

		if hit then
			shared.sfx({
				SoundId = "rbxassetid://82851652741242", 
				CFrame = CFrame.new(hitPos), 
				PlaybackSpeed = 1.2, 
				Volume = 1
			}):Play()
		end

		task.delay(0.075, function()
			local slamEffect = Resources.Bald.Uppercut_Slam:Clone()
			local hit2, hitPos2 = performRaycast({ orig = hitTarget.PrimaryPart.Position, dir = Vector3.new(0, -25, 0, 0) })

			if hit2 then
				slamEffect.Parent = workspace.Thrown
				slamEffect.Position = hitPos2

				for _, emitter in pairs(slamEffect:GetDescendants()) do
					if emitter:IsA("ParticleEmitter") then
						emitter:Emit(emitter:GetAttribute("EmitCount"))
					end
				end

				game:GetService("Debris"):AddItem(slamEffect, 10)
			end
		end)
	end,
	
	baldAwakening = function(Params)
		local Character: Model = Params.Char
		local HumRP: BasePart, Torso: BasePart
		if Character then
			HumRP = Character.HumanoidRootPart
			Torso = Character.Torso
		end
		
		local Burst = Resources.Bald.Awakening.PART.Wind:Clone()
		Burst.Parent = HumRP
		ParticlesModule.Emit(Burst)
		Debris:AddItem(Burst, 2)
	end,
	
	saitamaAirTrail = function(Params)
