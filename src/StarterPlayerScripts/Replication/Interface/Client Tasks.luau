				end)
			end

		elseif stage == "Hit" then
			local EnemyCharacter = Params.enemy
			local torso = EnemyCharacter and (EnemyCharacter:FindFirstChild("Torso") or EnemyCharacter:FindFirstChild("UpperTorso"))
			if torso then
