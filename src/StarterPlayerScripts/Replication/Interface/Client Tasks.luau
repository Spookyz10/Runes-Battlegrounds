	DarkLordCombat = function(Params)
		local Character: Model = Params.Char
		local HumRP: BasePart = Character.HumanoidRootPart
		
		local Action = Params.Action
		
		
		local function EmitVFX(GoalVFX)
			if GoalVFX == nil then
				warn("the part ur trying to vfx doesnt exist")
			end

			for _, v in pairs(GoalVFX:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					local EmitCount = v:GetAttribute("EmitCount")
					if EmitCount ~= 0 and EmitCount ~= nil then
						if EmitCount ~= 1 and LocalPlayer:GetAttribute("Fast_Mode") then
							EmitCount = EmitCount / 2
						end

						v:Emit(EmitCount)
					end
				end
			end
		end

		local function vfxPart(Part, State)
			if Part == nil then
				warn("the part ur trying to vfx doesnt exist")
			end

			for _, v in pairs(Part:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					v.Enabled = State
				end

				if v:IsA("Trail") then
					v.Enabled = State
				end

				if v:IsA("Beam") then
					v.Enabled = State
				end
			end
		end
		
		if Action == "Slash" then
