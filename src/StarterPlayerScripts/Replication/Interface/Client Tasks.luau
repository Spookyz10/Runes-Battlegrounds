							T = 0.75, 
							Anchor = HumRP.CFrame * CFrame.Angles(math.rad((RandomSeed:NextNumber(-25, 25))), math.rad((RandomSeed:NextNumber(0, 360))), (math.rad((RandomSeed:NextNumber(-25, 25))))), 
							Info = TweenInfo.new(RandomSeed:NextNumber(0.15, 0.33), Enum.EasingStyle.Sine)
						})


						task.wait(0.05)
					end
				end)


				local FinisherTrack: AnimationTrack = nil
				for _, AnimationTrack: AnimationTrack in pairs(Character.Humanoid.Animator:GetPlayingAnimationTracks()) do
					if AnimationTrack.Animation.AnimationId == "rbxassetid://74148481350543" then
						FinisherTrack = AnimationTrack
						break
					end
				end

				Character.Humanoid.Animator.AnimationPlayed:Connect(function(AnimationTrack: AnimationTrack)
					if AnimationTrack.Animation.AnimationId == "rbxassetid://80005803817941" or AnimationTrack.Animation.AnimationId == "rbxassetid://74148481350543" then
						FinisherTrack = AnimationTrack
					end
				end)


				if not FinisherTrack then
					repeat task.wait() until FinisherTrack
				end				

				for EventName, EventFunction in Events do
