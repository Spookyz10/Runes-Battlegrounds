			TS:Create(KickShockwave.Secondary.Start, TweenInfo.new(0.2, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
				Size = KickShockwave.Secondary.End.Size, 
				CFrame = KickShockwave.Secondary.End.CFrame, 
