	turbotackle = function(Params)
		local Character: Model = Params.Char
		local HumRP: BasePart = Character.HumanoidRootPart

		local function End()
			for _,v in HumRP:GetChildren() do
				if v:IsA('LinearVelocity') then
					v:Destroy()
				end
			end

			local LinearVelocity = Instance.new("LinearVelocity")
			LinearVelocity.Attachment0 = HumRP.RootAttachment
			LinearVelocity.ForceLimitMode = Enum.ForceLimitMode.PerAxis
			LinearVelocity.MaxAxesForce = Vector3.new(1, 0, 1) * 450000
			LinearVelocity.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
			LinearVelocity.Parent = HumRP
			LinearVelocity.VectorVelocity = Vector3.new(0, 0, 140)

			TS:Create(LinearVelocity, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				VectorVelocity = Vector3.new(0, 0, 0)
			}):Play()

			Debris:AddItem(LinearVelocity, 0.8)
		end


		local AssetsFolder = Resources.Okarun.tackle
		local Stage = Params.Stage

		if Stage == "Start" then
			task.delay(0.050, function()
				HumRP.BottomPart.Smoke.Smoke.Enabled = true

				if Character == LocalCharacter then
					local Bind: Accessory = Character:WaitForChild(Params.BindName, 1)
					if not Bind then return end


					for _,v in HumRP:GetChildren() do
						if v:IsA('LinearVelocity') then
							v:Destroy()
						end
					end

					local LinearVelocity = Instance.new("LinearVelocity")
					LinearVelocity.Attachment0 = HumRP.RootAttachment
					LinearVelocity.ForceLimitMode = Enum.ForceLimitMode.PerAxis
					LinearVelocity.MaxAxesForce = Vector3.new(1, 0, 1) * 450000
					LinearVelocity.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
					LinearVelocity.Parent = HumRP

					local startTween = TS:Create(LinearVelocity, TweenInfo.new(0.05, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
						VectorVelocity = Vector3.new(0, 0, -140)
					})
					local endTween = TS:Create(LinearVelocity, TweenInfo.new(0.65, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
						VectorVelocity = Vector3.new(0, 0, -11)
					})

					startTween.Completed:Once(function()
						task.delay(0.1, function()
							endTween:Play()
						end)
					end)


					startTween:Play()
					Debris:AddItem(LinearVelocity, 1.2)


					local BindConnection = Bind.Destroying:Once(function()
						LinearVelocity:Destroy()
					end)

					task.delay(1.2, function()
						BindConnection:Disconnect()
					end)
				end
			end)

			task.delay(1.083, function()
				HumRP.BottomPart.Smoke.Smoke.Enabled = false
			end)

		elseif Stage == "Hit" then
			if Character == LocalCharacter or (HumRP.Position - LocalCharacter:GetPivot().Position).Magnitude <= 15 then
				shared.addshake(3.75, 1)
			end

		elseif Stage == "TorsoEffect" then
			local TorsoEffect = AssetsFolder.TorsoEffect:Clone()
			TorsoEffect.Parent = workspace.Thrown
			Debris:AddItem(TorsoEffect, 2.55)

			local TorsoEffectWeld = Instance.new("Weld")
			TorsoEffectWeld.Part0 = Character.Torso
			TorsoEffectWeld.Part1 = TorsoEffect
			TorsoEffectWeld.Parent = TorsoEffect

			ParticlesModule.Enabled(TorsoEffect, true)


			task.delay(0.55, function()
				ParticlesModule.Enabled(TorsoEffect, false)
			end)

