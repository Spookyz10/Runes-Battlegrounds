	DamageIndicator = function(Params)
		local Character = Params.Char
		local Value = Params.Val

		local AssetsFolder = Resources.Chara.Passive

		local CharaUtility = require(RS_Modules.Game.Utility)
		
		local GUI = AssetsFolder.UI:Clone()
		GUI.Name = "CharaDamageIndicator"
		GUI.Value.Text = tostring(CharaUtility.DecimalRound(Value))
		GUI.Value.TextTransparency = 1
		GUI.Value.UIStroke.Transparency = 1
		GUI.StudsOffsetWorldSpace = Vector3.new(nil, 0, 0)
		GUI.Parent = Character.Torso


		TS:Create(GUI.Value, TweenInfo.new(0.25), {
			TextTransparency = 0
		}):Play()

		TS:Create(GUI.Value.UIStroke, TweenInfo.new(0.25), {
			Transparency = 0
		}):Play()


		local RandomSeedOne = CharaUtility.Seed:NextNumber(-3, 3)
		local RandomSeedTwo = CharaUtility.Seed:NextNumber(-0.75, 1.25)

		local Math = math.random()
		local MathSecond = math.random()
		local MathThird = math.random()

		local StartTime = tick()
		local Value = 0
		local SecondValue = 1.5


		CharaUtility.BindSignalDisconnectToInstanceDestroying(RNS.PreRender, GUI, function(dt)
			Value = Value + dt
			local DoMath = math.noise(StartTime + Math, Value * 7.15 + MathSecond, MathThird) * 1.7 * SecondValue
			local DoMeth = math.noise(StartTime + Math, -Value * 7.19 + MathThird, MathSecond) * 1.7 * SecondValue

			SecondValue = 1 - TS:GetValue(math.clamp(Value * 1.6666666666666667, 0, 1), Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
			GUI.StudsOffsetWorldSpace = Vector3.new(RandomSeedOne + DoMath, RandomSeedTwo + DoMeth)
		end)


		task.delay(1, function()
			TS:Create(GUI.Value, TweenInfo.new(0.75), {
				TextTransparency = 1
			}):Play()

			TS:Create(GUI.Value.UIStroke, TweenInfo.new(0.75), {
				Transparency = 1
			}):Play()

			task.delay(0.75, GUI.Destroy, GUI)
		end)
	end,
	
