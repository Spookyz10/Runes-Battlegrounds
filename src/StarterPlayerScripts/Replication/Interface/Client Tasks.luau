		-- Emits VFX that is an Attachment — parents to part directly, no PivotTo
		local function emitAttachmentVFX(template, parent)
			if not template or not parent then return end
			local clone = template:Clone()
			clone.Parent = parent
			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 25)
				end
			end
			Debris:AddItem(clone, 1)
		end

		local function applyStopSign(char, lifetime)
			local arm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightLowerArm")
			local template = Beatdown:FindFirstChild("Stop Sign")
			if not arm or not template then return end

			local clone = template:Clone()
			clone.Parent = char
			clone:PivotTo(arm.CFrame)

			local weld      = Instance.new("WeldConstraint")
			weld.Part0      = arm
			weld.Part1      = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart")
			weld.Parent     = arm

			-- Fade in
			for _, part in ipairs(clone:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Transparency = 1
					TweenService:Create(part, TweenInfo.new(0.3), { Transparency = 0 }):Play()
				end
			end

			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("ParticleEmitter") or v:IsA("Trail") then
					v.Enabled = true
				end
			end

			task.delay(lifetime, function()
				for _, v in ipairs(clone:GetDescendants()) do
					if v:IsA("ParticleEmitter") or v:IsA("Trail") then
						v.Enabled = false
					end
				end
				for _, part in ipairs(clone:GetDescendants()) do
					if part:IsA("BasePart") then
						TweenService:Create(part, TweenInfo.new(0.3), { Transparency = 1 }):Play()
					end
				end
				Debris:AddItem(clone, 0.5)
			end)
		end

		local function applyArmTrail(char, lifetime)
			local arm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightLowerArm")
			local trail = Beatdown:FindFirstChild("ArmTrail")
			if not arm or not trail then return end
			local clone = trail:Clone()
			clone.Parent = arm
			local weld  = Instance.new("WeldConstraint")
			weld.Part0  = arm
			weld.Part1  = clone
			weld.Parent = clone
			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("ParticleEmitter") or v:IsA("Trail") then v.Enabled = true end
			end
			task.delay(lifetime, function()
				for _, v in ipairs(clone:GetDescendants()) do
					if v:IsA("ParticleEmitter") or v:IsA("Trail") then v.Enabled = false end
				end
				Debris:AddItem(clone, 1)
			end)
		end

		local function applyEnemyTrail(enemy, lifetime)
			local hrp = enemy:FindFirstChild("HumanoidRootPart")
			local trail = Beatdown:FindFirstChild("EnemyTrail")
			if not hrp or not trail then return end
			local clone = trail:Clone()
			clone.Parent = hrp
			local weld  = Instance.new("WeldConstraint")
			weld.Part0  = hrp
			weld.Part1  = clone
			weld.Parent = clone
			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("ParticleEmitter") or v:IsA("Trail") then v.Enabled = true end
			end
			Debris:AddItem(clone, lifetime or 3)
		end

		-- ── Stages ────────────────────────────────────────────────────────

		if Stage == "startup" then
			applyStopSign(Character, 0.5)

		elseif Stage == "start" then
			emitVFX(Beatdown.Emit:FindFirstChild("Hit"), EnemyTorso)
			applyStopSign(Character, 2.5)
			applyArmTrail(Character, 2.5)

		elseif Stage == "hit" then
			emitVFX(Beatdown.Emit:FindFirstChild("Hit"), EnemyTorso)
			camShake(0.25, 0.1)

		elseif Stage == "dust" then
			-- Dust is an Attachment so parent it directly to HRP, no PivotTo
			local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
			if HRP then
				emitAttachmentVFX(Beatdown.Emit:FindFirstChild("Dust"), HRP)
			end

		elseif Stage == "finalHit" then
			emitVFX(Beatdown.Emit:FindFirstChild("FinalSlam"), EnemyTorso)
			applyEnemyTrail(Enemy, 3)
			camShake(0.5, 0.4)
		end
	end,

	DioEye = function(Params)
		local Stage     = Params.Stage
		local Character = Params.char
		local Enemy     = Params.enemy

		local TweenService = game:GetService("TweenService")
		local Debris       = game:GetService("Debris")
