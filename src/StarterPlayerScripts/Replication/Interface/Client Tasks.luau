	turboskick = function(Params)
		local Character: Model = Params.Char
		local HumRP: BasePart = Character.HumanoidRootPart

		local AssetsFolder = Resources.Okarun.skick
		local Stage = Params.Stage


		if Stage == "Start" then
			local mainCF: CFrame = Params.CF


			if Params.Hit == false then
				local tpRay = raycast(mainCF.Position, mainCF.LookVector * 40, MapRayParams) or mainCF * CFrame.new(0, 0, -40)
				HumRP.CFrame = CFrame.lookAlong(tpRay.Position, mainCF.LookVector)
			end

			BodyPositionForwardVelocity(HumRP, 5.55, 0.3, { 1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out }, { P = 2500, D = 500 })


			local StompMesh2 = Resources.Misc.StompMesh2:Clone()
			StompMesh2.Parent = workspace.Thrown
			StompMesh2.Size = Vector3.new(25, 0, 25)
			StompMesh2.CFrame = HumRP.CFrame * CFrame.Angles(1.5707963267948966, 0, 0) * CFrame.new(0, 25, 0)
			StompMesh2.Transparency = 0.5

