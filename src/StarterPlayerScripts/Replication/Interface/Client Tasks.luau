local function CloneAndPlaceFX(data)
	local fx = data.FX
	local anchor = data.Anchor
	local clonedFX = fx:Clone()

	if clonedFX:IsA("Model") then
		clonedFX:PivotTo(anchor)
	elseif clonedFX:IsA("BasePart") then
		clonedFX.CFrame = anchor
	end

	if clonedFX:IsA("Attachment") then
		clonedFX.Parent = anchor
	else
		clonedFX.Parent = workspace.Thrown
	end

	game.Debris:AddItem(clonedFX, 30)
	return clonedFX
end

