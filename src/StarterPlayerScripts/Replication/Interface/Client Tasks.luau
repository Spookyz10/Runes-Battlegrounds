	HeianRush = function(Params)
		local Character = Params.char
		local HRP = Character.HumanoidRootPart
		local Humanoid = Character.Humanoid

		local TweenService = game:GetService("TweenService")
		local effectsFolder = workspace.Effects
		local Assets = Resources.Heian.Cleave

		local function WeldTo(a, b)
			local wc = Instance.new("Weld", a)
			wc.Part0 = a
			wc.Part1 = b
			return wc
		end

		-- [[ DGUI damage indicator ]]:
		local Rotation = math.random(-5, 5)
		local DamageIndicator = Assets.DGUI:Clone()
		DamageIndicator.CFrame = HRP.CFrame * CFrame.Angles(0, 0, math.rad(Rotation))
		DamageIndicator.Parent = effectsFolder
		Humanoid.AutoRotate = false

		TweenService:Create(DamageIndicator, TweenInfo.new(1, Enum.EasingStyle.Exponential), {
			CFrame = DamageIndicator.CFrame * CFrame.new(0, 0.36, 0)
		}):Play()
		task.delay(0.4, function()
			TweenService:Create(DamageIndicator.Chat.Chat1.Sub, TweenInfo.new(1), { TextTransparency = 1 }):Play()
			TweenService:Create(DamageIndicator.Chat.Chat1.Sub, TweenInfo.new(1), { TextStrokeTransparency = 1 }):Play()
		end)
		game.Debris:AddItem(DamageIndicator, 0.5)

		-- [[ Wait for animation track to reach Lunge marker ]]:
		local animTrack = nil
		for _, track in pairs(Humanoid.Animator:GetPlayingAnimationTracks()) do
			if track.Animation.AnimationId == Params.id then
				animTrack = track
				break
			end
		end

		-- [[ Lunge VFX ]]:
		local Cleave = Assets.Cleave:Clone()
		Cleave.Parent = effectsFolder
		WeldTo(Cleave, HRP)
		game.Debris:AddItem(Cleave, 4)

		local TPThing = Assets.tpthing:Clone()
		local TPThing2 = Assets.tpthing2:Clone()
		TPThing.Parent = HRP
		TPThing2.Parent = HRP

		local Wind = Assets.Part.Front:Clone()
		Wind.Parent = HRP

		-- [[ Stop VFX ]]:
		task.delay(Params.stopDelay or 1.5, function()
			TPThing.Enabled = false
			TPThing2.Enabled = false
			Cleave.Slashes.Enabled = false

			for _, particle in pairs(Wind:GetChildren()) do
				if particle:IsA("ParticleEmitter") then
					particle.Enabled = false
				end
			end

			game.Debris:AddItem(TPThing, 5)
			game.Debris:AddItem(TPThing2, 5)
			game.Debris:AddItem(Wind, 5)
		end)

		task.delay(2, function()
			Humanoid.AutoRotate = true
		end)
	end,

