	AngularKnockback = function(Params)
		local angle = Params.F
		local duration = Params.L
		local maxTorque = Params.M
		local humanoidRootPart = Params.R

		if typeof(angle) ~= "number" then
			angle = 90
		end
		if typeof(duration) ~= "number" then
			duration = 0.16
		end
		if typeof(maxTorque) ~= "number" then
			maxTorque = Vector3.new(1550, 400, 1550)
		end

		angle = math.abs(angle)
		local angleRange = {
			-angle, 
			angle
		}

		local angleX = angleRange[math.random(1, 2)]
		local angleY = angleRange[math.random(1, 2)]
		local angleZ = angleRange[math.random(1, 2)]

		local bodyAngularVelocity = Instance.new("BodyAngularVelocity")
		bodyAngularVelocity.MaxTorque = maxTorque
		bodyAngularVelocity.AngularVelocity = Vector3.new(angleX, angleY, angleZ)
		bodyAngularVelocity.Parent = humanoidRootPart

		if duration ~= math.huge then

			task.delay(duration, function()
				if bodyAngularVelocity ~= nil and bodyAngularVelocity.Parent ~= nil then
					bodyAngularVelocity:Destroy()
				end
			end)
		end
	end,

	Knockback = function(Params)
		local MaxForce = Params.MaxForce
		local Direction = Params.Direction
		local Lifetime = Params.Lifetime
		local DecelerationTime = Params.DecelerationTime

		local BodyVelocity = Instance.new("BodyVelocity")
		BodyVelocity.Name = Params.Name or "KnockbackVelocity"
		BodyVelocity.MaxForce = MaxForce
		BodyVelocity.Velocity = Direction
		BodyVelocity.Parent = Params.R

		if typeof(DecelerationTime) == "number" then
			local Vector3Value = Instance.new("Vector3Value")
			Vector3Value.Value = Direction
			Vector3Value.Parent = BodyVelocity

			task.spawn(function()
				while BodyVelocity ~= nil and BodyVelocity.Parent ~= nil and Vector3Value ~= nil and Vector3Value.Parent ~= nil do
					BodyVelocity.Velocity = Vector3Value.Value
					task.wait()
				end
			end)

			TS:Create(Vector3Value, TweenInfo.new(DecelerationTime, Enum.EasingStyle.Linear), {
				Value = Vector3.new(0, 0, 0, 0)
			}):Play()
		end

		if Lifetime ~= math.huge then

			task.delay(Lifetime, function()
				if BodyVelocity ~= nil and BodyVelocity.Parent ~= nil then
					BodyVelocity:Destroy()
				end
			end)
		end
	end,
	
