			if not state then return end

			if state.syncConn then state.syncConn:Disconnect() end
			if state.bodyMotor and state.bodyMotor.Parent then state.bodyMotor:Destroy() end
			if state.effectMotor and state.effectMotor.Parent then state.effectMotor:Destroy() end
			if state.gun and state.gun.Parent then state.gun:Destroy() end

			_G.RailgunState[character] = nil

			-- Reset FOV
