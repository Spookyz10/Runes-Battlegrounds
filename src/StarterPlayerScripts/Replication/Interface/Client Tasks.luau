	HuntersMark = function(Params)
		local Character = Params.Char
		local EnemyCharacter = Params.EChar

		local HumRP = Character.PrimaryPart


		local LocalChar = game.Players.LocalPlayer.Character
		local IsLocalChar = true

		if Character ~= LocalChar then
			IsLocalChar = EnemyCharacter == LocalChar
		end


		local Stage = Params.Stage
		local MoveModule = SideModules.VFX.VfxMods.FirstMoveRetrySend


		if Stage == "Start" then
			require(MoveModule).FirstEvent({ Char = Character, Victim = EnemyCharacter })

		elseif Stage == "Hit" then
			local Animation = nil
			local StartTick = tick()


			repeat
				task.wait()
				for _, Track in pairs(Character.Humanoid.Animator:GetPlayingAnimationTracks()) do
					if Track.Animation.AnimationId == "rbxassetid://" .. 89589201543196 then
						Animation = Track

						break
					end
				end

			until Animation or tick() - StartTick >= 0.25


			if IsLocalChar then
				if not Animation or not Animation.IsPlaying then return end

				task.delay(6.04, function()
					if not Animation or not Animation.IsPlaying or not Params.Bind.Parent then return end


					task.delay(2.2, function()
						shared.repfire("Camshake", { Intensity = 5 })
					end)

					task.delay(0.125, function()
						shared.repfire("Camshake", { Intensity = 1 })
					end)


					game:GetService("RunService"):UnbindFromRenderStep("BeastBreathingCamera")


					local CutsceneEvent
					CutsceneEvent = shared.CutsceneEvent({
						Anim = 91645160520873, 
						Offset = CFrame.new(0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1), 
						NoLerp = true, 
						From = HumRP, 
						SpecificRig = SideModules.VFX.Assets.fx_CAM, 
						ActualPart = "camera3", 
						Char = Character, 
						Subject = true, 
						CFrameRetain = true, 
						SpoofedCFrame = HumRP.CFrame, 
						EnableShakeAfter = 2.2, 
						EnableShakeAfter2 = 0.125, 
						ZaleTransition = true
					})

					--CutsceneEvent.Stopped:Once(function()
						--game:GetService("RunService"):UnbindFromRenderStep("BeastBreathingCamera")
					--end)
				end)
			end

			require(MoveModule).HitEvent({ Char = Character, Victim = EnemyCharacter, Bind = Params.Bind })
		end
	end,
	
