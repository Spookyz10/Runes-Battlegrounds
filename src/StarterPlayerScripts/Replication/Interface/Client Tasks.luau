	CharaSpawn = function(Params)
		local Character = Params.Char


		local AssetsFolder = Resources.Chara.Spawn
		local animationTrack = nil


		for _, playingTrack in pairs(Character.Humanoid.Animator:GetPlayingAnimationTracks()) do
			if playingTrack.Animation.AnimationId == Params.Anim then
				animationTrack = playingTrack
				break
			end
		end
		if not animationTrack then return end

		local Yuki_FOV = require(RS_Modules.Game.Yuki_FOV)
		local EffectUtility = require(RS_Modules.Game.EffectUtility)
		local ArcModule = EffectUtility.Arc
		
		local SpawnEvents = {}


		local LocalChar = LocalPlayer.Character == Character

		if LocalChar then
			local ColorCorrectionEffect = Instance.new("ColorCorrectionEffect")
			ColorCorrectionEffect.TintColor = Color3.fromRGB(91, 91, 91)
			ColorCorrectionEffect.Parent = Lighting

			TS:Create(ColorCorrectionEffect, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				TintColor = Color3.fromRGB(255, 255, 255)
			}):Play()
			
			if shared.addshake then
				shared.addshake(0.75, 12.5, 0.01, 0.4)
			end
			
			Yuki_FOV.Set(50)
			Yuki_FOV.Tween(70, {
				1, 
				Enum.EasingStyle.Sine, 
				Enum.EasingDirection.Out
			})
		end
		
		SoundsModule:AddSound(AssetsFolder.SFX, Character.Torso)

		ArcModule.CloneAndEmit(AssetsFolder.spawn, Character.HumanoidRootPart)

		SpawnEvents["point"] = animationTrack:GetMarkerReachedSignal("point"):Once(function()
			local Knife = Character:FindFirstChild("Knife")
			if Knife then
				ArcModule.CloneAndEmit(AssetsFolder.knife_point, Knife.BladeInner)

				if LocalChar then
					if shared.addshake then
						shared.addshake(0.5, 2, 0.01, 0.7)
					end
					
					Yuki_FOV.Set(65)
					Yuki_FOV.Tween(70, {
						0.5, 
						Enum.EasingStyle.Sine, 
						Enum.EasingDirection.Out
					})
				end
			end
		end)

		animationTrack.Stopped:Once(function()
			for _,v in SpawnEvents do
				v:Disconnect()
			end
		end)
	end,
	
	Onslaught = function(Params)
