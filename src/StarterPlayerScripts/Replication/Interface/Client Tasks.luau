									v27.Parent = HumRP
									EffectUtility.Emit(v27)
								end
								return
							end
						end)

						task.delay(0.3, function()
							Knife.Handle.BladeAttachment.Trail.Enabled = false
						end)
					end
				end
			end

		elseif Stage == "CustomSpecialSwings" then
			if Moveset == "Cursed Child" then
				local Knife = Target:FindFirstChild("Knife")
				if Knife == nil then
					return
				else
					if Params.Type == "Up" then
						Knife.Handle.BladeAttachment.Trail.Enabled = true
						task.delay(0.16666666666666666, function()
							EffectUtility.EmitEffects(AssetsFolder.Chara.Swing, HumRP)
						end)

