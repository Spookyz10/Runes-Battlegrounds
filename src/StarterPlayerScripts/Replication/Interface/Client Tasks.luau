	Vel = function(vars)
		local char = vars.char
		local plr = game.Players:GetPlayerFromCharacter(char)
		local humrp = char.HumanoidRootPart

		local stuff = {}

		if vars.create then
			local speed = vars.speed
			local maxforce = vars.maxforce
			local name = vars.name

			local Speed = Instance.new('NumberValue')
			Speed.Value = vars.speed
			Speed.Parent = humrp
			table.insert(stuff, Speed)

			local Velocity = Instance.new("BodyVelocity")
			Velocity.Name = name
			Velocity.MaxForce = maxforce
			Velocity.Parent = humrp
			table.insert(stuff, Velocity)
			if vars.connection then
				local connection
				connection = game["Run Service"].RenderStepped:Connect(function()
					if Velocity.Parent ~= nil then
						Velocity.Velocity = humrp.CFrame.LookVector * Speed.Value
					else
						connection:Disconnect()
					end
				end)
				table.insert(stuff, connection)
			end
		elseif vars.delete then
			warn('deleting')
			humrp:FindFirstChildWhichIsA('NumberValue'):Destroy()
			humrp:FindFirstChildWhichIsA('BodyVelocity'):Destroy()
		end
	end,

