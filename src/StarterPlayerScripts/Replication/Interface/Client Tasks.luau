	HeianFuga = function(Params)
		local Character = Params.char
		local HRP = Character.HumanoidRootPart
		local Humanoid = Character.Humanoid

		local TweenService = game:GetService("TweenService")
		local effectsFolder = workspace.Effects
		local Assets = Resources.Heian.FlameArrow

		local stage = Params.stage

		if stage == "Clap" then
			local ArmsEff = Assets.Hands:Clone()
			ArmsEff.LA.Weld.Part1 = Character["Left Arm"]
			ArmsEff.RA.Weld.Part1 = Character["Right Arm"]
			ArmsEff.Parent = Character

			local clone = Assets.Clap:Clone()
			clone.CFrame = HRP.CFrame
			game.Debris:AddItem(clone, 2)
			clone.Parent = Character
			for _, v in clone.C1:GetChildren() do
				v:Emit(v:GetAttribute("EmitCount"))
			end

			local Hands = Character:FindFirstChild("Hands")
			if Hands then
				for _, v in Hands.LA.startup:GetChildren() do v.Enabled = false end
				for _, v in Hands.RA.startup:GetChildren() do v.Enabled = false end
				for _, v in Hands.LA.fire:GetChildren() do v.Enabled = true end
				for _, v in Hands.RA.fire:GetChildren() do v.Enabled = true end
				for _, v in Hands.LA.Beam:GetChildren() do v.Enabled = true end
			end

		elseif stage == "Clap2" then
			local clone = Assets.Clap:Clone()
			clone.CFrame = HRP.CFrame
			game.Debris:AddItem(clone, 2)
			clone.Parent = Character
			for _, v in clone.C2:GetChildren() do
				v:Emit(v:GetAttribute("EmitCount"))
			end

		elseif stage == "Arrow" then
			local Hands = Character:FindFirstChild("Hands")
			if Hands then
				for _, v in Hands.LA.fire:GetChildren() do v.Enabled = false end
				for _, v in Hands.RA.fire:GetChildren() do v.Enabled = false end
				for _, v in Hands.LA.Beam:GetChildren() do v.Enabled = false end
			end

			local clone = Assets.Arrow:Clone()
