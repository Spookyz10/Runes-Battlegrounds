	RockTrail = function(Params)
		local parent = Params.parent
		local size = Params.size
		local side = Params.side
		local Lifetime = Params.t
		local spawnrate = Params.spawnrate
		local duration = Params.duration

		local HumRP = parent.Parent:FindFirstChild("HumanoidRootPart")
		local GroundColor, SmokeStep = nil
		local LastSmoke = tick()
		local FastMode = LocalPlayer:GetAttribute("Fast_Mode")
		local SmokeRate = FastMode and 0.05 or 0.025
		local SmokeQuantity = FastMode and 1 or 2

		if HumRP then
			SmokeStep = RNS.RenderStepped:Connect(function()
				if GroundColor and tick() - LastSmoke >= SmokeRate then
					LastSmoke = tick()

					local SmokeEmitter = HumRP.BottomPart.Smoke.Smoke:Clone()
					SmokeEmitter.Parent = HumRP.BottomPart.Smoke
					SmokeEmitter.Name = ""
					SmokeEmitter.Color = ColorSequence.new(GroundColor)
					SmokeEmitter:Emit(SmokeQuantity)
					Debris:AddItem(SmokeEmitter, 2)
				end
			end)
		end


		for i = 1, duration/spawnrate do
			local HumRP = parent.Parent:FindFirstChild('HumanoidRootPart')

			local function rocknew(finalSide)
				local GroundRay = raycast(parent.Position, Vector3.new(0, -Params.height, 0), MapRayParams)
				if GroundRay then
					GroundColor = GroundRay.Instance.Color

					local GoalSize = Vector3.new(1, 1, 1) * RandomSeed:NextNumber(size / 1.5, size * 1.5)
					local SizeMagnitude = GoalSize.Magnitude


					local Rock = Resources.Rocks.RockTrail.Part:Clone()
					Rock.CFrame = CFrame.lookAlong(GroundRay.Position, parent.CFrame.LookVector) * CFrame.new(RandomSeed:NextNumber(finalSide / 1.5, finalSide * 1.5), 0, RandomSeed:NextNumber(-SizeMagnitude / 2, SizeMagnitude / 2))
					Rock.Orientation = Vector3.new(math.random(-180, 180), math.random(-180, 180), math.random(-180, 180))
					Rock.Color = GroundRay.Instance.Color
					Rock.Material = GroundRay.Material
					Rock.Parent = workspace.Thrown
					Debris:AddItem(Rock, Lifetime + 0.5)


					TS:Create(Rock, TweenInfo.new(0.25), { Size = GoalSize }):Play()

					if SizeMagnitude >= 2 then
						miniDebris({ CFrame = CFrame.new(Rock.Position), Color = Rock.Color, Material = Rock.Material, MinimumRocks = 1, MaximumRocks = 3, MinimumVelocity = 14, MaximumVelocity = 28 })
					end


					task.delay(Lifetime, function()
						TS:Create(Rock, TweenInfo.new(0.5), { Size = Vector3.zero }):Play()
					end)

				else
					GroundColor = nil

				end
			end

			task.spawn(function()
				if side == 0 then
					rocknew(side)
				else
					rocknew(side)
					rocknew(-side)
				end
			end)

			task.wait(spawnrate)
		end

		if SmokeStep then
			SmokeStep:Disconnect()
		end
	end,

	flyLine = function(Info)
		if not Info.Multiplier then 
			Info.Multiplier = 1.2
		end

		for i = 1,Info.Length,Info.Step do
			flyRock({ Rocks = 1, CFrame = Info.CFrame + Vector3.new(Info.Separation,0,-i), BaseSize = Info.Size })
			flyRock({ Rocks = 1, CFrame = Info.CFrame + Vector3.new(-Info.Separation,0,-i), BaseSize = Info.Size })
			Info.Size += Info.Multiplier
		end
	end,

	rockCircle = function(ExtraInfo)
		if ExtraInfo.HardRagdollDetection == true then
			local Character: Model = ExtraInfo.Char
			if not Character or not Character.Parent then return end

			local HumRP: BasePart = Character:FindFirstChild('HumanoidRootPart')
			if not HumRP then return end


			local _, detectionRaye = shared.detectAir({ Char = Character,
				ragdoll = true,
				destroyables = ExtraInfo.destroyAmbient,
				precise = false,
				customClamp = 10.2
			})
			if not detectionRaye or not Character:HasTag('Ragdolled') or Character:FindFirstChild('RagdollCancel') then return end

			ExtraInfo['Raye'] = detectionRaye
			local Ragdoller = ExtraInfo['Ragdoller']
			if Ragdoller and Ragdoller == LocalCharacter then
				shared.addshake(6)
			end
		end

		ExtraInfo.RockMult = ExtraInfo.RockMult or 0
		ExtraInfo.RadiusMult = ExtraInfo.RadiusMult or 1
		ExtraInfo.Circles = ExtraInfo.Circles or 1

		local ParamsCF = typeof(ExtraInfo.CF) == "Instance" and ExtraInfo.CF.CFrame or ExtraInfo.CF
		local CF
		for i = 1, (ExtraInfo.Circles or 1) do
			local RadiusMult = ExtraInfo.RadiusMult
			local SizeMult = ExtraInfo.SizeMult or RadiusMult
			if i == 1 then
				RadiusMult = 1
				SizeMult = 1
			else
				RadiusMult *= i
				SizeMult *= i
			end


			if ExtraInfo.RayDir then
				ExtraInfo.RayDir = CFrame.lookAt(ParamsCF.Position, ExtraInfo.RayDir).LookVector * 10
			end


			local Raye: RaycastResult = ExtraInfo['Raye'] or raycast(ParamsCF.Position, ExtraInfo.RayDir or Vector3.new(0, -7.5, 0), MapRayParams)

			if Raye and Raye.Instance then
				local hitparts = workspace:GetPartBoundsInRadius(Raye.Position, ExtraInfo.Radius/2 * RadiusMult, MapOverlapParams)
				for _,v : BasePart in pairs(hitparts) do
					if v.Name == 'Tile' and math.random(1, 2) == 1 and v.Transparency == 0 then
						local TimeUntilDestroy = math.random(2,4)
						local TNTime = math.random(2.5, 5)

						local clone = v:Clone()
						clone.Size = Vector3.new(clone.Size.X, clone.Size.Y, clone.Size.Z/2)
						clone.Parent = workspace.Thrown
						clone.Anchored = false
						clone.CanQuery = false
						clone.CollisionGroup = 'NonPColDebri'

						local BodyVelocity = Instance.new("BodyVelocity")
						BodyVelocity.MaxForce = Vector3.new(75000, 75000, 75000)
						BodyVelocity.Velocity = CFrame.lookAt(clone.Position, Raye.Position).LookVector * Vector3.new(math.random(25, 50), 0, math.random(25, 50)) + Vector3.new(0, math.random(30, 60), 0)
						BodyVelocity.Parent = clone
						Debris:AddItem(BodyVelocity, 0.1)

						local BodyAngularVelocity = Instance.new("BodyAngularVelocity")
						BodyAngularVelocity.MaxTorque = Vector3.new(75000, 75000, 75000)
						BodyAngularVelocity.AngularVelocity = Vector3.new(math.random(8, 16), math.random(8, 16), math.random(8, 16))
						BodyAngularVelocity.Parent = clone
						Debris:AddItem(BodyAngularVelocity, 0.1)

						Debris:AddItem(clone, TimeUntilDestroy + TNTime)

						task.delay(TimeUntilDestroy,function()
							TS:Create(clone, TweenInfo.new(TNTime, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
							Debris:AddItem(clone, TNTime)

							task.wait(TNTime)

							TS:Create(v, TweenInfo.new(TNTime, Enum.EasingStyle.Linear), { Transparency = 0 }):Play()

							task.wait(TNTime)

							v.CanQuery = true
						end)

						v.Transparency = 1
						v.CanQuery = false
					end
				end	



				CF = CFrame.lookAlong(Raye.Position, -Raye.Normal) * CFrame.Angles(rad(90), rad(math.random(ExtraInfo['MinDistance'] or 0, ExtraInfo['XRNG2'] or 360)), 0) * CFrame.new(0, 1, 0)


				local Divider = 1
				if LocalConfigFolder["Fast Mode"].Value == true then
					Divider = 2
				end


				if ExtraInfo.smoke ~= false then
					local SmokeSize = ExtraInfo.Radius/5
					local smokefx = Resources.Rocks.rockCircle.Smoke:Clone()
					smokefx.Parent = workspace.Thrown
					smokefx.CFrame = CF
					for _,ParticleEmitter : ParticleEmitter in pairs(smokefx:GetDescendants()) do
						if ParticleEmitter:IsA('ParticleEmitter') then
							ParticleEmitter.Size = NumberSequence.new{ 
								NumberSequenceKeypoint.new(0, 4.69 * SmokeSize),
								NumberSequenceKeypoint.new(0.103, 4.89 * SmokeSize),
								NumberSequenceKeypoint.new(0.176, 5.05 * SmokeSize),
								NumberSequenceKeypoint.new(0.878, 4.03 * SmokeSize),
								NumberSequenceKeypoint.new(1, 2.31 * SmokeSize)
							}

							if ParticleEmitter.Name == 'Smoke' then
								ParticleEmitter.Speed = NumberRange.new(75 * SmokeSize, 100 * SmokeSize)
							else
								ParticleEmitter.Speed = NumberRange.new(25 * SmokeSize, 125 * SmokeSize)
							end


							ParticleEmitter:Emit(ParticleEmitter:GetAttribute('EmitCount') / Divider)
						end
					end
					Debris:AddItem(smokefx, 4)
				end



				if ExtraInfo.terrSmoke then
					local terrainSmokefx = Resources.Rocks.rockCircle.TerrainAtt.Attachment:Clone()
					terrainSmokefx.Parent = workspace.Terrain
					terrainSmokefx.CFrame = CF
					for _,ParticleEmitter : ParticleEmitter in pairs(terrainSmokefx:GetDescendants()) do
						if ParticleEmitter:IsA('ParticleEmitter') then
							ParticleEmitter:Emit(ParticleEmitter:GetAttribute('EmitCount') / Divider)
						end
					end
					Debris:AddItem(terrainSmokefx, 6.75)
				end

				local rng = Random.new()


				if ExtraInfo.flyRocks ~= false then
					local flyRocksNumber = math.random(ExtraInfo.Radius, ExtraInfo.Radius * 1.15)

					if flyRocksNumber > 10 then
						flyRocksNumber = 10
					end

					if LocalConfigFolder["Fast Mode"].Value == true then
						flyRocksNumber /= 2
					end

					for i = 1, flyRocksNumber do
						local lifeTime = RandomSeed:NextNumber(4, 6)
						local sizePack = math.random(ExtraInfo.Radius/6, ExtraInfo.Radius/3)
						local flyingDebris = Resources.Rocks.rockCircle.DefaultPart:Clone() do
							local velocity = RandomSeed:NextNumber(4,7)
							flyingDebris.CFrame = CF * CFrame.new(0,0.25,0)
							flyingDebris.Anchored = false
							flyingDebris.CollisionGroup = "NonPColDebri"
							flyingDebris.CanCollide = sizePack <= 5 and true or false
							flyingDebris.Material = Raye.Material
							flyingDebris.Color = Raye.Instance.Color
							flyingDebris.Size = Vector3.new(0.5, 0.5, 0.5) * sizePack
							flyingDebris.Parent = workspace.Terrain
							flyingDebris.AssemblyAngularVelocity = Vector3.new(RandomSeed:NextNumber(-25, 25), RandomSeed:NextNumber(-25, 25), RandomSeed:NextNumber(-25, 25))
							flyingDebris.AssemblyLinearVelocity = (CFrame.Angles(0, 2 * math.pi * i/flyRocksNumber + rad(RandomSeed:NextNumber(-25, 25)), 0) * CFrame.Angles(rad(RandomSeed:NextNumber(25, 30)), 0, 0)).UpVector * (velocity * ExtraInfo.Radius)
							Debris:AddItem(flyingDebris, lifeTime + 1)

							task.delay(lifeTime,function()
								TS:Create(flyingDebris,TweenInfo.new(1,Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),{Size = flyingDebris.Size/2,Transparency = 1}):Play()
							end)
						end
					end
				end



				local XRNG1 = (ExtraInfo['XRNG1'] or ExtraInfo.Radius/2) * SizeMult
				local XRNG2 = (ExtraInfo['XRNG2'] or ExtraInfo.Radius) * SizeMult

				local RNG1 = (ExtraInfo['RNG1'] or ExtraInfo.Radius/2) * SizeMult
				local RNG2 = (ExtraInfo['RNG2'] or ExtraInfo.Radius) * SizeMult

				local xSize = rng:NextNumber(XRNG1,XRNG2)

				local RockParts = ExtraInfo.Parts
				if i > 1 then
					RockParts += ExtraInfo.RockMult * i
				end

				for i = 1, RockParts do
					local depth = rng:NextNumber(RNG1,RNG2)
					local dRP = CF * CFrame.Angles(0,2*math.pi*i/RockParts,0) * CFrame.new(0,2,-ExtraInfo.Radius * RadiusMult)

					local debrisRay = raycast(dRP.Position, -dRP.UpVector * (depth * 2), MapRayParams)
					if debrisRay then
						local debrisPart = Resources.Rocks.rockCircle.DefaultPart:Clone()
						debrisPart.Size = Vector3.new(xSize, depth, depth)

						local customRocksInfo = ExtraInfo.customRocks
						if customRocksInfo then
							local Chances = customRocksInfo.Chance

							if math.random(Chances[1], Chances[2]) ~= 1 then
								debrisPart.Material = customRocksInfo.Material or debrisRay.Material
								debrisPart.Color = customRocksInfo.Color or debrisRay.Instance.Color
								debrisPart.Transparency = customRocksInfo.Transparency or 0

							else
								debrisPart.Material = debrisRay.Material
								debrisPart.Color = debrisRay.Instance.Color
								debrisPart.Transparency = 0

							end

						else
							debrisPart.Material = debrisRay.Material
							debrisPart.Color = debrisRay.Instance.Color
							debrisPart.Transparency = 0

						end

						debrisPart.CanCollide = true
						if ExtraInfo.NoCol == true then
							debrisPart.CollisionGroup = "NonPColDebri"
						else
							debrisPart.CollisionGroup = "Debris"
						end

						local underGroundCF = dRP.Rotation * CFrame.new(0,-debrisPart.Size.Y/2-0.25,0) + debrisRay.Position

						local tilted = rng:NextNumber(15, 45)
						if ExtraInfo['xAngle'] then
							tilted = rng:NextNumber(ExtraInfo['xAngle']/3, ExtraInfo['xAngle'])
						end
						if ExtraInfo['Reverse'] == true then
							tilted -= tilted * 2
						end


						local Lifetime = rng:NextNumber(4,5) + 1

						local originCF = underGroundCF * CFrame.new(0,1,0) * CFrame.Angles(math.rad((rng:NextNumber(15,45))),0,0) 
						debrisPart.CFrame = underGroundCF
						debrisPart.Parent = workspace.Thrown
						Debris:AddItem(debrisPart, Lifetime)



						if ExtraInfo["Parts"] == 3 and not ExtraInfo["RockMult"] then
							local Offset = CFrame.new(rng:NextNumber(-2, 2), 0, 0)
							local CloneUnderGroundCF = underGroundCF * Offset
							local CloneOriginCF = originCF * Offset

							local CloneDebris = debrisPart:Clone()
							CloneDebris.CFrame = CloneUnderGroundCF
							Debris:AddItem(CloneDebris, Lifetime)

							TS:Create(CloneDebris, TweenInfo.new(rng:NextNumber(0.025, 0.1), Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = originCF }):Play()

							task.delay(Lifetime - 1,function()
								TS:Create(CloneDebris, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { CFrame = CloneDebris.CFrame * CFrame.new(0, -(CloneDebris.Size.Y + CloneDebris.Size.Y/2), 0) }):Play()
							end)
						end


						TS:Create(debrisPart,TweenInfo.new(rng:NextNumber(0.025,0.1),Enum.EasingStyle.Sine, Enum.EasingDirection.Out),{CFrame = originCF}):Play()


						task.delay(Lifetime - 1,function()
							TS:Create(debrisPart,TweenInfo.new(1,Enum.EasingStyle.Sine, Enum.EasingDirection.In),{CFrame = debrisPart.CFrame * CFrame.new(0, -(debrisPart.Size.Y + debrisPart.Size.Y/2), 0)}):Play()
						end)
					end
				end
			end
		end

		if CF ~= nil then
			if ExtraInfo.customSound ~= nil then
				if typeof(ExtraInfo.customSound) == "table" then
					for _,v in ExtraInfo.customSound do
						SoundsModule:AddSound(v, CF.Position)
					end

				else
					SoundsModule:AddSound(ExtraInfo.customSound, CF.Position)

				end

			elseif ExtraInfo.Sound ~= false then
				local DebrisSound, soundNumber, isBigDebri = nil, nil, ExtraInfo.customSoundType == 'Big' or ExtraInfo.Radius >= 14

				local function check()
					if soundNumber > #DebrisSound:GetChildren() then
						soundNumber = 1
					end
				end

				local function generateRandomSoundNumber()
					return math.random(1, #DebrisSound:GetChildren())
				end

				if isBigDebri then
					DebrisSound = SoundAssets.BigDebris
					soundNumber = generateRandomSoundNumber()

					if soundNumber == lastBigRockSound then
						soundNumber += 1
					end

					check()

					lastBigRockSound = soundNumber
				else
					DebrisSound = SoundAssets.SmallDebris
					soundNumber = generateRandomSoundNumber()

					if soundNumber == lastSmallRockSound then
						soundNumber += 1
					end

					check()

					lastSmallRockSound = soundNumber
				end

				SoundsModule:AddSound(DebrisSound[tostring(soundNumber)], CF.Position)
			end
		end

	end,

	rockLine = function(Info)
		local SizeAdd = Info.SizeAdd
		local StartSize = Info.Size
		local Length = Info.Length
		local Step = Info.Step
		local CF = Info.CF
		local SeparationAdd = Info.SeparationAdd
		local GoalRocksCount = Info.RocksCount

		SizeAdd = SizeAdd or 0.25


		if Info.Smoke ~= false then
			local smokeRay = raycast(CF.Position, Vector3.new(0, -7.5, 0), MapRayParams)
			if smokeRay then
				local goalCF = CFrame.lookAlong(smokeRay.Position, CF.LookVector)

				local terrainSmokefx = Resources.Rocks.rockLine.TerrainAtt.Attachment:Clone()

				--ParticlesModule.resizeParticle({ terrainSmokefx }, StartSize)

				terrainSmokefx.Parent = workspace.Terrain
				terrainSmokefx.CFrame = CF * CFrame.Angles(math.rad(-90), 0, 0)
				ParticlesModule.Emit(terrainSmokefx)
			end
		end

		local Size = StartSize
		local GoalSeparation = Info.StartSeparation

		local RocksCount = 0

		local RockDelay = Info.RockDelay or 0.01

		for i = 0, Length, Length/GoalRocksCount do
			if RocksCount >= GoalRocksCount then break end

			local currCF = CF * CFrame.new(0, 0, -i)

			local Material, Color
			local InfoRaye = raycast(currCF.Position, Vector3.new(0, -7.5, 0), MapRayParams)
			if InfoRaye and InfoRaye.Instance then
				Material = InfoRaye.Instance.Material
				Color = InfoRaye.Instance.Color
			end

			if 2 % i == 0 then
				flyRock({ Rocks = 1, CFrame = currCF, BaseSize = Size/GoalRocksCount, Material = Material, Color = Color })
			end

			for ii = 1, 2 do
				GoalSeparation = -GoalSeparation

				local Raye = raycast((currCF * CFrame.new(GoalSeparation, 0, 0)).Position, Vector3.new(0, (-Size * 2) - 7.5, 0), MapRayParams)
				if Raye and Raye.Instance then
					local Position = Raye.Position
					local StartPosition = Position - Vector3.new(0, Size, 0)


					local Part = Instance.new("Part")
					Part.Anchored = true
					Part.CanCollide = true
					Part.CanTouch = false
					Part.CanQuery = false
					Part.Size = Vector3.new(Size, Size, Size)
					Part.CFrame = CFrame.new(StartPosition) * CFrame.Angles(rad(math.random(0, 360)), rad(math.random(0, 360)), rad(math.random(0, 360)))

					if Part.Size.Magnitude < 5 or Part.Size.Magnitude > 50 then
						Part.CollisionGroup = "NonPColDebri"
					else
						Part.CollisionGroup = "Debris"
					end

					Part.Parent = workspace.Thrown

					if Material and Color then
						Part.Material = Material
						Part.Color = Color
					end


					TS:Create(Part, TweenInfo.new(RockDelay, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = Position }):Play()

					local Lifetime = math.random(5, 10)
					task.delay(Lifetime, function()
						TS:Create(Part, TweenInfo.new(1, Enum.EasingStyle.Linear), { Position = StartPosition }):Play()
					end)

					Debris:AddItem(Part, Lifetime + 1)
				end
			end

			Size += SizeAdd
			GoalSeparation += (SeparationAdd or 0)
			RocksCount += 1

			task.wait(Info.RockDelay or 0.01)
		end
	end,
	
