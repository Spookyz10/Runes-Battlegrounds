		local Players      = game:GetService("Players")
		local LocalPlayer  = Players.LocalPlayer

		local Eye        = Resources["Dio"].Eye
		local EyeBeamFX  = Resources["Dio"].Eye.EyeBeam

		local hrpCF   = Params.hrpCF
		local enemyCF = Params.enemyCF

		local Head       = Character and Character:FindFirstChild("Head")
		local EnemyTorso = Enemy and (Enemy:FindFirstChild("Torso") or Enemy:FindFirstChild("UpperTorso"))

		local function emitAttachment(template, parent)
			if not template or not parent then return end
			local clone = template:Clone()
			clone.Parent = parent
			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 25)
				end
			end
			Debris:AddItem(clone, 1)
		end

		local function applyEyeBeam(char)
			local head = char:FindFirstChild("Head")
			if not head or not EyeBeamFX then return end

			local clone = EyeBeamFX:Clone()
			clone.Parent = char
			clone:PivotTo(head.CFrame)

			local weld      = Instance.new("WeldConstraint")
			weld.Part0      = head
			weld.Part1      = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart")
			weld.Parent     = head

			-- Fade beams in
			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("Beam") then
					local info = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
					TweenService:Create(v, info, { Width0 = 0.3, Width1 = 0.3 }):Play()
				end
			end

			-- Fade beams out after 0.15s
			task.delay(0.15, function()
				for _, v in ipairs(clone:GetDescendants()) do
