			Cylinder.Parent = workspace.Thrown
			Cylinder.CFrame = HumRP.CFrame

			TS:Create(Cylinder, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				Transparency = 1,
				Size = Vector3.new(50, 50, 150),
				CFrame = Cylinder.CFrame * CFrame.new(0, 0, -65) * CFrame.Angles(0, 0, 3.141592653589793)
			}):Play()

