					CFrame = Shock.CFrame * CFrame.new(0, Random.new():NextNumber(1, 15), 0) * CFrame.Angles(0, math.rad((Random.new():NextInteger(-360, 360))), 0), 
					Transparency = 1
				}):Play()

				Debris:AddItem(Shock, 1)
