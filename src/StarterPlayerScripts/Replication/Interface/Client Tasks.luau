			"rbxassetid://112530459419992", 
			"rbxassetid://98792828606875", 
			"rbxassetid://80534326100017", 
			"rbxassetid://18799643112"
		}

		task.spawn(function()
			local startTime = tick()
			local counter = 0
			local exitLoop = false
			local activeImpacts = {}

			task.spawn(function()
				while not exitLoop do
					for _, impactPart in pairs(activeImpacts) do
						impactPart:PivotTo(Character["Right Arm"].CFrame * CFrame.new(0, 0.1, 0) * CFrame.Angles(math.pi, math.rad(math.random(0, 360)), 0))
					end
					game:GetService("RunService").RenderStepped:Wait()
