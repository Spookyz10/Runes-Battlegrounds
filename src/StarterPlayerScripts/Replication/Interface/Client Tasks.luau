				LinearVelocity.MaxAxesForce = Vector3.new(90000, 0, 90000)
				LinearVelocity.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
				LinearVelocity.VectorVelocity = Vector3.new(0, 0, -140)
				LinearVelocity.Parent = HumRP

				LinearVelocity:GetPropertyChangedSignal("VectorVelocity"):Connect(function()
					if LinearVelocity.VectorVelocity.Magnitude <= 5 then
						LinearVelocity:Destroy()
					end
				end)

				TS:Create(LinearVelocity, TweenInfo.new(1.15, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), { VectorVelocity = Vector3.zero }):Play()

				Debris:AddItem(LinearVelocity, 1.15)
			end

		elseif Stage == "Hit" then
			local airWindVFX = AssetsFolder.AirWind:Clone()
			airWindVFX.CFrame = HumRP.CFrame * CFrame.new(0, 0, -1)
			airWindVFX.Parent = workspace.Thrown
			ParticlesModule.Emit(airWindVFX)
			Debris:AddItem(airWindVFX, 5)

			task.delay(0.24, function()
				local preImpactVFX = AssetsFolder.PreImpact:Clone()
				preImpactVFX.CFrame = HumRP.CFrame
				preImpactVFX.Parent = workspace.Thrown
				ParticlesModule.Emit(preImpactVFX)
				Debris:AddItem(preImpactVFX, 5)
			end)

			task.delay(0.3, function()
