			Weld.Part0 = HitModel.PrimaryPart
			Weld.Part1 = Character["Right Arm"]
			Weld.C0 = CFrame.new(0, -1, 0) * CFrame.Angles(math.pi, math.rad(math.random(0, 360)), 0)
			Weld.Parent = HitModel
			HitModel.Parent = ThrownFolder

			local Humanoid = Character:FindFirstChild("Humanoid")
			local LoopingSound = shared.sfx({
				SoundId = "rbxassetid://132921706153608", 
				Parent = LocalCharacter["Right Arm"], 
				Volume = 0.4, 
				Looped = true
			})
			LoopingSound:Play()

			while LocalCharacter and LocalCharacter.Parent and Humanoid.Health > 0 and LocalCharacter:GetAttribute("PurpleFinisher") do
				counter += 1
				if counter % 2 == 0 then
					task.spawn(function()
						local ImpactPart = Resources.Suiryu.DragonUppercut.Impact2:Clone()
						ImpactPart:PivotTo(Character["Right Arm"].CFrame * CFrame.new(0, 0.1, 0) * CFrame.Angles(math.pi, math.rad(math.random(0, 360)), 0))
						ImpactPart.Parent = ThrownFolder
						activeImpacts[ImpactPart] = ImpactPart

						RandomGenerator:NextNumber(3, 6)
						RandomGenerator:NextNumber(0.0075, 0.015)

						task.spawn(function()
							for i = 1, #TextureList, 2 do
								local textureId = TextureList[i]
								if textureId then
									ImpactPart.Decal.Texture = textureId
								end
								task.wait(0.01)
							end
							ImpactPart:Destroy()
							activeImpacts[ImpactPart] = nil
						end)

						local Mesh = ImpactPart.Mesh
						Mesh.Scale *= 0.06
						Mesh.Scale = Vector3.new(Mesh.Scale.X * 1.5, Mesh.Scale.Y * 0.5, Mesh.Scale.Z * 1.5)
