			if slashh then slashh:Destroy() end

			-- LastSlash VFX
			local LastSlash = BarrageAssets.LastSlash:Clone()
			LastSlash.Parent = workspace
			LastSlash.CFrame = HumRP.CFrame

			local w = Instance.new("ManualWeld", LastSlash)
			w.Part0 = HumRP
			w.Part1 = LastSlash
			w.C0 = CFrame.new(0, 0, -2) * CFrame.Angles(0, math.rad(-90), 0)

			task.delay(0.02, function() emitAll(LastSlash) end)
			Debris:AddItem(LastSlash, 2.5)

			if isInvolved then
				shared.repfire("ShakeCamera", { Magnitude = 18, Roughness = 20, FadeInTime = 0, FadeOutTime = 0.7 })

				game.Lighting.Blur.Size = 20
				TS:Create(game.Lighting.Blur, TweenInfo.new(0.5), { Size = 0 }):Play()

				TS:Create(CurrentCamera, TweenInfo.new(0.08), { FieldOfView = 95 }):Play()
				task.delay(0.08, function()
					TS:Create(CurrentCamera, TweenInfo.new(0.5), { FieldOfView = 70 }):Play()
				end)
			end


			-- // STAGE: "last_hit" — Last slash blood \\ --

		elseif Stage == "last_hit" then
			local Victim: Model = Params.Victim
			local VictimHumRP = Victim and Victim:FindFirstChild("HumanoidRootPart")

			if VictimHumRP then
				local blood = BarrageAssets.HitBlood.Blood:Clone()
				blood.Parent = VictimHumRP
				task.delay(0.02, function() emitAll(blood) end)
				Debris:AddItem(blood, 2)
			end

			if isInvolved then
				shared.repfire("ShakeCamera", { Magnitude = 14, Roughness = 18, FadeInTime = 0, FadeOutTime = 0.5 })
			end


			-- // STAGE: "destroy_arms" — Destroy arm VFX parts \\ --

		elseif Stage == "destroy_arms" then
			local ra = Character:FindFirstChild("SlashBarrage_RA_" .. Character.Name, true)
			local la = Character:FindFirstChild("SlashBarrage_LA_" .. Character.Name, true)
			if ra then ra:Destroy() end
			if la then la:Destroy() end


			-- // STAGE: "idk_fx" — Spawn idk on left arm \\ --

		elseif Stage == "idk_fx" then
			local leftArm = Character:FindFirstChild("Left Arm")
			if not leftArm then return end

			local idk = BarrageAssets.idk:Clone()
			idk.Parent = leftArm
			idk.CFrame = leftArm.CFrame
			Debris:AddItem(idk, 1.75)

			local w = Instance.new("ManualWeld", idk)
			w.Part0 = leftArm
			w.Part1 = idk
			w.C0 = CFrame.new(0, 0, 0)

			idk.Name = "SlashBarrage_idk_" .. Character.Name


			-- // STAGE: "idk_fade" — Fade out idk \\ --

		elseif Stage == "idk_fade" then
			local idk = Character:FindFirstChild("SlashBarrage_idk_" .. Character.Name, true)
			if not idk then return end

			for _, particle in idk:GetDescendants() do
				if particle:IsA("BasePart") then
					TS:Create(particle, TweenInfo.new(0.4), { Transparency = 1 }):Play()
				end
			end

		end
	end,

-- Client-side replication handler for Judgement Cut End
-- ["JudgementCutEnd"] = function(Params) ... end

JudgementCutEnd = function(Params)
	local Character: Model = Params.Char
	local Humanoid: Humanoid = Character.Humanoid
	local HumRP: BasePart = Character.HumanoidRootPart

	local Stage = Params.Stage

	local JCEAssets = RS.Resources.Vergil["Judgement Cut End"]

	local isAttacker = LocalPlayer == Players:GetPlayerFromCharacter(Character)
	local isVictim   = Params.Victim and LocalPlayer == Players:GetPlayerFromCharacter(Params.Victim)
	local isInvolved = isAttacker or isVictim

	local function emitAll(parent)
		if not parent then return end
		for _, v in parent:GetDescendants() do
			if v:IsA("ParticleEmitter") then
				v:Emit(v:GetAttribute("EmitCount") or 1)
			end
		end
	end

	local function setTimeScale(parent, scale)
		if not parent then return end
		for _, v in parent:GetDescendants() do
			if v:IsA("ParticleEmitter") then
				v.TimeScale = scale
			end
		end
	end

	local function weldTo(part, target, c0)
		local w = Instance.new("ManualWeld", part)
		w.Part0 = target
		w.Part1 = part
		w.C0 = c0 or CFrame.new()
		return w
	end


	-- // STAGE: "pa" — Charge phase; arm VFX + Start VFX + sound \\ --

	if Stage == "pa" then
		local rightArm = Character:FindFirstChild("Right Arm")
		local leftArm  = Character:FindFirstChild("Left Arm")
		if not rightArm or not leftArm then return end

		-- Arm VFX
		local RA = JCEAssets["Right Arm"]:Clone()
		RA.Parent = rightArm
		RA.CFrame = rightArm.CFrame
		weldTo(RA, rightArm)
		RA.Name = "JCE_RA_" .. Character.Name

		local LA = JCEAssets["Left Arm"]:Clone()
		LA.Parent = leftArm
		LA.CFrame = leftArm.CFrame
		weldTo(LA, leftArm)
		LA.Name = "JCE_LA_" .. Character.Name

		-- Start VFX — continuous particles, parented to HRP area
		local Start = JCEAssets.Start:Clone()
		Start.Parent = workspace
		Start.CFrame = HumRP.CFrame * CFrame.new(0, -3, 0) * CFrame.Angles(0, 0, math.rad(90))

		local startWeld = Instance.new("ManualWeld", Start)
		startWeld.Part0 = Start
		startWeld.Part1 = HumRP
		startWeld.C0 = Start.CFrame:ToObjectSpace(HumRP.CFrame)

		for _, part in Start:GetDescendants() do
			if part:IsA("ParticleEmitter") then
				part.Enabled = true
			end
		end

		Start.Name = "JCE_Start_" .. Character.Name

		if isAttacker then
			TS:Create(CurrentCamera, TweenInfo.new(0.2), { FieldOfView = 75 }):Play()
			task.delay(0.2, function()
				TS:Create(CurrentCamera, TweenInfo.new(0.5), { FieldOfView = 70 }):Play()
			end)
		end


	-- // STAGE: "slash_fx" — Slash hits; Dash + Smoke + Slash VFX + Camera + desaturate \\ --

	elseif Stage == "slash_fx" then

		-- Destroy Start VFX
		local startFX = workspace:FindFirstChild("JCE_Start_" .. Character.Name)
		if startFX then startFX:Destroy() end

		-- Dash VFX
		local Dash = JCEAssets.Dash:Clone()
		Dash.Parent = workspace
		Dash.CFrame = HumRP.CFrame * CFrame.Angles(0, 0, math.rad(90))
		task.delay(0.02, function() emitAll(Dash) end)
		Debris:AddItem(Dash, 3)

		-- Smoke VFX — freeze timescale after 0.2s
		local Smoke = JCEAssets.Smoke:Clone()
		Smoke.Parent = workspace
		Smoke.CFrame = HumRP.CFrame * CFrame.new(0, -3, 0) * CFrame.Angles(0, 0, math.rad(90))
		task.delay(0.02, function() emitAll(Smoke) end)
		Smoke.Name = "JCE_Smoke_" .. Character.Name
		Debris:AddItem(Smoke, 3.5)
		task.delay(0.2, function()
			setTimeScale(Smoke, 0)
		end)

		-- Slash VFX — freeze timescale immediately after emit
		local Slash = JCEAssets.Slash:Clone()
		Slash.Parent = workspace
		Slash.CFrame = HumRP.CFrame * CFrame.new(0, -3, 0) * CFrame.Angles(0, 0, math.rad(90))
		task.delay(0.02, function()
			emitAll(Slash)
			setTimeScale(Slash, 0)
		end)
		Slash.Name = "JCE_Slash_" .. Character.Name
		Debris:AddItem(Slash, 3.5)

		-- Camera effect for attacker
		if isAttacker then
			shared.repfire("ShakeCamera", { Magnitude = 20, Roughness = 22, FadeInTime = 0, FadeOutTime = 1 })
			TS:Create(CurrentCamera, TweenInfo.new(0.1), { FieldOfView = 95 }):Play()
			task.delay(0.1, function()
				TS:Create(CurrentCamera, TweenInfo.new(0.6), { FieldOfView = 70 }):Play()
			end)

			-- Desaturate
			TS:Create(game.Lighting.ColorCorrection, TweenInfo.new(1), { Saturation = -2 }):Play()
		end


	-- // STAGE: "hit_damage" — 2.75s stun done; blood VFX \\ --

	elseif Stage == "hit_damage" then
		local Victim: Model = Params.Victim
		local VictimHumRP = Victim and Victim:FindFirstChild("HumanoidRootPart")

		if VictimHumRP then
			local blood = JCEAssets.HitBlood.Blood:Clone()
			blood.Parent = VictimHumRP
			task.delay(0.02, function() emitAll(blood) end)
			Debris:AddItem(blood, 2)
		end

		if isInvolved then
			shared.repfire("ShakeCamera", { Magnitude = 25, Roughness = 25, FadeInTime = 0, FadeOutTime = 1.5 })
			game.Lighting.Blur.Size = 30
			TS:Create(game.Lighting.Blur, TweenInfo.new(0.6), { Size = 0 }):Play()
		end


	-- // STAGE: "reappear" — Character reappears; Floor VFX \\ --

	elseif Stage == "reappear" then

		-- Floor VFX — freeze after 0.1s, restore after 1.7s
		local Floor = JCEAssets.Floor:Clone()
		Floor.Parent = workspace
		Floor.CFrame = HumRP.CFrame * CFrame.new(0, -3, 0)
		task.delay(0.02, function() emitAll(Floor) end)
		Debris:AddItem(Floor, 4)

		task.delay(0.1, function()
			setTimeScale(Floor, 0)
		end)
		task.delay(1.7, function()
			setTimeScale(Floor, 1)
		end)

		if isAttacker then
			shared.repfire("ShakeCamera", { Magnitude = 8, Roughness = 14, FadeInTime = 0, FadeOutTime = 0.5 })
		end


	-- // STAGE: "boom" — Explosion; restore Smoke+Slash timescales + Boom + idk + destroy arms \\ --

	elseif Stage == "boom" then

		-- Restore Smoke + Slash timescales
		local Smoke = workspace:FindFirstChild("JCE_Smoke_" .. Character.Name)
		local Slash = workspace:FindFirstChild("JCE_Slash_" .. Character.Name)
		if Smoke then setTimeScale(Smoke, 1) end
		if Slash then setTimeScale(Slash, 1) end

		-- Destroy arm VFX
		local ra = Character:FindFirstChild("JCE_RA_" .. Character.Name, true)
		local la = Character:FindFirstChild("JCE_LA_" .. Character.Name, true)
		if ra then ra:Destroy() end
		if la then la:Destroy() end

		-- Boom VFX
		local boom = JCEAssets.Boom:Clone()
		boom.Parent = workspace
		boom.CFrame = HumRP.CFrame
		task.delay(0.02, function() emitAll(boom) end)
		Debris:AddItem(boom, 4)

		-- idk on left arm
		local leftArm = Character:FindFirstChild("Left Arm")
		if leftArm then
			local idk = JCEAssets.idk:Clone()
			idk.Parent = leftArm
			idk.CFrame = leftArm.CFrame
			Debris:AddItem(idk, 1.5)
			weldTo(idk, leftArm)
			idk.Name = "JCE_idk_" .. Character.Name
		end

		-- Restore saturation
		if isAttacker then
			TS:Create(game.Lighting.ColorCorrection, TweenInfo.new(0), { Saturation = 0.2 }):Play()

			shared.repfire("ShakeCamera", { Magnitude = 22, Roughness = 24, FadeInTime = 0, FadeOutTime = 1.5 })
			game.Lighting.Blur.Size = 35
			TS:Create(game.Lighting.Blur, TweenInfo.new(0.7), { Size = 0 }):Play()
			TS:Create(CurrentCamera, TweenInfo.new(0.08), { FieldOfView = 98 }):Play()
			task.delay(0.08, function()
				TS:Create(CurrentCamera, TweenInfo.new(0.6), { FieldOfView = 70 }):Play()
			end)
		end


	-- // STAGE: "idk_fade" — Fade out idk \\ --

	elseif Stage == "idk_fade" then
		local idk = Character:FindFirstChild("JCE_idk_" .. Character.Name, true)
		if not idk then return end

		for _, particle in idk:GetDescendants() do
			if particle:IsA("BasePart") then
				TS:Create(particle, TweenInfo.new(0.4), { Transparency = 1 }):Play()
			end
		end

	end
end,

