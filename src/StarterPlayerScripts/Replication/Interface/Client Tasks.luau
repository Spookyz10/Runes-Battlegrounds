				shared.addshake(5, 1)
			end


			local SlideCut = AssetsFolder.SlideCut:Clone()
			SlideCut.CFrame = HumRP.CFrame
			SlideCut.Parent = workspace.Thrown
			ParticlesModule.Emit(SlideCut)
			Debris:AddItem(SlideCut, 3)

		elseif Stage == "StartupImpact" then
			local StartUpImpact = AssetsFolder.StartUpImpact:Clone()
			StartUpImpact.Parent = Character
			StartUpImpact.Weld.Part0 = Character["Right Arm"]
			Debris:AddItem(StartUpImpact, 0.8)

		elseif Stage == "FinisherImpact" then
