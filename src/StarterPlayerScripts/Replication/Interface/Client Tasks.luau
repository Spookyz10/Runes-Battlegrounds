	FlashBulletFlashBullet = function(Params)
		local Character = Params.char
		local HRP = Character.HumanoidRootPart
		local stage = Params.stage

		local TweenService = game:GetService("TweenService")
		local Debris = game:GetService("Debris")
		local LocalPlayer = game:GetService("Players").LocalPlayer
		local isOwner = LocalPlayer.Character == Character

		local Assets = Resources.FlashBullet.FlashBullet

		if stage == "Startup" then
			-- nothing client side

		elseif stage == "Start" then
			local EnemyCharacter = Params.enemy

			-- [[ ArmTrails ]]:
			local function spawnArmTrail(armName, duration)
				local arm = Character:FindFirstChild(armName)
				if not arm then return end
				local trail = Assets.ArmTrail:Clone()
				trail.Parent = workspace.Effects
				local w = Instance.new("ManualWeld", trail)
				w.Part0 = arm; w.Part1 = trail
				w.C0 = CFrame.new(0, 0, 0)
				for _, v in pairs(trail:GetDescendants()) do
					if v:IsA("ParticleEmitter") or v:IsA("Beam") then v.Enabled = true end
				end
				Debris:AddItem(trail, duration)
			end
			spawnArmTrail("Right Arm", 1.9)
			spawnArmTrail("Left Arm", 1.9)

			-- [[ Owner-only cutscene cam ]]:
			if isOwner then
				task.spawn(function()
					local Camera = workspace.CurrentCamera

					local CamBlock = Assets.Cam:Clone()
					CamBlock.Parent = workspace.Visuals
					CamBlock.RootPart.CFrame = HRP.CFrame
					Debris:AddItem(CamBlock, 14.5)

					local CamAnim = CamBlock:FindFirstChildOfClass("Animation")
					if CamAnim then
						CamBlock.Humanoid:LoadAnimation(CamAnim):Play()
					end

					Camera.CameraType = Enum.CameraType.Scriptable
					local cameraPart = CamBlock:FindFirstChild("CamPart")
					if not cameraPart then return end

					Camera.FieldOfView = 70
					TweenService:Create(Camera, TweenInfo.new(0.5, Enum.EasingStyle.Linear), { FieldOfView = 45 }):Play()

					local posOffset = CFrame.new(0, -2, 0)
					local startTime = tick()
					while tick() - startTime < 14.5 do
						if cameraPart and cameraPart.Parent then
							Camera.CFrame = cameraPart.CFrame * posOffset
						end
						task.wait()
					end

					TweenService:Create(Camera, TweenInfo.new(1, Enum.EasingStyle.Linear), { FieldOfView = 70 }):Play()
					task.wait(1)
					Camera.CameraType = Enum.CameraType.Custom
					if CamBlock and CamBlock.Parent then CamBlock:Destroy() end
				end)
			end

			-- [[ Landed VFX at 6.5s ]]:
			task.delay(6.5, function()
				local landed = Assets.Landed:Clone()
				landed.Parent = workspace.Effects
				local w = Instance.new("ManualWeld", landed)
				w.Part0 = HRP; w.Part1 = landed
				w.C0 = CFrame.new(0, 0, 0)
				for _, v in pairs(landed:GetDescendants()) do
					if v:IsA("ParticleEmitter") then v:Emit(v:GetAttribute("EmitCount") or 30) end
				end
				Debris:AddItem(landed, 25)
			end)

			-- [[ OldSpeedlines at 8.37s ]]:
			task.delay(8.37, function()
				local speedlines = Assets.OldSpeedlines:Clone()
				speedlines.Parent = workspace.Effects
				local w = Instance.new("ManualWeld", speedlines)
				w.Part0 = HRP; w.Part1 = speedlines
				w.C0 = CFrame.new(0, 0, 0)
				for _, v in pairs(speedlines:GetDescendants()) do
					if v:IsA("ParticleEmitter") or v:IsA("Beam") then v.Enabled = true end
				end
				task.delay(0.37, function()
					for _, v in pairs(speedlines:GetDescendants()) do
						if v:IsA("ParticleEmitter") or v:IsA("Beam") then v.Enabled = false end
					end
					Debris:AddItem(speedlines, 4)
				end)
			end)

		elseif stage == "Barrage1" then
			local torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
			if torso then
				local barrage = Assets.Barrage1:Clone()
				barrage.Parent = workspace.Effects
				local w = Instance.new("ManualWeld", barrage)
				w.Part0 = torso; w.Part1 = barrage
				w.C0 = CFrame.new(0, 0, 0)
				for _, v in pairs(barrage:GetDescendants()) do
					if v:IsA("ParticleEmitter") or v:IsA("Beam") then v.Enabled = true end
				end
				task.delay(3.6, function()
					for _, v in pairs(barrage:GetDescendants()) do
						if v:IsA("ParticleEmitter") or v:IsA("Beam") then v.Enabled = false end
					end
					Debris:AddItem(barrage, 1)
				end)
			end

		elseif stage == "Barrage2" then
			local torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
			if torso then
				local barrage = Assets.Barrage:Clone()
				barrage.Parent = workspace.Effects
				if barrage.PrimaryPart then
					barrage:SetPrimaryPartCFrame(torso.CFrame * CFrame.Angles(0, math.rad(180), 0))
					local w = Instance.new("ManualWeld", barrage.PrimaryPart)
					w.Part0 = torso; w.Part1 = barrage.PrimaryPart
					w.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(180), 0)
				end
				for _, v in pairs(barrage:GetDescendants()) do
					if v:IsA("ParticleEmitter") or v:IsA("Beam") then v.Enabled = true end
				end
				task.delay(2, function()
					for _, v in pairs(barrage:GetDescendants()) do
						if v:IsA("ParticleEmitter") or v:IsA("Beam") then v.Enabled = false end
					end
