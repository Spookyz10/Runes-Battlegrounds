-- Client-side replication handler for Void Slash
-- ["VoidSlash"] = function(Params) ... end

VoidSlash = function(Params)
	local Character: Model = Params.Char
	local Humanoid: Humanoid = Character.Humanoid
	local HumRP: BasePart = Character.HumanoidRootPart

	local Stage = Params.Stage

	local VergilAssets = RS:FindFirstChild("Resources") and RS.Resources:FindFirstChild("Vergil") or RS:FindFirstChild("Vergil")
	local VoidAssets = VergilAssets and VergilAssets["Void Slash"]
	if not VoidAssets then warn("[VoidSlash Client] Could not find Void Slash assets. Path checked: RS.Resources.Vergil and RS.Vergil") return end

	local isAttacker = LocalPlayer == Players:GetPlayerFromCharacter(Character)
	local isVictim   = Params.Victim and LocalPlayer == Players:GetPlayerFromCharacter(Params.Victim)
	local isInvolved = isAttacker or isVictim

	local function emitAll(parent)
		if not parent then return end
		for _, v in parent:GetDescendants() do
			if v:IsA("ParticleEmitter") then
				v:Emit(v:GetAttribute("EmitCount") or 1)
			end
		end
	end

	local function weldTo(part, target)
		local w = Instance.new("ManualWeld", part)
		w.Part0 = target
		w.Part1 = part
		w.C0 = CFrame.new(0, 0, 0)
		return w
	end


	-- =====================================================================
	-- STAGE: "pa" — Animation started; begin arm VFX sequence + sound
	-- =====================================================================

	if Stage == "pa" then

		local MissTrack = nil
		for _, t in pairs(Humanoid.Animator:GetPlayingAnimationTracks()) do
			if t.Animation.AnimationId == Params.Animation then
				MissTrack = t
				break
			end
		end
		if not MissTrack then return end

		-- Arm VFX timed sequence (runs independently)
		task.spawn(function()
			local rightArm = Character:FindFirstChild("Right Arm")
			local leftArm  = Character:FindFirstChild("Left Arm")
			if not rightArm or not leftArm then return end

			-- Phase 1: Right Arm + Left Arm (0.35s)
			local RA = VoidAssets["Right Arm"]:Clone()
			RA.Parent = rightArm
			RA.CFrame = rightArm.CFrame
			weldTo(RA, rightArm)

			local LA = VoidAssets["Left Arm"]:Clone()
			LA.Parent = leftArm
			LA.CFrame = leftArm.CFrame
			weldTo(LA, leftArm)

			task.wait(0.35)
			RA:Destroy()

			-- Phase 2: Right Armm (1.5s)
