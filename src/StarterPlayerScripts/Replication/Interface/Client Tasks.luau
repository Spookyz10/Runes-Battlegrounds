					v13.CFrame = v13.CFrame * CFrame.Angles(0, 0, 0.9599310885968813)
					v13.Parent = HumRP
					EffectUtility.Emit(v13)

					if Distance < 15 then
						shared.addshake(1, 10, 0.075, 0.15)
					end
				end
			end

		elseif Stage == "CustomSwings" then
			if Moveset == "Cursed Child" then
				if CurrenCombo == 2 or CurrenCombo == 4 then
					local Knife = Target:FindFirstChild("Knife")
					if Knife == nil then
						return
					else
