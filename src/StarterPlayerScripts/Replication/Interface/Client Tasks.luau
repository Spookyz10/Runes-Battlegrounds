	Beatdown = function(Params)
		local stage = Params.Stage
		local character = Params.Char
		local victimPlayer = Params.Victim -- this is a Player instance, not a character
		local id = Params.HitAnim

		local TweenService = game:GetService("TweenService")
		local Debris = game:GetService("Debris")
		local Players = game:GetService("Players")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")

		-- Safely get victim character from player
		local victim = victimPlayer and victimPlayer.Character or nil

		if stage == "Start" then
			-- No VFX needed for startup, anim plays server side
			return
		end

		if stage == "Hit" then
			if not character then return end
			local HumRP = character:FindFirstChildOfClass("Humanoid") and character:FindFirstChildOfClass("Humanoid").RootPart
			if not HumRP then return end

			local isInvolved = Players.LocalPlayer.Character == character
				or Players.LocalPlayer.Character == victim

			local Anim = nil
			if id then
				for _, v in character:FindFirstChildOfClass("Humanoid"):FindFirstChildOfClass("Animator"):GetPlayingAnimationTracks() do
					if v.Animation.AnimationId == id then
						Anim = v
						break
					end
				end
			end
			if Anim == nil then return end

			Anim:GetMarkerReachedSignal("Damage"):Connect(function()
				if isInvolved then
					local Camera = workspace.CurrentCamera
					TweenService:Create(Camera, TweenInfo.new(0.05), { FieldOfView = 65 }):Play()
					task.delay(0.1, function()
						TweenService:Create(Camera, TweenInfo.new(0.15), { FieldOfView = 70 }):Play()
					end)
				end
			end)

			Anim:GetMarkerReachedSignal("End"):Once(function()
				if isInvolved then
					local Camera = workspace.CurrentCamera
					TweenService:Create(Camera, TweenInfo.new(0.05), { FieldOfView = 80 }):Play()
					task.delay(0.2, function()
						TweenService:Create(Camera, TweenInfo.new(0.3), { FieldOfView = 70 }):Play()
					end)
				end
			end)
		end
	end,

	DivergentFist = function(Params)
		local stage = Params.Stage
		local character = Params.Char
		local victimPlayer = Params.Victim
		local animId = Params.AnimId

		local TweenService = game:GetService("TweenService")
		local Debris = game:GetService("Debris")
		local Lighting = game:GetService("Lighting")
		local Players = game:GetService("Players")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")

		local victim = victimPlayer and victimPlayer.Character or nil
		local Assets = ReplicatedStorage.Resources.Yuji.BlackFlash
		local isInvolved = Players.LocalPlayer.Character == character
			or Players.LocalPlayer.Character == victim

		local function ColorFlash()
			local cc = Instance.new("ColorCorrectionEffect")
			cc.Saturation = -1
			cc.Contrast = -3
			cc.Parent = Lighting
			task.delay(0.1, function()
				cc.Saturation = -1
				cc.Contrast = 3
				task.wait(0.02)
				cc:Destroy()
			end)
		end

		if stage == "Start" then
			if not character then return end
			local HumRP = character:FindFirstChild("HumanoidRootPart")
			if not HumRP then return end

			-- Limb trail on right arm
			local RightArm = character:FindFirstChild("Right Arm")
			if RightArm then
				local trail = Assets.DivergentFistLimbTrail:Clone()
				trail.Parent = RightArm
				trail.CFrame = RightArm.CFrame

				local weld = Instance.new("ManualWeld", trail)
				weld.Part0 = RightArm
				weld.Part1 = trail
				weld.C0 = CFrame.new(0, 0, 0)

				-- Remove trail when anim ends
				if animId then
					local Anim = nil
					for _, v in character:FindFirstChildOfClass("Humanoid"):FindFirstChildOfClass("Animator"):GetPlayingAnimationTracks() do
						if v.Animation.AnimationId == animId then Anim = v; break end
					end
					if Anim then
						Anim.Stopped:Once(function() trail:Destroy() end)
					else
						Debris:AddItem(trail, 1)
					end
				end
			end

		elseif stage == "Miss" then
			if not character then return end
			local HumRP = character:FindFirstChild("HumanoidRootPart")
			if not HumRP then return end

			local miss = Assets.DivergentFistMiss:Clone()
			miss.Parent = workspace.Effects
			miss.CFrame = HumRP.CFrame * CFrame.new(0, -0.5, 0)
			for _, v in miss:GetDescendants() do
				if v:IsA("ParticleEmitter") then v:Emit(v:GetAttribute("EmitCount") or 10) end
			end
			Debris:AddItem(miss, 10)

		elseif stage == "Hit" then
			if not character then return end
			local HumRP = character:FindFirstChild("HumanoidRootPart")
			if not HumRP then return end

			if isInvolved then ColorFlash() end

			local hit = Assets.DivergentFistHit:Clone()
			hit.Parent = workspace.Effects
			hit.CFrame = HumRP.CFrame * CFrame.new(0, -0.5, 0)
			for _, v in hit:GetDescendants() do
				if v:IsA("ParticleEmitter") then v:Emit(v:GetAttribute("EmitCount") or 10) end
			end
			Debris:AddItem(hit, 10)

		elseif stage == "Finisher" then
			if not character then return end
			local HumRP = character:FindFirstChild("HumanoidRootPart")
			if not HumRP then return end

			if isInvolved then ColorFlash() end

			local kokusenn = Assets.Kokusenn:Clone()
			kokusenn.Parent = workspace.Effects
			kokusenn.CFrame = HumRP.CFrame * CFrame.new(0, -0.5, 0)
			for _, v in kokusenn:GetDescendants() do
				if v:IsA("ParticleEmitter") then v:Emit(v:GetAttribute("EmitCount") or 10) end
			end
			Debris:AddItem(kokusenn, 10)
		end
	end,

