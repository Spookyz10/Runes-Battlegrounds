local function animateThrownObject(rootPart, animationKey, playbackSpeed, objectTemplate)
	local speed = playbackSpeed or 1
	local animationData = kickAnimation[animationKey]
	local thrownObject = objectTemplate:Clone()

	thrownObject.Parent = workspace.Thrown
	thrownObject:WaitForChild("Weld").Part0 = rootPart:WaitForChild("HumanoidRootPart")
	thrownObject.Decal.Transparency = 1
	thrownObject.Weld.C0 = animationData.CF[1].Value

	for index, frameData in pairs(animationData.CF) do
		local duration = frameData.Time - (animationData.CF[index - 1] and animationData.CF[index - 1].Time or 0)
		local delayTime = animationData.CF[index - 1] and animationData.CF[index - 1].Time or 0

		task.delay(delayTime / speed, function()
			TS:Create(thrownObject.Weld, TweenInfo.new(duration / speed, Enum.EasingStyle.Linear), {
				C0 = frameData.Value
			}):Play()
		end)
	end

	for index, transparencyData in pairs(animationData.Transparency) do
		local duration = transparencyData.Time - (animationData.Transparency[index - 1] and animationData.Transparency[index - 1].Time or 0)
		local delayTime = animationData.Transparency[index - 1] and animationData.Transparency[index - 1].Time or 0

		task.delay(delayTime / speed, function()
			TS:Create(thrownObject.Decal, TweenInfo.new(duration / speed, Enum.EasingStyle.Linear), {
				Transparency = transparencyData.Value
			}):Play()
		end)
	end

	task.delay(animationData.Length / speed, function()
		thrownObject:Destroy()
	end)
end

local function scaleParticleLifetime(effectData)
	local effectContainer = effectData.FX
	local scaleFactor = effectData.Scale

	for _, descendant in pairs(effectContainer:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			descendant.Lifetime = NumberRange.new(
				descendant.Lifetime.Min * scaleFactor, 
				descendant.Lifetime.Max * scaleFactor
			)
		end
	end
end

local function handleFX(effectObject, debrisTime, tweenInfo)
	for _, descendant in pairs(effectObject:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			local emitterAttributes = descendant:GetAttributes()
			local emitDelay = emitterAttributes.EmitDelay

			if emitDelay then
				task.delay(emitDelay, function()
					descendant:Emit(emitterAttributes.EmitCount)
				end)
			else
				descendant:Emit(emitterAttributes.EmitCount)
			end

			if emitterAttributes.EmitDuration then
				descendant.Enabled = true
				task.delay(emitterAttributes.EmitDuration, function()
					descendant.Enabled = false
				end)
			end
		end

		if descendant:IsA("Beam") then
			local beamAttributes = descendant:GetAttributes()
			local beamDuration = beamAttributes.Duration
			local beamTweenTime = (tweenInfo and tweenInfo.TweenTime) or 0.5

			local function disableBeam()
				game:GetService("TweenService"):Create(
					descendant, 
					TweenInfo.new(beamTweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), 
					{ Width1 = 0, Width0 = 0 }
				):Play()
			end

			(function()
				game:GetService("TweenService"):Create(
					descendant, 
					TweenInfo.new(beamTweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), 
					{ Width1 = beamAttributes.Width1, Width0 = beamAttributes.Width0 }
				):Play()
			end)()

			if beamDuration then
				task.delay(beamDuration, function()
					disableBeam()
				end)
			end
		end
	end

	if debrisTime then
		game.Debris:AddItem(effectObject, debrisTime)
	end
end

local function toggleFX(Params)
	local fxContainer = Params.FX

	if Params.On then
        for _, descendant in pairs(fxContainer:GetDescendants()) do
            if descendant:IsA("ParticleEmitter") then
                descendant.Enabled = true
            end
        end
        return
    else
        for _, descendant in pairs(fxContainer:GetDescendants()) do
            if descendant:IsA("ParticleEmitter") then
                descendant.Enabled = false
            end
        end
        return
    end
end

local function Cinematic(targetPart, cameraModuleName, targetPosition, useShake, useFOVInFolder, extraParams, cameraOffset)
	if not CutscenesFolder:FindFirstChild(cameraModuleName) then
		warn((("Camera module does not exist for %s, falling back to old system actually nvm"):format(cameraModuleName)))
		return
	else
		local HumanoidRootPart = LocalCharacter:WaitForChild("HumanoidRootPart")
		local Humanoid = LocalCharacter:WaitForChild("Humanoid")

		if restoreCameraFunc then
			restoreCameraFunc()
		else
			previousCameraCFrame = workspace.CurrentCamera.CFrame
		end

		local CameraModuleData = require(CutscenesFolder[cameraModuleName])
		local freezeAtFinalFrame = extraParams and extraParams.FreezeAtFinalFrame
		local frameIndex = 1
		local cameraConnection = nil

		local initialCameraCFrame = CurrentCamera.CFrame

		if not targetPosition then
			local _ = targetPart.CFrame
		end

		local forceCutscene = extraParams and extraParams.ForceCutscene or false
		local skipRestore = not forceCutscene and nil
		
		if not skipRestore then
			Humanoid.AutoRotate = false
			CurrentCamera.CameraType = Enum.CameraType.Scriptable
		end

		local disconnectAttrConnection = nil
		
		local function DisconnectConnections()
			disconnectAttrConnection:Disconnect()
		end

		local isDisconnected = false

		disconnectAttrConnection = HumanoidRootPart:GetAttributeChangedSignal("DiscCamera"):Connect(function()
			if HumanoidRootPart:GetAttribute("DiscCamera") then
				disconnectAttrConnection:Disconnect()
				isDisconnected = true
			end
		end)

		local function RestoreCamera()
			disconnectAttrConnection:Disconnect()
			isDisconnected = true
		end

		restoreCameraFunc = RestoreCamera

		local isFinalFrame = false
		local isCameraEnded = false
		local customFOVObj = nil

		task.spawn(function()
			while task.wait(0.25) and not isCameraEnded do
				skipRestore = not forceCutscene and nil
				if useFOVInFolder then
					customFOVObj = LocalCharacter:FindFirstChild("CUSTOMFOV")
				end
			end
		end)

		local frames = CameraModuleData.Frames
		local fovFrames = CameraModuleData.FOV
		local freezeStartTime = nil
		local freezeEndTime = nil
		local currentFrame = frames[math.ceil(frameIndex)]
		local previousFrame = frames[math.floor(frameIndex)] or currentFrame
		local enableLerp = not (extraParams and extraParams.DisableLerp)
		local startTime = tick()
		local lerpProgress = 0

		cameraConnection = RNS.RenderStepped:Connect(function(deltaTime)
			frameIndex = (tick() - startTime) * 60 + 1
			local nextFrame = frames[math.ceil(frameIndex)]
			local fovValue = useFOVInFolder and fovFrames and not customFOVObj and fovFrames[math.ceil(frameIndex)]
			local localSkipRestore = skipRestore

			if not nextFrame and freezeAtFinalFrame and not freezeEndTime then
				freezeEndTime = tick()
			end

			if freezeEndTime and tick() - freezeEndTime <= freezeAtFinalFrame then
				nextFrame = previousFrame
				if not freezeStartTime then
					freezeStartTime = targetPart and targetPart.CFrame * CFrame.new(0, -3, 0) * nextFrame
				end
			end

			if nextFrame and not isDisconnected and not localSkipRestore then
				if not isCameraTransitioning then
					isCameraTransitioning = true
				end

				if CurrentCamera.CameraType ~= Enum.CameraType.Scriptable then
					CurrentCamera.CameraType = Enum.CameraType.Scriptable
				end

				if Humanoid.AutoRotate then
					Humanoid.AutoRotate = false
				end

				local cameraTargetCFrame = targetPart.CFrame * (cameraOffset or CFrame.new(0, -3, 0)) * previousFrame:Lerp(nextFrame, frameIndex % 1)
				if useShake then
					local shakeOffset = CurrentCamera:GetAttribute("MauioShakeOffset")
					if shakeOffset then
						cameraTargetCFrame = cameraTargetCFrame + shakeOffset
					end
				end

				if enableLerp then
					lerpProgress = lerpProgress + deltaTime
					local function SmootherStep(t)
						return 1 - (1 - t) * (1 - t)
					end

					local lerpAlpha = math.clamp(lerpProgress / 0.5, 0, 1)
					CurrentCamera.CFrame = initialCameraCFrame:Lerp(cameraTargetCFrame, SmootherStep(lerpAlpha))

					if lerpAlpha >= 1 then
						enableLerp = false
						lerpProgress = 0
					end
				else
					CurrentCamera.CFrame = cameraTargetCFrame
				end
				CurrentCamera.Focus = cameraTargetCFrame * CFrame.new(0, 0, -10)

				if fovValue then
					CurrentCamera.FieldOfView = fovValue
				end
			else
				if not nextFrame or isDisconnected or not Humanoid or (Humanoid and not Humanoid.Parent) then
					cameraConnection:Disconnect()
					isCameraTransitioning = false

					if useFOVInFolder and not customFOVObj then
						CurrentCamera.FieldOfView = 75
					end
				end

				if not localSkipRestore then
					if targetPart and targetPart.Parent and HumanoidRootPart and HumanoidRootPart.Parent and targetPart ~= HumanoidRootPart then
						task.delay(0.5, function()
							if Humanoid.Health > 0 and not LocalCharacter:FindFirstChild("Ragdoll") and not LocalCharacter:FindFirstChild("DisableCameraAutoRotateChanges") then
								Humanoid.AutoRotate = true
							end
						end)
					elseif Humanoid.Health > 0 and not LocalCharacter:FindFirstChild("DisableCameraAutoRotateChanges") then
						Humanoid.AutoRotate = true
					end
				end

				if CurrentCamera.CameraType ~= Enum.CameraType.Custom then
					CurrentCamera.CameraType = Enum.CameraType.Custom
					if previousCameraCFrame then
						CurrentCamera.CFrame = previousCameraCFrame
					end
				end

				if RestoreCamera == restoreCameraFunc then
					restoreCameraFunc = nil
				end

				if not nextFrame and not localSkipRestore then
					isCameraEnded = true
					disconnectAttrConnection:Disconnect()
				end

				if useFOVInFolder and not customFOVObj then
					CurrentCamera.FieldOfView = 75
				end
			end

			previousFrame = nextFrame
		end)
		return
	end
end

shared.CutsceneMove = function(params)
