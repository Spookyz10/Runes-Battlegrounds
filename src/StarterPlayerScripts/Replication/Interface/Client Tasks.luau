	SolemnLament = function(Params)
		local Stage     = Params.Stage
		local Character = Params.char
		local Enemy     = Params.enemy

		local TweenService  = game:GetService("TweenService")
		local Debris        = game:GetService("Debris")
		local RunService    = game:GetService("RunService")
		local Players       = game:GetService("Players")
		local LocalPlayer   = Players.LocalPlayer
		local Camera        = workspace.CurrentCamera
		local defaultFOV    = Camera.FieldOfView

		local isOwner = Character and LocalPlayer.Character == Character

		-- [[ Asset roots ]]:
		local assets = Resources["SolemnLament"]
		local VFX    = assets.VFX

		local hrpCF    = Params.hrpCF
		local enemyCF  = Params.enemyCF

		-- ── Helpers ───────────────────────────────────────────────────────

		local function camShake(intensity, duration)
			if not isOwner then return end
			local start = tick()
			local conn
			conn = RunService.RenderStepped:Connect(function()
				if tick() - start > duration then conn:Disconnect(); return end
				Camera.CFrame = Camera.CFrame * CFrame.new(
					(math.random() - 0.5) * intensity,
					(math.random() - 0.5) * intensity,
					(math.random() - 0.5) * intensity
				)
			end)
		end

		local function camZoom(targetFOV, time)
			if not isOwner then return end
			TweenService:Create(
				Camera,
				TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ FieldOfView = targetFOV }
			):Play()
		end

		local function emitVFX(vfxName, cf)
			local template = VFX:FindFirstChild(vfxName)
			if not template then return end
			local clone = template:Clone()
			clone.Parent = workspace.Effects
			pcall(function() clone:PivotTo(cf) end)

			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 25)
				end
			end

			task.delay(0.1, function()
				for _, v in ipairs(clone:GetDescendants()) do
					if v:IsA("ParticleEmitter") then
						TweenService:Create(v, TweenInfo.new(0.3), { Rate = 0 }):Play()
					end
				end
			end)

			Debris:AddItem(clone, 0.5)
		end

		-- ── Stages ────────────────────────────────────────────────────────

		if Stage == "shot" then
			-- Fires on marker "1" (white) and "2" (black)
			-- Params.vfx tells us which shot asset to use
			local vfxName = Params.vfx
			if hrpCF then
				emitVFX(vfxName, hrpCF * CFrame.new(0, -1, -3))
			end

			camShake(0.2, 0.15)
			camZoom(80, 0.06)
			task.wait(0.06)
			camZoom(defaultFOV, 0.12)

		elseif Stage == "hit" then
			-- Small hit burst on the enemy
			if enemyCF then
				emitVFX("hit", CFrame.new(enemyCF.Position))
			end
		end
	end,

	CryostasisCrash = function(Params)
-- coded by Linda ME
		local Character = Params.char
		local stage     = Params.stage

		local TweenService = game:GetService("TweenService")
		local RunService   = game:GetService("RunService")
		local Debris       = game:GetService("Debris")
		local Lighting     = game:GetService("Lighting")
		local LocalPlayer  = game:GetService("Players").LocalPlayer
		local isOwner      = LocalPlayer.Character == Character

		local Assets        = Resources["Frozen Warrior"].VFX.Awakening["Cryostasis Crash"]
		local StartupAssets = Assets.Startup
		local MeshAssets    = Assets.Mesh

		local HRP      = Character:FindFirstChild("HumanoidRootPart")
		local enemy    = Params.enemy
		local EnemyHRP = enemy and enemy:FindFirstChild("HumanoidRootPart")

		-- ── Helpers ──────────────────────────────────────────────────────────

		local function emitGroup(root)
			if not root then return end
			for _, v in pairs(root:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 10)
				end
			end
		end

		local function setEnabled(root, enabled)
			if not root then return end
			for _, v in pairs(root:GetDescendants()) do
				if v:IsA("ParticleEmitter") or v:IsA("Beam") then
					v.Enabled = enabled
				end
			end
		end

		local function cloneAtCF(template, pivotCF, lifetime)
			if not template then return nil end
			local clone = template:Clone()
			clone.Parent = workspace.Effects
			for _, p in pairs(clone:GetDescendants()) do
				if p:IsA("BasePart") then p.CanCollide = false; p.Anchored = true end
			end
			pcall(function() clone:PivotTo(pivotCF) end)
			Debris:AddItem(clone, lifetime or 4)
			return clone
		end

		local function cloneOnHRP(template, hrp, lifetime)
			if not template or not hrp then return nil end
			local clone = template:Clone()
			clone.Parent = hrp
			for _, p in pairs(clone:GetDescendants()) do
				if p:IsA("BasePart") then p.CanCollide = false; p.Anchored = false end
			end
			Debris:AddItem(clone, lifetime or 4)
			return clone
		end

		-- [[ Emit burst + briefly enable beams ]]:
		local function spawnHit(template, cf, lifetime)
			local c = cloneAtCF(template, cf, lifetime or 3)
			if not c then return end
			setEnabled(c, false)
			emitGroup(c)
			for _, v in pairs(c:GetDescendants()) do
				if v:IsA("Beam") then
					v.Enabled = true
					task.delay(0.3, function() if v and v.Parent then v.Enabled = false end end)
				end
			end
		end

		-- [[ Clone on HRP with all emitters enabled ]]:
		local function loopOnHRP(template, hrp, lifetime)
			local c = cloneOnHRP(template, hrp, lifetime)
			if c then setEnabled(c, true) end
			return c
		end

		-- [[ Owner-only screen tint: instant flash then fade ]]:
		local function ccFlash(r, g, b, bright, contrast, sat, fade)
			if not isOwner then return end
			local cc = Instance.new("ColorCorrectionEffect")
			cc.Parent = Lighting
			local t = TweenService:Create(cc, TweenInfo.new(1/60), {
				TintColor = Color3.fromRGB(r,g,b), Brightness = bright, Contrast = contrast, Saturation = sat,
			}) t:Play()
			t.Completed:Once(function()
				TweenService:Create(cc, TweenInfo.new(fade, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					TintColor = Color3.fromRGB(255,255,255), Brightness = 0, Contrast = 0, Saturation = 0,
				}):Play()
				task.delay(fade, function() if cc and cc.Parent then cc:Destroy() end end)
			end)
		end

		-- ── STARTUP ──────────────────────────────────────────────────────────
		if stage == "Startup" then

			local hrpCF = Params.hrpCF

			-- [[ Burst at feet ]]:
			local iceSkate = cloneAtCF(StartupAssets.IceSkate, hrpCF, 2)
			if iceSkate then
				local fl = iceSkate:FindFirstChild("FloorMoving") if fl then setEnabled(fl, true) end
				local se = iceSkate:FindFirstChild("StartEmit")   if se then emitGroup(se) end
			end
			local sstart = cloneAtCF(StartupAssets.skatestart, hrpCF, 3) if sstart then emitGroup(sstart) end
			local icePath = cloneAtCF(StartupAssets.IcePath,   hrpCF, 3.5) if icePath then setEnabled(icePath, true) end

			-- [[ Mesh run + charge follow caster ]]:
			loopOnHRP(StartupAssets.Meshes:FindFirstChild("Run"),    HRP, 2.5)
			loopOnHRP(StartupAssets.Meshes:FindFirstChild("Charge"), HRP, 2.5)
			loopOnHRP(StartupAssets.Wind2,  HRP, 2.5)
			loopOnHRP(StartupAssets.Wind1,  HRP, 2.5)
			loopOnHRP(StartupAssets.charge, HRP, 2.5)

			local run = cloneOnHRP(Assets.run, HRP, 2.5)
			if run then setEnabled(run, true) end

			-- [[ Emit1 + chargeup burst on caster ]]:
			local emit1   = cloneOnHRP(Assets.Emit1,   HRP, 2.5) if emit1   then emitGroup(emit1)   end
			local chargeup = cloneOnHRP(Assets.chargeup, HRP, 2.5) if chargeup then emitGroup(chargeup) end

			-- [[ Spike + skatestart ground burst ]]:
			local spike = cloneAtCF(StartupAssets.spike, hrpCF, 2) if spike then emitGroup(spike) end
			local meshChg = cloneAtCF(StartupAssets.Meshes:FindFirstChild("Charge"), hrpCF, 1.5) if meshChg then emitGroup(meshChg) end

			-- [[ Steerable dash — owner only ]]:
			if isOwner then
				local Camera = workspace.CurrentCamera

				local DashAtt = Instance.new("Attachment")
				DashAtt.Name = "CryoDashAtt"; DashAtt.Parent = HRP

				local DashVel = Instance.new("LinearVelocity")
				DashVel.Name = "CryoDashVel"
				DashVel.Attachment0 = DashAtt
				DashVel.MaxForce = math.huge
				DashVel.VelocityConstraintMode = Enum.VelocityConstraintMode.Line
				DashVel.LineDirection = HRP.CFrame.LookVector
				DashVel.LineVelocity = 50
				DashVel.Parent = HRP

				local conn = RunService.Heartbeat:Connect(function()
					if not HRP or not HRP.Parent then return end
					local d = Camera.CFrame.LookVector
					local dir = Vector3.new(d.X, 0, d.Z)
					if dir.Magnitude > 0 then DashVel.LineDirection = dir.Unit end
				end)
				_G["CryoDashConn_" .. tostring(Character)] = conn

				-- [[ Subtle cold tint during dash ]]:
				local cc = Instance.new("ColorCorrectionEffect")
				cc.Name = "CryoDashCC"; cc.Parent = Lighting
				TweenService:Create(cc, TweenInfo.new(0.1), {
					TintColor = Color3.fromRGB(180, 215, 255), Brightness = 0.2, Contrast = 0.4, Saturation = -0.3,
				}):Play()
				task.delay(1.0, function()
					TweenService:Create(cc, TweenInfo.new(0.3), {
						TintColor = Color3.fromRGB(255,255,255), Brightness = 0, Contrast = 0, Saturation = 0,
					}):Play()
					task.delay(0.3, function() if cc and cc.Parent then cc:Destroy() end end)
				end)
			end

			-- ── STOP DASH ────────────────────────────────────────────────────────
		elseif stage == "StopDash" then
			if isOwner then
				if HRP then
					local v = HRP:FindFirstChild("CryoDashVel") if v then v:Destroy() end
					local a = HRP:FindFirstChild("CryoDashAtt") if a then a:Destroy() end
				end
				local c = _G["CryoDashConn_" .. tostring(Character)]
				if c then c:Disconnect(); _G["CryoDashConn_" .. tostring(Character)] = nil end
			end

			-- ── CAUGHT ───────────────────────────────────────────────────────────
		elseif stage == "Caught" then

			local hrpCF = Params.hrpCF

			-- [[ Sharp catch impact ]]:
			local catchin = cloneAtCF(Assets.catchinhand, hrpCF, 2)
			if catchin then
				local h1 = catchin:FindFirstChild("Hit1") if h1 then emitGroup(h1) end
				local h2 = catchin:FindFirstChild("Hit2") if h2 then emitGroup(h2) end
			end
			local chargeup = cloneAtCF(Assets.chargeup, hrpCF, 2) if chargeup then emitGroup(chargeup) end
			local startfly = cloneAtCF(Assets.startfly,  hrpCF, 2) if startfly then emitGroup(startfly) end
			local kick     = cloneAtCF(StartupAssets.Kick,  hrpCF, 2) if kick then emitGroup(kick) end

			-- [[ Ice chunks fly out on catch ]]:
			for i, name in pairs({"Mesh1","Mesh2","Mesh3"}) do
				task.delay((i-1) * 0.05, function()
					local m = cloneAtCF(MeshAssets[name], hrpCF, 3) if m then emitGroup(m) end
				end)
			end

			-- [[ Persistent trail + torsoting for whole move ]]:
			local trail = cloneOnHRP(Assets.Trail, HRP, 8)
			if trail then
				local t1 = trail:FindFirstChild("1") if t1 then setEnabled(t1, true) end
				local t2 = trail:FindFirstChild("2") if t2 then setEnabled(t2, true) end
			end

			local torsoting = cloneOnHRP(Assets.torsoting, HRP, 8)
			if torsoting then
				local t  = torsoting:FindFirstChild("torsoting")  if t  then emitGroup(t)         end
				local t2 = torsoting:FindFirstChild("torsoting2") if t2 then setEnabled(t2, true) end
			end

			-- [[ Enemy gets drag + torsoting ]]:
			if EnemyHRP then
				loopOnHRP(Assets.drag, EnemyHRP, 8)
				local torsoE = cloneOnHRP(Assets.torsoting, EnemyHRP, 8)
				if torsoE then
					local t  = torsoE:FindFirstChild("torsoting")  if t  then emitGroup(t)         end
					local t2 = torsoE:FindFirstChild("torsoting2") if t2 then setEnabled(t2, true) end
				end
			end

			ccFlash(210, 235, 255, 1.0, 1.5, -0.6, 0.25)

			-- [[ Sustained cold tint for whole move — subtle ]]:
			if isOwner then
				local cc = Instance.new("ColorCorrectionEffect")
				cc.Name = "CryoMoveCC"; cc.Parent = Lighting
				TweenService:Create(cc, TweenInfo.new(0.4), {
					TintColor = Color3.fromRGB(200, 220, 255), Brightness = 0.05, Contrast = 0.15, Saturation = -0.2,
				}):Play()
				task.delay(7, function()
					TweenService:Create(cc, TweenInfo.new(0.5), {
						TintColor = Color3.fromRGB(255,255,255), Brightness = 0, Contrast = 0, Saturation = 0,
					}):Play()
					task.delay(0.5, function() if cc and cc.Parent then cc:Destroy() end end)
				end)

				if Assets:FindFirstChild("FreezeUI") then
					local ui = Assets.FreezeUI:Clone()
					ui.Parent = LocalPlayer.PlayerGui
					Debris:AddItem(ui, 8)
				end
			end

			-- ── LIFTOFF ──────────────────────────────────────────────────────────
		elseif stage == "LiftOff" then

			local hrpCF   = Params.hrpCF
			local enemyCF = Params.enemyHrpCF

			local spkcont = cloneAtCF(StartupAssets.SpikeCont, hrpCF, 2) if spkcont then emitGroup(spkcont) end
			local leap    = cloneAtCF(StartupAssets.Leap2,     hrpCF, 2) if leap    then emitGroup(leap)    end

			if enemyCF then spawnHit(Assets.HitUp, CFrame.new(enemyCF.Position), 2) end

			loopOnHRP(StartupAssets.Wind1, HRP, 1.0)
			loopOnHRP(StartupAssets.charge, HRP, 1.0)

			ccFlash(190, 225, 255, 0.8, 1.2, -0.6, 0.2)

			-- ── FLYING LOOPS — all handled identically, refreshed every 0.6s ────
		elseif stage == "Flying" or stage == "FlyLoop" or stage == "FlyLoop2" then

			-- [[ Smooth continuous ice stream — short lifetime so they chain ]]:
			loopOnHRP(StartupAssets.Wind2,  HRP, 1.0)
			loopOnHRP(StartupAssets.Wind1,  HRP, 1.0)
			loopOnHRP(StartupAssets.charge, HRP, 1.0)

			local meshRun = loopOnHRP(StartupAssets.Meshes:FindFirstChild("Run"), HRP, 1.0)

			local run = cloneOnHRP(Assets.run, HRP, 1.0) if run then setEnabled(run, true) end

			local trail = cloneOnHRP(Assets.Trail, HRP, 1.0)
			if trail then
				local t1 = trail:FindFirstChild("1") if t1 then setEnabled(t1, true) end
				local t2 = trail:FindFirstChild("2") if t2 then setEnabled(t2, true) end
			end

			if EnemyHRP then
				loopOnHRP(Assets.drag, EnemyHRP, 0.8)
			end

			-- ── HIT 1 — first mid-air strike ─────────────────────────────────────
		elseif stage == "Hit1" then

			local pos = CFrame.new(Params.enemyHrpCF.Position)

			spawnHit(Assets.Hitmidair, pos, 2)
			spawnHit(Assets.Hit4,      pos, 2)

			local hit2hl = cloneAtCF(Assets.hit2highlight, pos, 2) if hit2hl then emitGroup(hit2hl) end
			local spkcont = cloneAtCF(StartupAssets.SpikeCont, pos, 2) if spkcont then emitGroup(spkcont) end

			if EnemyHRP then
				local torsoH = cloneOnHRP(Assets.torsoting, EnemyHRP, 1.2)
				if torsoH then
					local t = torsoH:FindFirstChild("torsoting") if t then emitGroup(t) end
				end
			end

			loopOnHRP(StartupAssets.Wind1, HRP, 0.8)
			loopOnHRP(StartupAssets.Wind2, HRP, 0.8)

			ccFlash(190, 225, 255, 0.9, 1.5, -0.7, 0.2)

			-- ── HIT 1 LOOP — fill gap ────────────────────────────────────────────
		elseif stage == "Hit1Loop" then

			local pos = CFrame.new(Params.enemyHrpCF.Position)

			spawnHit(Assets.Hit2, pos, 2)
			local icePath = cloneAtCF(StartupAssets.IcePath, pos, 1.5) if icePath then setEnabled(icePath, true) end

			loopOnHRP(StartupAssets.Wind2,  HRP, 0.7)
			loopOnHRP(StartupAssets.charge, HRP, 0.7)
			if EnemyHRP then loopOnHRP(Assets.drag, EnemyHRP, 0.7) end

			-- ── HIT 2 — second mid-air strike ────────────────────────────────────
		elseif stage == "Hit2" then

			local pos = CFrame.new(Params.enemyHrpCF.Position)

			spawnHit(Assets.HitUp, pos, 2.5)
			spawnHit(Assets.Hit5,  pos, 2.5)

			local hitupbeam = cloneAtCF(Assets.HitupBeam, pos, 2)
			if hitupbeam then
				local att = hitupbeam:FindFirstChild("Attachment") if att then setEnabled(att, true) end
			end
			local hit2hl = cloneAtCF(Assets.hit2highlight, pos, 2) if hit2hl then emitGroup(hit2hl) end

			if EnemyHRP then
				local torsoH2 = cloneOnHRP(Assets.torsoting, EnemyHRP, 1.5)
				if torsoH2 then
					local t = torsoH2:FindFirstChild("torsoting") if t then emitGroup(t) end
				end
			end

			loopOnHRP(StartupAssets.Wind1, HRP, 0.8)
			loopOnHRP(StartupAssets.Wind2, HRP, 0.8)

			ccFlash(200, 230, 255, 1.2, 2, -0.9, 0.25)

			-- ── HIT 2 LOOP — bridge to windup ────────────────────────────────────
		elseif stage == "Hit2Loop" then

			local pos = CFrame.new(Params.enemyHrpCF.Position)

			spawnHit(Assets.Hitmidair, pos, 2)
			local hit2hl = cloneAtCF(Assets.hit2highlight, pos, 1.5) if hit2hl then emitGroup(hit2hl) end
			local spike = cloneAtCF(StartupAssets.spike, pos, 2) if spike then emitGroup(spike) end
			local icePath = cloneAtCF(StartupAssets.IcePath, pos, 2) if icePath then setEnabled(icePath, true) end

			loopOnHRP(StartupAssets.Wind1,  HRP, 0.6)
			loopOnHRP(StartupAssets.charge, HRP, 0.6)
			if EnemyHRP then loopOnHRP(Assets.drag, EnemyHRP, 0.6) end

			ccFlash(185, 220, 255, 0.6, 1.0, -0.5, 0.3)

			-- ── WINDUP STAGES — cycling loop, escalating ice ─────────────────────
			-- Each stage is slightly heavier than the last
			-- Server cycles through all 5 every 0.35s so effects never stop

		elseif stage == "WindUp" then

			local hrpCF = Params.hrpCF
			local pos   = Params.enemyHrpCF and CFrame.new(Params.enemyHrpCF.Position) or CFrame.new(hrpCF.Position)

			local spike  = cloneAtCF(StartupAssets.spike,      pos, 1.5) if spike  then emitGroup(spike)  end
			local spikes = cloneAtCF(Assets.Spikes,             pos, 1.5) if spikes then emitGroup(spikes) end
			local icePath = cloneAtCF(StartupAssets.IcePath,   pos, 1.5) if icePath then setEnabled(icePath, true) end

			loopOnHRP(StartupAssets.Wind1,  HRP, 0.5)
			loopOnHRP(StartupAssets.charge, HRP, 0.5)
			if EnemyHRP then
				local torso = cloneOnHRP(Assets.torsoting, EnemyHRP, 1.2)
				if torso then
					local t2 = torso:FindFirstChild("torsoting2") if t2 then setEnabled(t2, true) end
				end
				loopOnHRP(Assets.drag, EnemyHRP, 0.5)
			end

		elseif stage == "WindUp2" then

			local hrpCF = Params.hrpCF
			local pos   = Params.enemyHrpCF and CFrame.new(Params.enemyHrpCF.Position) or CFrame.new(hrpCF.Position)

			local spkcont = cloneAtCF(StartupAssets.SpikeCont, pos, 1.5) if spkcont then emitGroup(spkcont) end
			local spikes  = cloneAtCF(Assets.Spikes,            pos, 1.5) if spikes  then emitGroup(spikes)  end
			local meshSpk = cloneAtCF(StartupAssets.Meshes:FindFirstChild("Spike"), pos, 1.5) if meshSpk then emitGroup(meshSpk) end

			loopOnHRP(StartupAssets.Wind2,  HRP, 0.5)
			loopOnHRP(StartupAssets.charge, HRP, 0.5)
			if EnemyHRP then loopOnHRP(Assets.drag, EnemyHRP, 0.5) end

			ccFlash(180, 215, 255, 0.5, 0.8, -0.4, 0.3)

		elseif stage == "WindUp3" then

			local hrpCF = Params.hrpCF
			local pos   = Params.enemyHrpCF and CFrame.new(Params.enemyHrpCF.Position) or CFrame.new(hrpCF.Position)

			local iceSkate = cloneAtCF(StartupAssets.IceSkate, pos, 2)
			if iceSkate then
				local fl = iceSkate:FindFirstChild("FloorMoving") if fl then setEnabled(fl, true) end
				local se = iceSkate:FindFirstChild("StartEmit")   if se then emitGroup(se) end
			end
			local spike  = cloneAtCF(StartupAssets.spike, pos, 1.5) if spike  then emitGroup(spike)  end
			local spikes = cloneAtCF(Assets.Spikes,        pos, 2)   if spikes then emitGroup(spikes) end
			local meshSlam = cloneAtCF(StartupAssets.Meshes:FindFirstChild("Slam"), hrpCF, 1.5) if meshSlam then emitGroup(meshSlam) end

			loopOnHRP(StartupAssets.Wind1, HRP, 0.4)
			loopOnHRP(StartupAssets.Wind2, HRP, 0.4)
			if EnemyHRP then
				local torso = cloneOnHRP(Assets.torsoting, EnemyHRP, 1.2)
				if torso then
					local t  = torso:FindFirstChild("torsoting")  if t  then emitGroup(t)         end
					local t2 = torso:FindFirstChild("torsoting2") if t2 then setEnabled(t2, true) end
				end
			end

			ccFlash(175, 210, 255, 0.7, 1.2, -0.6, 0.25)

		elseif stage == "WindUp4" then

			local hrpCF = Params.hrpCF
			local pos   = Params.enemyHrpCF and CFrame.new(Params.enemyHrpCF.Position) or CFrame.new(hrpCF.Position)

			spawnHit(Assets.HitUp, pos, 2)
			local spkcont  = cloneAtCF(StartupAssets.SpikeCont, pos, 2)   if spkcont  then emitGroup(spkcont)  end
			local meshSpk  = cloneAtCF(StartupAssets.Meshes:FindFirstChild("Spike"), pos, 2) if meshSpk then emitGroup(meshSpk) end
			local hit2hl   = cloneAtCF(Assets.hit2highlight,    pos, 1.5) if hit2hl   then emitGroup(hit2hl)   end

			for i, name in pairs({"Mesh1","Mesh5"}) do
				task.delay((i-1)*0.06, function()
					local m = cloneAtCF(MeshAssets[name], pos, 3) if m then emitGroup(m) end
				end)
			end

			loopOnHRP(StartupAssets.Wind1,  HRP, 0.5)
			loopOnHRP(StartupAssets.charge, HRP, 0.5)
			if EnemyHRP then loopOnHRP(Assets.drag, EnemyHRP, 0.5) end

			ccFlash(165, 205, 255, 0.9, 1.5, -0.8, 0.25)

		elseif stage == "WindUp5" then

			local hrpCF = Params.hrpCF
			local pos   = Params.enemyHrpCF and CFrame.new(Params.enemyHrpCF.Position) or CFrame.new(hrpCF.Position)

			-- [[ Heaviest WindUp — previews the slam ]]:
			local spike    = cloneAtCF(StartupAssets.spike,     pos, 2)   if spike    then emitGroup(spike)          end
			local spikes   = cloneAtCF(Assets.Spikes,           pos, 2)   if spikes   then emitGroup(spikes)         end
			local spkcont  = cloneAtCF(StartupAssets.SpikeCont, pos, 2)   if spkcont  then emitGroup(spkcont)        end
			local icePath  = cloneAtCF(StartupAssets.IcePath,   pos, 2)   if icePath  then setEnabled(icePath, true) end
			local meshSlam = cloneAtCF(StartupAssets.Meshes:FindFirstChild("Slam"),  hrpCF, 2) if meshSlam then emitGroup(meshSlam) end
			local meshSpk  = cloneAtCF(StartupAssets.Meshes:FindFirstChild("Spike"), pos,   2) if meshSpk  then emitGroup(meshSpk)  end

			spawnHit(Assets.HitUp, pos, 2)
			for i, name in pairs({"Mesh2","Mesh3"}) do
				task.delay((i-1)*0.05, function()
					local m = cloneAtCF(MeshAssets[name], pos, 3) if m then emitGroup(m) end
				end)
			end

			loopOnHRP(StartupAssets.Wind1,  HRP, 0.5)
			loopOnHRP(StartupAssets.Wind2,  HRP, 0.5)
			loopOnHRP(StartupAssets.charge, HRP, 0.5)
			if EnemyHRP then
				local torso = cloneOnHRP(Assets.torsoting, EnemyHRP, 1.5)
				if torso then
					local t  = torso:FindFirstChild("torsoting")  if t  then emitGroup(t)         end
					local t2 = torso:FindFirstChild("torsoting2") if t2 then setEnabled(t2, true) end
				end
				loopOnHRP(Assets.drag, EnemyHRP, 0.5)
			end

			ccFlash(155, 200, 255, 1.1, 1.8, -1.0, 0.3)

			-- ── SLAM ─────────────────────────────────────────────────────────────
		elseif stage == "Slam" then

			local groundPos = CFrame.new(Params.enemyHrpCF.Position)
			local hrpCF     = Params.hrpCF

			-- [[ Instant — the hit ]]:
			local fSpikes = cloneAtCF(Assets.FinalSpikesMesh, groundPos, 6) if fSpikes then setEnabled(fSpikes, true) end
			local fthrow  = cloneAtCF(Assets.finalthrow,      groundPos, 4) if fthrow  then emitGroup(fthrow)         end
			local hit3    = cloneAtCF(Assets.Hit3,             groundPos, 3) if hit3    then emitGroup(hit3)           end

			local groundhit = cloneAtCF(Assets.groundhit, groundPos, 5)
			if groundhit then
				emitGroup(groundhit)
				local att = groundhit:FindFirstChild("Attachment") if att then setEnabled(att, true) end
			end

			local hitupbeam = cloneAtCF(Assets.HitupBeam, groundPos, 2.5)
			if hitupbeam then
				local att = hitupbeam:FindFirstChild("Attachment") if att then setEnabled(att, true) end
			end

			-- [[ Ice eruption — spikes and floor ice ]]:
			local spike   = cloneAtCF(StartupAssets.spike,     groundPos, 5) if spike   then emitGroup(spike)          end
			local spikes  = cloneAtCF(Assets.Spikes,           groundPos, 5) if spikes  then emitGroup(spikes)         end
			local spkcont = cloneAtCF(StartupAssets.SpikeCont, groundPos, 5) if spkcont then emitGroup(spkcont)        end
			local icePath = cloneAtCF(StartupAssets.IcePath,   groundPos, 5) if icePath then setEnabled(icePath, true) end
			local iceSkate = cloneAtCF(StartupAssets.IceSkate, groundPos, 4)
			if iceSkate then
				local fl = iceSkate:FindFirstChild("FloorMoving") if fl then setEnabled(fl, true) end
				local se = iceSkate:FindFirstChild("StartEmit")   if se then emitGroup(se) end
			end

			-- [[ Mesh folders ]]:
			local meshSlam  = cloneAtCF(StartupAssets.Meshes:FindFirstChild("Slam"),  groundPos, 4) if meshSlam  then emitGroup(meshSlam)  end
			local meshSpike = cloneAtCF(StartupAssets.Meshes:FindFirstChild("Spike"), groundPos, 4) if meshSpike then emitGroup(meshSpike) end
			local slam      = cloneAtCF(StartupAssets.Slam, groundPos, 4)                           if slam      then emitGroup(slam)      end

			-- [[ Hit bursts staggered ]]:
			for i, name in pairs({"Hit1","Hit2","Hit4","Hit5","Hit6"}) do
				task.delay((i-1) * 0.07, function()
					spawnHit(Assets[name], groundPos, 3)
				end)
			end

			-- [[ Mesh chunks flying out ]]:
			for _, name in pairs({"Mesh1","Mesh2","Mesh3","Mesh5","Mesh6"}) do
				task.delay(math.random(0,4) * 0.05, function()
					local m = cloneAtCF(MeshAssets[name], groundPos, 5) if m then emitGroup(m) end
				end)
			end

			-- [[ Delayed second ice wave — spikes keep erupting ]]:
			task.delay(0.25, function()
				local s2 = cloneAtCF(Assets.Spikes,           groundPos, 4) if s2 then emitGroup(s2) end
				local sp2 = cloneAtCF(StartupAssets.SpikeCont,groundPos, 4) if sp2 then emitGroup(sp2) end
				local hitup = cloneAtCF(Assets.HitUp,         groundPos, 3) if hitup then emitGroup(hitup) end
			end)

			if isOwner then
				-- [[ White slam flash → cold blue → slow fade ]]:
				local cc = Instance.new("ColorCorrectionEffect")
				cc.Name = "CryoSlamCC"; cc.Parent = Lighting
				local t1 = TweenService:Create(cc, TweenInfo.new(1/60), {
					TintColor = Color3.fromRGB(255,255,255), Brightness = 2.5, Contrast = 3, Saturation = -1.5,
				}) t1:Play()
				t1.Completed:Once(function()
					local t2 = TweenService:Create(cc, TweenInfo.new(0.1), {
						TintColor = Color3.fromRGB(100, 160, 230), Brightness = 0.8, Contrast = 1.5, Saturation = -1,
					}) t2:Play()
					t2.Completed:Once(function()
						TweenService:Create(cc, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							TintColor = Color3.fromRGB(255,255,255), Brightness = 0, Contrast = 0, Saturation = 0,
						}):Play()
						task.delay(0.9, function() if cc and cc.Parent then cc:Destroy() end end)
					end)
				end)

				-- [[ 4 screen shakes ]]:
				for i = 1, 4 do
					task.delay((i-1) * 0.04, function()
						local sh = Instance.new("ColorCorrectionEffect")
						sh.Contrast  = i % 2 == 0 and -1.5 or 1.5
						sh.Brightness = i % 2 == 0 and -0.3 or 0.3
						sh.Parent = Lighting
						task.delay(0.04, function() if sh and sh.Parent then sh:Destroy() end end)
					end)
				end
			end

			-- ── END ──────────────────────────────────────────────────────────────
		elseif stage == "End" then
			if isOwner then
				if HRP then
					local v = HRP:FindFirstChild("CryoDashVel") if v then v:Destroy() end
					local a = HRP:FindFirstChild("CryoDashAtt") if a then a:Destroy() end
				end
				local c = _G["CryoDashConn_" .. tostring(Character)]
				if c then c:Disconnect(); _G["CryoDashConn_" .. tostring(Character)] = nil end
			end
		end
	end,

	-- Paste this entry into your replication handler

	BakugoBeamFlame = function(Params)
		local Character = Params.char
		local HRP = Character.HumanoidRootPart
		local stage = Params.stage

		local TweenService = game:GetService("TweenService")
		local Debris = game:GetService("Debris")
		local Lighting = game:GetService("Lighting")
		local RunService = game:GetService("RunService")
		local LocalPlayer = game:GetService("Players").LocalPlayer
		local isOwner = LocalPlayer.Character == Character

		local Assets = Resources.BakugoAssets.Effects.Explosion.Skill2

		if stage == "Start" then
			local targetCF = CFrame.new(Vector3.new(Params.posX, Params.posY, Params.posZ))
				* CFrame.Angles(0, math.atan2(-Params.dirX, -Params.dirZ), 0)

			-- [[ RayFX ]]:
			local rayFX = Assets.RayFX:Clone()
			rayFX.Parent = workspace.Effects
			rayFX:PivotTo(targetCF)

			local startPart = rayFX:FindFirstChild("Start")
			local corePart  = rayFX:FindFirstChild("Core")
			local endPart   = rayFX:FindFirstChild("End")
			local meshFlipSlash = rayFX:FindFirstChild("MeshFlipSlash")
			local meshFlip03    = rayFX:FindFirstChild("MeshFlip03")

			-- [[ TrailSpin helper ]]:
			local function createTrailSpin(startCFrame, eP)
				local trailClone = Assets.TrailSpin:Clone()
				trailClone.Parent = workspace.Effects
				local trailPart = trailClone:FindFirstChild("TrailSpin")
				if not trailPart then Debris:AddItem(trailClone, 2); return end

				for _, t in pairs(trailClone:GetDescendants()) do
					if t:IsA("Trail") then t.Enabled = true end
				end

				trailPart.CFrame = startCFrame
				local elapsed = 0
				local startPos = startCFrame.Position
				local endPos = eP.CFrame.Position
				local conn
				conn = RunService.Heartbeat:Connect(function(dt)
					elapsed = elapsed + dt
					local progress = math.clamp(elapsed / 0.15, 0, 1)
					local lerpPos = startPos:Lerp(endPos, progress)
					local dir = (endPos - lerpPos)
					if dir.Magnitude > 0 then
						trailPart.CFrame = CFrame.lookAt(lerpPos, lerpPos + dir.Unit)
							* CFrame.Angles(0, 0, elapsed * 41.888)
					end
					if progress >= 1 then
						conn:Disconnect()
						for _, t in pairs(trailClone:GetDescendants()) do
							if t:IsA("Trail") then t.Enabled = false end
						end
						Debris:AddItem(trailClone, 1)
					end
				end)
			end

			task.delay(0.083, function()
				if startPart then
					for _, v in pairs(startPart:GetDescendants()) do
						if v:IsA("ParticleEmitter") then
							v.Enabled = true
							v:Emit(v:GetAttribute("EmitCount") or 30)
						end
						if v:IsA("Beam") then
							v.Enabled = true
							local bt = TweenService:Create(v, TweenInfo.new(0.417, Enum.EasingStyle.Linear), { Width0 = 0, Width1 = 0 })
							bt:Play()
							bt.Completed:Once(function() if v and v.Parent then v:Destroy() end end)
						end
					end
				end

				-- [[ Spinning trail emission loop ]]:
				task.spawn(function()
					local t0 = os.clock()
					while os.clock() - t0 < 0.417 do
						if meshFlipSlash then
							for _, v in pairs(meshFlipSlash:GetDescendants()) do
								if v:IsA("ParticleEmitter") then v:Emit(15) end
							end
						end
						if meshFlip03 then
							for _, v in pairs(meshFlip03:GetDescendants()) do
								if v:IsA("ParticleEmitter") then v:Emit(15) end
							end
						end
						if corePart and endPart then
							createTrailSpin(corePart.CFrame, endPart)
						end
						task.wait(0.15)
					end
				end)

				-- [[ Owner-only screen effects ]]:
				if isOwner then
					local Camera = workspace.CurrentCamera
					-- FOV punch
					local origFOV = Camera.FieldOfView
					TweenService:Create(Camera, TweenInfo.new(1/60, Enum.EasingStyle.Linear), { FieldOfView = 80 }):Play()
					task.delay(0.4, function()
						TweenService:Create(Camera, TweenInfo.new(0.5, Enum.EasingStyle.Linear), { FieldOfView = origFOV }):Play()
					end)

					-- Color correction flash
					local cc = Instance.new("ColorCorrectionEffect")
					cc.TintColor = Color3.fromRGB(255, 113, 42)
					cc.Brightness = 1; cc.Saturation = -2; cc.Contrast = 2
					cc.Parent = Lighting
					local t1 = TweenService:Create(cc, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
						TintColor = Color3.fromRGB(255,255,255), Brightness = 0, Saturation = 0, Contrast = 0
					})
					t1:Play()
					t1.Completed:Once(function()
						task.wait(0.2)
						if cc and cc.Parent then cc:Destroy() end
					end)

					-- Camera shake
					task.spawn(function()
						local startTime = tick()
						local duration = 0.5
						local magnitude = 0.5
						while tick() - startTime < duration do
							local elapsed = tick() - startTime
							local intensity = magnitude * (1 - elapsed / duration)
							local offset = Vector3.new(
								math.random(-100, 100) / 100 * intensity,
								math.random(-100, 100) / 100 * intensity,
								0
							)
							Camera.CFrame = Camera.CFrame + offset
							task.wait(0.03)
							Camera.CFrame = Camera.CFrame - offset
						end
					end)
				end
			end)

			-- [[ Explosion VFX ]]:
			task.delay(0.2, function()
				local explosionTemplate = Assets:FindFirstChild("Explosion") or Assets:FindFirstChild("PungExplosion")
				if explosionTemplate then
					local expClone = explosionTemplate:Clone()
					expClone.Parent = workspace.Effects
					expClone:PivotTo(targetCF * CFrame.new(0, 2, 0))
					Debris:AddItem(expClone, 7)

					task.delay(0.183, function()
						for _, v in pairs(expClone:GetDescendants()) do
							if v:IsA("ParticleEmitter") then
								task.spawn(function()
									v.Enabled = true
									local d = v:GetAttribute("EmitDelay")
									if d then task.wait(d) end
									v:Emit(v:GetAttribute("EmitCount") or 50)
								end)
							end
						end

						-- [[ Explosion color correction — owner only ]]:
						if isOwner then
							local cc2 = Instance.new("ColorCorrectionEffect")
							cc2.TintColor = Color3.fromRGB(255, 62, 36)
							cc2.Brightness = -0.5; cc2.Contrast = 3; cc2.Saturation = -2
							cc2.Parent = Lighting
							local t1 = TweenService:Create(cc2, TweenInfo.new(1/60, Enum.EasingStyle.Linear), {
								TintColor = Color3.fromRGB(255,62,36), Brightness = -0.5, Contrast = 3, Saturation = -2
							})
							t1:Play()
							t1.Completed:Once(function()
								local t2 = TweenService:Create(cc2, TweenInfo.new(0.133, Enum.EasingStyle.Linear), {
									TintColor = Color3.fromRGB(255,145,130), Brightness = -0.6, Contrast = 1.714, Saturation = -1.143
								})
								t2:Play()
								t2.Completed:Once(function()
									TweenService:Create(cc2, TweenInfo.new(0.15, Enum.EasingStyle.Linear), {
										TintColor = Color3.fromRGB(255,255,255), Brightness = 0, Contrast = 0, Saturation = 0
									}):Play()
									task.delay(1, function()
										if cc2 and cc2.Parent then cc2:Destroy() end
									end)
								end)
							end)
						end
					end)
				end
			end)

			-- [[ Flash effect — owner only ]]:
			task.delay(0.1, function()
				if isOwner then
					local Camera = workspace.CurrentCamera
					local flashPart = Instance.new("Part")
					flashPart.Size = Vector3.new(100, 100, 1)
					flashPart.Transparency = 1
					flashPart.Anchored = true
					flashPart.CanCollide = false
					flashPart.CFrame = Camera.CFrame * CFrame.new(0, 0, -5)
					flashPart.Parent = workspace.Effects

					local sg = Instance.new("SurfaceGui", flashPart)
					sg.AlwaysOnTop = true
					local frame = Instance.new("Frame", sg)
					frame.Size = UDim2.new(1, 0, 1, 0)
					frame.BackgroundColor3 = Color3.fromRGB(255, 200, 150)
					frame.BackgroundTransparency = 0.7

					local ft = TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						BackgroundTransparency = 1
					})
					ft:Play()
					ft.Completed:Once(function()
						if flashPart and flashPart.Parent then flashPart:Destroy() end
					end)
					Debris:AddItem(flashPart, 5)
				end
			end)

			-- [[ Cleanup RayFX ]]:
			task.delay(0.417, function()
				if startPart then
					for _, v in pairs(startPart:GetDescendants()) do
						if v:IsA("ParticleEmitter") or v:IsA("Beam") then v.Enabled = false end
					end
				end
				task.delay(1.5, function()
					if rayFX and rayFX.Parent then
						for _, part in pairs(rayFX:GetChildren()) do
							for _, v in pairs(part:GetDescendants()) do
								if v:IsA("ParticleEmitter") then v.Enabled = false end
							end
						end
						rayFX:Destroy()
					end
				end)
			end)
		end
	end,

	dropkickwindup = function(Params)
		local character = Params.char
		local id = Params.id
		local RootPart = character:FindFirstChildOfClass("Humanoid").RootPart

		local TweenService = game:GetService("TweenService")
		local Debris = game:GetService("Debris")
		local kj = game:GetService("ReplicatedStorage").Resources.KJ

		local Ended = false
		local Anim = nil
		local FlashConnec = nil

		for _, v in character:FindFirstChildOfClass("Humanoid"):FindFirstChildOfClass("Animator"):GetPlayingAnimationTracks() do
			if v.Animation.AnimationId == id then
				Anim = v
				break
			end
		end
		if Anim == nil then return end

		local l_LinearVelocity = Instance.new("LinearVelocity")
		l_LinearVelocity.Attachment0 = RootPart.RootAttachment
		l_LinearVelocity.ForceLimitMode = Enum.ForceLimitMode.PerAxis
		l_LinearVelocity.MaxAxesForce = Vector3.new(math.huge, 0, math.huge)
		l_LinearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
		l_LinearVelocity.Parent = RootPart

		Anim:GetMarkerReachedSignal("Start"):Once(function()
			task.spawn(function()
				local jumpEmit = kj.Jump:Clone()
				jumpEmit.Parent = workspace.Effects
				jumpEmit.CFrame = RootPart.CFrame
				for _, v in jumpEmit:GetDescendants() do
					if v:IsA("ParticleEmitter") then v:Emit(4) end
				end
				Debris:AddItem(jumpEmit, 3)

				local clone = kj.startRun:Clone()
				clone.Parent = character

				TweenService:Create(l_LinearVelocity, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
					VectorVelocity = RootPart.CFrame.LookVector * 250
				}):Play()

				repeat
					clone.CFrame = clone.CFrame:Lerp(RootPart.CFrame, 0.5)
					task.wait()
				until Ended or not character:IsDescendantOf(game) or not Anim.IsPlaying

				if FlashConnec then FlashConnec:Disconnect() end

				for _, v in clone:GetDescendants() do
					if v:IsA("Beam") then
						TweenService:Create(v, TweenInfo.new(0.25), { Width0 = 0, Width1 = 0 }):Play()
					elseif v:IsA("ParticleEmitter") then
						v.Enabled = false
					end
				end
				Debris:AddItem(clone, 1)
			end)
		end)

		FlashConnec = Anim:GetMarkerReachedSignal("Flash"):Connect(function()
			local flashEmit = kj.flash:Clone()
			flashEmit.Parent = workspace.Effects
			flashEmit.CFrame = RootPart.CFrame
			for _, v in flashEmit:GetDescendants() do
				if v:IsA("ParticleEmitter") then v:Emit(1) end
			end
			Debris:AddItem(flashEmit, 2)
		end)

		Anim:GetMarkerReachedSignal("End"):Once(function()
			Ended = true
			if FlashConnec then FlashConnec:Disconnect() end
			local Tween = TweenService:Create(l_LinearVelocity, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				VectorVelocity = Vector3.zero
			})
			Tween:Play()
			Tween.Completed:Once(function()
				l_LinearVelocity:Destroy()
			end)
		end)

		Anim.Stopped:Once(function()
			if not Ended then
				Ended = true
				if FlashConnec then FlashConnec:Disconnect() end
				l_LinearVelocity:Destroy()
			end
		end)
	end,

	dropkick = function(Params)
		local character = Params.char
		local victim = Params.victim
		local id = Params.id

		local TweenService = game:GetService("TweenService")
		local Debris = game:GetService("Debris")
		local Players = game:GetService("Players")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local kj = ReplicatedStorage.Resources.KJ

		local RootPart = character:FindFirstChildOfClass("Humanoid").RootPart
		local Torso = character:FindFirstChild("Torso")
		local isInvolved = Players.LocalPlayer.Character == character or Players.LocalPlayer.Character == victim

		local Anim = nil
		for _, v in character:FindFirstChildOfClass("Humanoid"):FindFirstChildOfClass("Animator"):GetPlayingAnimationTracks() do
			if v.Animation.AnimationId == id then
				Anim = v
				break
			end
		end
		if Anim == nil then return end

		local Transparency = {}
		local Frame = nil
		local Beam = nil

		local function shake(frame, size)
			frame.Visible = true
			frame.Size = size
			local tween = TweenService:Create(frame, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
				Size = frame.Size,
			})
			tween:Play()
			tween.Completed:Wait()
		end

		if isInvolved then
			Frame = kj["20-20-20DropKick"]:Clone()
			Frame.Parent = Players.LocalPlayer.PlayerGui:FindFirstChild("PlaceHolder") or Players.LocalPlayer.PlayerGui
			Frame.Visible = false

			Anim:GetMarkerReachedSignal("1"):Once(function()
				if Frame then Frame.Visible = true; shake(Frame["1"], UDim2.new(0.35, 0, 0.5, 0)) end
			end)
			Anim:GetMarkerReachedSignal("2"):Once(function()
				if Frame then shake(Frame["2"], UDim2.new(0.35, 0, 0.5, 0)) end
			end)
			Anim:GetMarkerReachedSignal("3"):Once(function()
				if Frame then shake(Frame["3"], UDim2.new(0.35, 0, 0.5, 0)) end
			end)
			Anim:GetMarkerReachedSignal("4"):Once(function()
				if Frame then shake(Frame["4"], UDim2.new(0.95, 0, 0.59, 0)) end
			end)

			local windSound = Instance.new("Sound")
			windSound.SoundId = kj.dropkickWind.SoundId
			windSound.Parent = game:GetService("SoundService")
			windSound:Play()
			Debris:AddItem(windSound, 10)
		else
			local windSound = Instance.new("Sound")
			windSound.SoundId = kj.dropkickWind.SoundId
			windSound.Parent = RootPart
			windSound:Play()
			Debris:AddItem(windSound, 10)
		end

		Anim:GetMarkerReachedSignal("startDropKick"):Once(function()
			local kickline = kj.Kickline:Clone()
			kickline.Parent = workspace.Effects
			kickline.CFrame = CFrame.new(victim.Torso.Position, victim.Torso.Position + RootPart.CFrame.LookVector)
				* CFrame.Angles(0, -math.pi / 2, 0)
				* CFrame.new(0, -character:GetExtentsSize().Y / 2, 0)
			for _, v in kickline:GetDescendants() do
				if v:IsA("Beam") then
					TweenService:Create(v, TweenInfo.new(2), { TextureSpeed = 0.015 }):Play()
					TweenService:Create(v, TweenInfo.new(6.85), { Width0 = 0, Width1 = 0 }):Play()
				end
			end
			Debris:AddItem(kickline, 6.85)

			local air = kj.air:Clone()
			air.Parent = workspace.Effects
			local weldAir = Instance.new("Weld")
			weldAir.Part0 = Torso
			weldAir.Part1 = air
			weldAir.Parent = air
			weldAir.C0 = CFrame.new(0, -4, 0)
			for _, v in air:GetDescendants() do
				if v:IsA("ParticleEmitter") then
					TweenService:Create(v, TweenInfo.new(3), { TimeScale = 0.05 }):Play()
				end
			end
			Debris:AddItem(air, 5)

			local shockwave = kj.Shockwave:Clone()
			shockwave.Parent = workspace.Effects
			shockwave.CFrame = CFrame.new(character.Torso.Position, character.Torso.Position + RootPart.CFrame.LookVector)
			shockwave.Transparency = 0.85
			local weldShock = Instance.new("Weld")
			weldShock.Part0 = Torso
			weldShock.Part1 = shockwave
			weldShock.Parent = shockwave
			TweenService:Create(weldShock, TweenInfo.new(5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				C0 = CFrame.Angles(0, 2.094, 0) * CFrame.new(0, 2, 0),
			}):Play()
			TweenService:Create(shockwave, TweenInfo.new(5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				Size = Vector3.new(5, 10, 5),
				Transparency = 1,
			}):Play()
			Debris:AddItem(shockwave, 5)

			local bro = kj.BROPUTITURSELFT:Clone()
			bro.Parent = workspace.Effects
			bro.CFrame = CFrame.new(character.Torso.Position, character.Torso.Position + RootPart.CFrame.LookVector)
			local weldBro = Instance.new("Weld")
			weldBro.Part0 = Torso
			weldBro.Part1 = bro
			weldBro.Parent = bro
			weldBro.C0 = CFrame.new(0, 15, 0) * CFrame.Angles(0, 0, math.pi / 2)
			TweenService:Create(weldBro, TweenInfo.new(5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				C0 = CFrame.Angles(0, 2.094, math.pi / 2),
			}):Play()
			TweenService:Create(bro.Decal, TweenInfo.new(5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				Transparency = 1,
			}):Play()
			Debris:AddItem(bro, 5)
		end)

		Anim:GetMarkerReachedSignal("Kick"):Once(function()
			if isInvolved then
				Beam = kj.blackgroundbeam:Clone()
				Beam.Parent = workspace.Effects
				Beam.CFrame = CFrame.new(character.Torso.Position, character.Torso.Position + RootPart.CFrame.LookVector)
					* CFrame.new(-13, 12, -12)
					* CFrame.Angles(0, -math.pi / 2, 0)

				for _, v in workspace.Map:GetDescendants() do
					if v:IsA("BasePart") or v:IsA("Texture") or v:IsA("Decal") then
						if v.Transparency < 1 then
							Transparency[v] = v.Transparency
							v.Transparency = 1
							task.delay(7, function()
								if Transparency[v] ~= nil then
									v.Transparency = Transparency[v]
									Transparency[v] = nil
									if Beam and Beam.Parent then Beam:Destroy() end
								end
							end)
						end
					end
				end
			end
		end)

		Anim:GetMarkerReachedSignal("End"):Once(function()
			local jumpEmit = kj.Jump:Clone()
			jumpEmit.Parent = workspace.Effects
			jumpEmit.CFrame = RootPart.CFrame
			for _, v in jumpEmit:GetDescendants() do
				if v:IsA("ParticleEmitter") then v:Emit(4) end
			end
			Debris:AddItem(jumpEmit, 3)

			if Beam and Beam.Parent then Beam:Destroy() end
			for part, trans in Transparency do
				part.Transparency = trans
			end
			table.clear(Transparency)
			if Frame then Frame:Destroy() end
		end)
	end,

	tornado = function(Params)
		local character = Params.char

		local TweenService = game:GetService("TweenService")
		local Debris = game:GetService("Debris")
		local RunService = game:GetService("RunService")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")

		local HumRP = character:FindFirstChildOfClass("Humanoid").RootPart
		local Visuals = ReplicatedStorage.Assets.Visuals.Madara

		local TornadoClone = Visuals.Tornado:Clone()
		TornadoClone.Parent = workspace.Effects
		TornadoClone.CFrame = HumRP.CFrame * CFrame.new(0, 3, -5)

		for _, v in TornadoClone:GetDescendants() do
			if v:IsA("ParticleEmitter") then v.Enabled = true end
		end

		local RotationSpeed = math.random(-5, 5)
		local MoveSpeed = 15
		local TimeAlive = 0
		local Duration = 3
		local conn

		conn = RunService.Heartbeat:Connect(function(dt)
			TimeAlive = TimeAlive + dt
			TornadoClone.CFrame = TornadoClone.CFrame * CFrame.Angles(0, math.rad(RotationSpeed * dt), 0)
			TornadoClone.CFrame = TornadoClone.CFrame * CFrame.new(0, 0, -MoveSpeed * dt)

			if TimeAlive >= Duration then
				conn:Disconnect()
				for _, v in TornadoClone:GetDescendants() do
					if v:IsA("ParticleEmitter") then v.Enabled = false end
				end
				local tween = TweenService:Create(TornadoClone, TweenInfo.new(0.5), { Transparency = 1 })
				tween:Play()
				tween.Completed:Once(function()
					TornadoClone:Destroy()
				end)
			end
		end)

		Debris:AddItem(TornadoClone, Duration + 2)
	end,

