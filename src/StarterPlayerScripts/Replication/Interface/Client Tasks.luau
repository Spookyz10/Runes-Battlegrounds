						local info = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
						TweenService:Create(v, info, { Width0 = 0, Width1 = 0 }):Play()
					end
				end
				Debris:AddItem(clone, 0.3)
			end)
		end

		if Stage == "beam" then
			-- Eye glint on head
			emitAttachment(Eye.Emit:FindFirstChild("Eyeglint"), Head)

			-- Eye beam VFX welded to head
			applyEyeBeam(Character)

			-- Lightning burst at caster
			local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
			emitAttachment(Eye.Emit:FindFirstChild("Lightning"), HRP)

		elseif Stage == "hit" then
			emitAttachment(Eye.Emit:FindFirstChild("Hit"), EnemyTorso)
		end
	end,

