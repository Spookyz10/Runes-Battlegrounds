				Transparency = 1
			}):Play()

			Debris:AddItem(StompMesh2, 1)


			for i = 1, 2 do
				local Shock = Resources.Misc.Shock:Clone()
				Shock.Parent = workspace.Thrown
				Shock.CFrame = HumRP.CFrame * CFrame.Angles(1.5707963267948966, 0, 0) * CFrame.new(1.15, -4, 0)
