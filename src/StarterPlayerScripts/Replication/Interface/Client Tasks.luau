	Backhand = function(Params)
		local ringEffect = Resources.Effects.Ring:Clone()

		local clonedRing = ringEffect
		task.delay(Params.Time or 0.3, function()
			clonedRing:Destroy()
		end)

		if Params.Look then
			Params.CFrame = Params.Look.CFrame
			Params.Origin = Params.Look.CFrame + Params.Look.CFrame.lookVector
			if Params.Forward then
				Params.CFrame = Params.CFrame + Params.Look.CFrame.lookVector * Params.Forward
			end
		end

		if Params.Color then
			ringEffect.Color = Params.Color
		end

		ringEffect.Transparency = Params.Transparency or 0
		ringEffect.Size = Vector3.new(Params.Size or 2.589, Params.Initial or 0.896, Params.Size or 2.589)
		ringEffect.CFrame = CFrame.new(Params.CFrame.p, Params.Part and Params.Part.CFrame.p or Params.Origin.p) * CFrame.Angles(1.5707963267948966, 0, 0)
		ringEffect.Parent = workspace.Thrown

		if not Params.Add then
			Params.Add = 1
		end

		local tweenGoal = {
			Size = Vector3.new(9.874 * Params.Add, Params.NoScaleY and ringEffect.Size.Y or 0.1, 9.874 * Params.Add),
			Transparency = 1
		}

		if Params.Down then
			tweenGoal.Position = ringEffect.Position + Params.Down
		end

		TS:Create(ringEffect, TweenInfo.new(Params.Time or 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), tweenGoal):Play()
	end,
	
	Blood = function(Params)
		local cframe = Params.cframe
		local times = Params.times
		local force = Params.force
		local delay_per = Params.delay
		
		
		if cframe then
			if (UIS.GamepadEnabled and game:GetService("GuiService"):IsTenFootInterface()) or not BloodConfig.Value then
				return
			end

			force = force or 1

			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = {workspace.Map}

			for i = 1, times, 1 do
				local bloodclone = Resources.Effects.BloodParticle:Clone()
				bloodclone.Parent = workspace.Thrown
				bloodclone.CFrame = cframe.CFrame

				local raycast = workspace:Raycast(cframe.Position + Vector3.new(0, 10, 0), Vector3.new(0, -10000000, 0), params)

				if raycast then
					local xpos = math.random(-8, 8) * force
					local zpos = math.random(-8, 8) * force
					local ypos = math.random(8, 11) * force

					local bodyvelocity = Instance.new("BodyVelocity")
					bodyvelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
					bodyvelocity.P = math.huge
					bodyvelocity.Parent = bloodclone
					bodyvelocity.Velocity = cframe.Position.Unit + Vector3.new(xpos*2.75, ypos*3, zpos*2.75)
					Debris:AddItem(bodyvelocity, 0.1)

					local Render
					Render = RNS.Heartbeat:Connect(function()
						local hitraycast = workspace:Raycast(bloodclone.Position, Vector3.new(0, -0.5, 0), params)

						if hitraycast then
							if bloodclone.Parent then
								bloodclone:Destroy()
							end

							local v13118 = Instance.new("Part")
							v13118.CFrame = CFrame.new(hitraycast.Position)
							v13118.CFrame *= CFrame.Angles(0, 0, math.rad(90))
							v13118.Name = "BloodSplash"
							v13118.Anchored = true
							v13118.CanCollide = false
							v13118.CanTouch = false
							v13118.CanQuery = false
							v13118.Color = Color3.fromRGB(94, 0, 0)
							v13118.Shape = Enum.PartType.Cylinder
							v13118.Material = Enum.Material.Glass
							v13118.Transparency = 0
							v13118.Size = Vector3.zero
							v13118.Parent = workspace.Thrown
							Debris:AddItem(v13118, 4)

							local tween = TS:Create(v13118, TweenInfo.new(0.25, Enum.EasingStyle.Sine), {
								Size = (Vector3.new(0, math.random(1.5, 3.25), math.random(1.5, 3.25))) * 1
							})

							tween:Play()

							task.delay(0.75 + 3, function()
								local tween2 = TS:Create(v13118, TweenInfo.new(0.24, Enum.EasingStyle.Sine), {
									Size = Vector3.zero
								})
								tween2:Play()
							end)

							Render:Disconnect()
						end
					end)
				end

				if delay_per ~= 0 then
					task.wait(delay_per)
				end
			end
		end
	end,
	
