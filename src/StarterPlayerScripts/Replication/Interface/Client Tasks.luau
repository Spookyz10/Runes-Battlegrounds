			local RandomDivider = RandomSeed:NextInteger(10, 14)
			local DividedNumber = 6.283185307179586 / RandomDivider

			for i = 1, RandomDivider do
				local RockSize = RandomSeed:NextNumber(0.25, 0.75)

				local FloatingRock = AssetsFolder.FloatingRock:Clone()
				FloatingRock.CFrame = SpinParticlesOffset * CFrame.Angles(0, math.rad((RandomSeed:NextNumber(-180, 180))), 0) * CFrame.new(0, 0, -10)
				FloatingRock.Size = Vector3.new(RockSize, RockSize, RockSize)
				FloatingRock.Parent = workspace.Thrown

				ParticlesModule.Enabled(FloatingRock, true)


				local InfoTable = {}

				InfoTable.CurrentAngle = math.clamp((DividedNumber * i) + RandomSeed:NextNumber(0.012421, 0.75), 0, 6.283185307179586)
				InfoTable.LastPosition = FloatingRock.Position
				InfoTable.InverseAngleX = math.random(1, 2) == 1
				InfoTable.InverseAngleZ = math.random(1, 2) == 1
				InfoTable.InverseAngleY = math.random(1, 2) == 1
				InfoTable.YOffset = RandomSeed:NextNumber(-0.1, 0.1)
				InfoTable.TossDirection = Vector3.zero

				FloatingRocks[FloatingRock] = InfoTable
			end



			local StartTime = os.clock()
			local StepConnection = nil
			StepConnection = RNS.RenderStepped:Connect(function(DeltaTime)
				if os.clock() - StartTime > 0.66 then
					StepConnection:Disconnect()
					StepConnection = nil

					for Rock: Part, InfoTable in FloatingRocks do
						Rock.Anchored = false
						Rock.CanCollide = true
						Rock.AssemblyLinearVelocity = -InfoTable.TossDirection * 50
						Rock.AssemblyAngularVelocity = Vector3.new(RandomSeed:NextNumber(-30, 30), RandomSeed:NextNumber(-30, 30), RandomSeed:NextNumber(-30, 30))

						task.delay(1, function()
							TS:Create(Rock, TweenInfo.new(0.45), {
								Size = Vector3.zero
							}):Play()

							Debris:AddItem(Rock, 0.47)
						end)

						FloatingRocks[Rock] = nil
					end

				else
					for Rock, InfoTable in FloatingRocks do
						local MainAngle = (InfoTable.CurrentAngle + DeltaTime * 30) % 6.283185307179586
						local XAngle = InfoTable.InverseAngleX and -MainAngle or MainAngle
						local YAngle = InfoTable.InverseAngleY and -MainAngle or MainAngle
						local ZAngle = InfoTable.InverseAngleZ and -MainAngle or MainAngle

						InfoTable.CurrentAngle = MainAngle

						Rock.CFrame = CFrame.new(SpinParticlesOffset.Position) * CFrame.new(math.cos(MainAngle) * 10,  InfoTable.YOffset, math.sin(MainAngle) * 10) * CFrame.Angles(math.cos(XAngle), math.sin(YAngle), (math.sin(ZAngle)))

						InfoTable.TossDirection = (InfoTable.LastPosition - Rock.Position).Unit
						InfoTable.LastPosition = Rock.Position
					end
				end
			end)

		elseif Stage == "LegAura" then
			local speedlines = AssetsFolder["Left Leg"].speedlines:Clone()
			speedlines.Parent = Character['Left Leg']
			Debris:AddItem(speedlines, 0.5)

			local starries = AssetsFolder["Left Leg"].starries:Clone()
			starries.Parent = Character['Left Leg']
			Debris:AddItem(starries, 0.5)

		elseif Stage == "FinalKick" then
			local vfx = AssetsFolder.lastkick:Clone()
			vfx.Parent = EnemyCharacter
			vfx.CFrame = HumRP.CFrame
			ParticlesModule.Emit(vfx)
			Debris:AddItem(vfx, 2)

			local frame = AssetsFolder.lastkickframe:Clone()
			frame.Parent = EnemyCharacter
			frame.CFrame = HumRP.CFrame * CFrame.Angles(0, rad(-90), 0)
			TS:Create(frame.Mesh, TweenInfo.new(.25), { Scale = Vector3.new(1.5,.5,.5) }):Play()
			TS:Create(frame.Decal, TweenInfo.new(.25), { Transparency = 1 }):Play()
			Debris:AddItem(frame, 0.25)

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(9)

				task.delay(0.25, function()
					shared.addshake(10)
				end)
			end

		end
	end,

	-- Inside your Replication handler, this is the DistortionBreak case
	-- Follows the same Stage-based pattern as Ravage VFX

	DistortionBreak = function(Params)
		local Character: Model = Params.Char
		local HumRP: BasePart
		if Character then
			HumRP = Character.HumanoidRootPart
		end

		local EnemyCharacter: Model = Params.EChar
		local EnemyHumRP: BasePart
		if EnemyCharacter then
			EnemyHumRP = EnemyCharacter.HumanoidRootPart
		end

		local Stage = Params.Stage
		local AssetsFolder = Resources.GojoV2.Effects["Distortion Break"]
		local Punches = AssetsFolder.Hit.Punches

		-- Unique key per character so multiple players don't clash
		local CharId = Character.Name

		-- Helper: emit all ParticleEmitters in a part using their EmitCount attribute
		local function EmitPart(part)
			if not part then return end
			for _, v in part:GetDescendants() do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 1)
				end
			end
		end

		-- Helper: weld a VFX part to a base part and parent to workspace.Effects
		local function WeldVFX(vfxPart, basePart, offset)
			local w = Instance.new("Weld")
			w.Part0 = basePart
			w.Part1 = vfxPart
			w.C0 = offset or CFrame.new(0, 0, 0)
			w.Parent = basePart
			vfxPart.Parent = workspace.Effects
			return w
		end

		-- Find a stored DB VFX part in workspace.Effects by its unique name
		local function GetDBPart(tag)
			return workspace.Effects:FindFirstChild(CharId .. "_DB_" .. tag)
		end

		-- Clone, name uniquely, weld, and parent to workspace.Effects
		local function SpawnDBPart(tag, sourcePart, basePart, offset)
			local clone = sourcePart:Clone()
			clone.Name = CharId .. "_DB_" .. tag
			WeldVFX(clone, basePart, offset)
			return clone
		end


		if Stage == "Startup" then
			local JumpEmit = AssetsFolder.Startup.Jump.Emit.JumpEmit:Clone()
			WeldVFX(JumpEmit, HumRP)
			EmitPart(JumpEmit)
			Debris:AddItem(JumpEmit, 1)

			if Character == LocalCharacter then
				shared.addshake(2)
			end


		elseif Stage == "Hit" then
			local Left = Character["Left Arm"]

			local Punch1Emit      = SpawnDBPart("Punch1Emit",           Punches.Punch1Emit,           HumRP)
			local Punch2Emit      = SpawnDBPart("Punch2Emit",           Punches.Punch2Emit,           HumRP)
			local Punch3Emit      = SpawnDBPart("Punch3Emit",           Punches.Punch3Emit,           HumRP)
			local LeftArmPunch    = SpawnDBPart("LeftArmPunchEnable",   Punches.LeftArmPunchEnable,   Left)
			local PullEmit        = SpawnDBPart("PullEmit",             Punches.PullEmit,             HumRP)
			local KickPart1Emit   = SpawnDBPart("KickPart1Emit",        Punches.KickPart1Emit,        HumRP)
			local KickPart2Emit   = SpawnDBPart("KickPart2Emit",        Punches.KickPart2Emit,        HumRP)
			local GutPunchHitEmit = SpawnDBPart("GutPunchHitEmit",      Punches.GutPunchHitEmit,      HumRP)
			local KnockbackEmit   = SpawnDBPart("KnockbackEmit",        Punches.KnockbackEmit,        HumRP)
			local VictimLandEmit  = SpawnDBPart("VictimLandEmit",       Punches.VictimLandEmit,       HumRP)
			local DirtEnable      = SpawnDBPart("DirtEnable",           Punches.DirtEnable,           HumRP)
			local SpinEmit        = SpawnDBPart("SpinEmit",             Punches.SpinEmit,             HumRP)

			Debris:AddItem(Punch1Emit,      6)
			Debris:AddItem(Punch2Emit,      6)
			Debris:AddItem(Punch3Emit,      6)
			Debris:AddItem(LeftArmPunch,    6)
			Debris:AddItem(PullEmit,        6)
			Debris:AddItem(KickPart1Emit,   6)
			Debris:AddItem(KickPart2Emit,   6)
			Debris:AddItem(GutPunchHitEmit, 6)
			Debris:AddItem(KnockbackEmit,   6)
			Debris:AddItem(VictimLandEmit,  6)
			Debris:AddItem(DirtEnable,      6)
			Debris:AddItem(SpinEmit,        6)

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(3)
			end


		elseif Stage == "Punch" then
			EmitPart(GetDBPart("Punch1Emit"))
			EmitPart(GetDBPart("Punch2Emit"))

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(3)
			end


		elseif Stage == "Uppercut" then
			EmitPart(GetDBPart("Punch3Emit"))
			EmitPart(GetDBPart("LeftArmPunchEnable"))

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(3.5)
			end


		elseif Stage == "Pull" then
			EmitPart(GetDBPart("PullEmit"))

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(3)
			end


		elseif Stage == "Kick" then
			EmitPart(GetDBPart("KickPart1Emit"))
			EmitPart(GetDBPart("KickPart2Emit"))

			task.delay(0.5, function()
				EmitPart(GetDBPart("DirtEnable"))
				EmitPart(GetDBPart("SpinEmit"))
			end)

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(4)
			end


		elseif Stage == "GutPunch" then
			EmitPart(GetDBPart("GutPunchHitEmit"))

			local GutPunchHitStarsEnable = SpawnDBPart("GutPunchHitStarsEnable", Punches.GutPunchHitStarsEnable, HumRP)
			Debris:AddItem(GutPunchHitStarsEnable, 3)

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(4.5)
			end


		elseif Stage == "Knockback" then
			local Stars = GetDBPart("GutPunchHitStarsEnable")
			if Stars then
				for _, v in Stars:GetDescendants() do
					if v:IsA("ParticleEmitter") then
						v.Enabled = false
					end
				end
			end

			EmitPart(GetDBPart("KnockbackEmit"))

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(6)
			end


		elseif Stage == "VictimLand" then
			EmitPart(GetDBPart("VictimLandEmit"))

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(5)
			end

		end
	end,

	-- Inside your Replication handler, this is the RedReversal case
	-- Follows the same Stage-based pattern as Ravage VFX

	RedReversal = function(Params)
		local Character: Model = Params.Char
		local HumRP: BasePart
		if Character then
			HumRP = Character.HumanoidRootPart
		end

		local EnemyCharacter: Model = Params.EChar
		local EnemyHumRP: BasePart
		if EnemyCharacter then
			EnemyHumRP = EnemyCharacter.HumanoidRootPart
		end

		local Stage = Params.Stage
		local AssetsFolder = Resources.GojoV2.Effects["Red Reversal"]
		local GojoV2Anims = Resources.GojoV2.Animations

		local CharId = Character.Name

		local function EmitPart(part)
			if not part then return end
			for _, v in part:GetDescendants() do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 1)
				end
			end
		end

		local function WeldVFX(vfxPart, basePart, offset)
			local w = Instance.new("Weld")
			w.Part0 = basePart
			w.Part1 = vfxPart
			w.C0 = offset or CFrame.new(0, 0, 0)
			w.Parent = basePart
			vfxPart.Parent = workspace.Effects
			return w
		end

		local function GetRRPart(tag)
			return workspace.Effects:FindFirstChild(CharId .. "_RR_" .. tag)
		end

		local function SpawnRRPart(tag, sourcePart, basePart, offset)
			local clone = sourcePart:Clone()
			clone.Name = CharId .. "_RR_" .. tag
			WeldVFX(clone, basePart, offset)
			return clone
		end

		local function EnableParticles(part, enabled)
			if not part then return end
			for _, v in part:GetDescendants() do
				if v:IsA("ParticleEmitter") then
					v.Enabled = enabled
				end
			end
		end


		if Stage == "Startup" then
			-- Spawn and weld RunTeleportEffect, keep disabled until DashEffect stage
			local RunTeleportEffect = SpawnRRPart("RunTeleportEffect", AssetsFolder.RunTeleportEffect, HumRP)
			EnableParticles(RunTeleportEffect, false)
			Debris:AddItem(RunTeleportEffect, 6)


		elseif Stage == "DashEffect" then
			-- Enable dash trail particles
			local RunTeleportEffect = GetRRPart("RunTeleportEffect")
			EnableParticles(RunTeleportEffect, true)

			if Character == LocalCharacter then
				shared.addshake(2)
			end


		elseif Stage == "DashEnd" then
			-- No hit - disable dash particles
			local RunTeleportEffect = GetRRPart("RunTeleportEffect")
			EnableParticles(RunTeleportEffect, false)


		elseif Stage == "Hit" then
			-- Disable dash effect on hit
			local RunTeleportEffect = GetRRPart("RunTeleportEffect")
			EnableParticles(RunTeleportEffect, false)

			local Left = Character["Left Arm"]
			local Right = Character["Right Arm"]
			local Torso = EnemyCharacter and EnemyCharacter:FindFirstChild("Torso")

			-- RedHitEffect welded to victim torso
			if Torso then
				local RedHitEffect = SpawnRRPart("RedHitEffect", AssetsFolder.RedHit.RedHitEffect, Torso)
				Debris:AddItem(RedHitEffect, 6)
			end

			-- RedShoot welded to attacker HumRP
			local RedShoot = SpawnRRPart("RedShoot", AssetsFolder.Shoot.Emit.RedShoot, HumRP)
			Debris:AddItem(RedShoot, 6)

			-- SlamHit welded to attacker HumRP
			local SlamHit = SpawnRRPart("SlamHit", AssetsFolder.Slam.SlamHit, HumRP)
			Debris:AddItem(SlamHit, 6)

			-- BlackFlashEmit welded to attacker HumRP
			local BlackFlashEmit = SpawnRRPart("BlackFlashEmit", AssetsFolder.BlackFlash.BlackFlashEmit, HumRP)
			Debris:AddItem(BlackFlashEmit, 6)

			-- BlackFlashKnockback welded to attacker HumRP
			local BlackFlashKnockback = SpawnRRPart("BlackFlashKnockback", AssetsFolder.Knockback.Emit.BlackFlashKnockback, HumRP)
			Debris:AddItem(BlackFlashKnockback, 6)

			-- Land welded to attacker HumRP with forward offset
			local Land = SpawnRRPart("Land", AssetsFolder.Land.Emit.Land, HumRP, CFrame.new(0, 0, 8))
			Debris:AddItem(Land, 8)

			-- GlintHandEmit welded to Left arm
			local GlintHandEmit = SpawnRRPart("GlintHandEmit", AssetsFolder.Glint.Emit.GlintHandEmit, Left, CFrame.new(0, -1, 0))
			Debris:AddItem(GlintHandEmit, 6)

			-- ChargeHand spawns after 1 second on Left arm
			task.delay(1, function()
				if not Character:IsDescendantOf(workspace) then return end
				local ChargeHand = SpawnRRPart("ChargeHand", AssetsFolder.Glint.Enabled.ChargeHand, Left)
				Debris:AddItem(ChargeHand, 5)
				EmitPart(GetRRPart("GlintHandEmit"))
			end)

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(3)
			end


		elseif Stage == "RedHit" then
			-- Destroy ChargeHand and GlintHandEmit
			local ChargeHand = GetRRPart("ChargeHand")
			if ChargeHand then ChargeHand:Destroy() end
			local GlintHandEmit = GetRRPart("GlintHandEmit")
			if GlintHandEmit then GlintHandEmit:Destroy() end

			-- Spawn and animate the Red ball, emit RedShoot
			local Red = AssetsFolder.Red:Clone()
			Red.Name = CharId .. "_RR_Red"
			WeldVFX(Red, HumRP, CFrame.new(0, 0, 0) * CFrame.Angles(0, math.pi, 0))
			Debris:AddItem(Red, 6)

			-- Play ball animation via AnimationController
			local AnimationController = Red:FindFirstChildWhichIsA("AnimationController", true)
			if AnimationController then
				local BallAnim = GojoV2Anims.StrongestRedReversalBall
				local BallTrack = AnimationController:LoadAnimation(BallAnim)
				BallTrack:Play()
			end

			EmitPart(GetRRPart("RedShoot"))

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(3.5)
			end


		elseif Stage == "Slam" then
			EmitPart(GetRRPart("SlamHit"))

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(5)
			end


		elseif Stage == "RedHit2" then
			EmitPart(GetRRPart("RedHitEffect"))

			-- Disable Red ball particles
			local Red = workspace.Effects:FindFirstChild(CharId .. "_RR_Red")
			EnableParticles(Red, false)

			-- Spawn CursedEnergyEnable on Right arm after 0.5s
			task.delay(0.5, function()
				if not Character:IsDescendantOf(workspace) then return end
				local Right = Character:FindFirstChild("Right Arm")
				if not Right then return end
				local CursedEnergyEnable = SpawnRRPart("CursedEnergyEnable", AssetsFolder.CursedEnergy.CursedEnergyEnable, Right)
				Debris:AddItem(CursedEnergyEnable, 4)
			end)

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(4)
			end


		elseif Stage == "BlackFlash" then
			-- Destroy CursedEnergyEnable
			local CursedEnergyEnable = GetRRPart("CursedEnergyEnable")
			if CursedEnergyEnable then CursedEnergyEnable:Destroy() end

			-- Spawn BlackFlashRoot
			local BlackFlashRoot = SpawnRRPart("BlackFlashRoot", AssetsFolder.BlackFlash.BlackFlashRoot, HumRP)
			Debris:AddItem(BlackFlashRoot, 4)

			EmitPart(GetRRPart("BlackFlashEmit"))

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(10)
			end


		elseif Stage == "Knockback" then
			-- Disable BlackFlashRoot particles
			EnableParticles(GetRRPart("BlackFlashRoot"), false)

			EmitPart(GetRRPart("BlackFlashKnockback"))

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(6)
			end


		elseif Stage == "Crater" then
			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(7)
			end


		elseif Stage == "Land" then
			EmitPart(GetRRPart("Land"))

			if Character == LocalCharacter or EnemyCharacter == LocalCharacter then
				shared.addshake(4)
			end

		end
	end,

