	turbosavage = function(Params)
		local Character: Model = Params.Char
		local HumRP: BasePart = Character.HumanoidRootPart

		local AssetsFolder = Resources.Okarun.savage
		local Stage = Params.Stage


		if Stage == "Start" then
			local Bind: Accessory = Character:WaitForChild(Params.BindName, 5)
			if not Bind then return end


			local DelayedThreads = {}

			local RunVelocity = Instance.new("LinearVelocity")
			RunVelocity.Attachment0 = HumRP.RootAttachment
			RunVelocity.ForceLimitMode = Enum.ForceLimitMode.PerAxis
			RunVelocity.MaxAxesForce = Vector3.new(1, 0, 1) * 30000
			RunVelocity.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
			RunVelocity.Parent = HumRP
			RunVelocity.VectorVelocity = Vector3.zero

			TS:Create(RunVelocity, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
				VectorVelocity = Vector3.zAxis * -5
			}):Play()

			Debris:AddItem(RunVelocity, 8.2)


			local TurboGranny = AssetsFolder.TurboGranny:Clone()
			TurboGranny.Parent = Character
			TurboGranny.AnimationController.Animator:LoadAnimation(TurboGranny.Savage):Play(0)

			local runStep = nil
			runStep = RNS.PreRender:Connect(function(deltaTime)
				if not TurboGranny or not TurboGranny.Parent or not TurboGranny:FindFirstChild("Cube.001") then
					runStep:Disconnect()

					return
				end

				TurboGranny["Cube.001"].CFrame = TurboGranny["Cube.001"].CFrame:Lerp(HumRP.CFrame * CFrame.new(0, 3, 10) * CFrame.Angles(0, 3.141592653589793, 0), deltaTime * 20)
			end)

			Debris:AddItem(TurboGranny, 9.85)

			task.delay(9, function()
				if not Bind then return end

				for _,v in TurboGranny:GetChildren() do 
					if v:IsA("Part") or v:IsA("MeshPart") then
						TS:Create(v, TweenInfo.new(0.85), { Transparency = 1 }):Play()
					end
				end
			end)

			task.delay(9.85, function()
				if not Bind then return end

				runStep:Disconnect()
			end)


			for Index, delayTime in { 1.1, 1.583, 2.05, 2.567, 3.233, 3.55, 4, 4.383, 4.7 } do
				table.insert(DelayedThreads, task.delay(delayTime, function()
					if not Bind then return end


					local Leg: BasePart
					if Index == 1 or Index % 2 ~= 0 then
						Leg = Character["Right Leg"]
					else
						Leg = Character["Left Leg"]
					end

					local groundRay = raycast(Leg.Position, Vector3.new(0, -7.5, 0), MapRayParams)
					if groundRay then
						local step = AssetsFolder.step:Clone()
						step.Position = groundRay.Position
						step.Parent = workspace.Thrown
						ParticlesModule.Emit(step)
						Debris:AddItem(step, 3)
					end


					if Character == LocalCharacter or (HumRP.Position - LocalCharacter:GetPivot().Position).Magnitude <= 60 then
						shared.addshake(2.5, 0.25)
					end
				end))
			end


			Bind.Destroying:Once(function()
				Bind = nil


				for _, thread: thread in DelayedThreads do
					pcall(task.cancel, thread)
				end

				if runStep then
					runStep:Disconnect()
				end

				if RunVelocity and RunVelocity.Parent then
					RunVelocity:Destroy()
				end

				if TurboGranny and TurboGranny.Parent then
					for _,v in TurboGranny:GetChildren() do 
						if v:IsA("Part") or v:IsA("MeshPart") then
							TS:Create(v, TweenInfo.new(0.85), { Transparency = 1 }):Play()
						end
					end

					Debris:AddItem(TurboGranny, 0.85)
				end
			end)


			task.wait(2.55)


			if not Bind then return end

			TS:Create(RunVelocity, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
				VectorVelocity = Vector3.new(0, 0, -50)
			}):Play()


			task.wait(2)


			if not Bind then return end

			local Emitline = AssetsFolder.Emitline:Clone()
			Emitline.CFrame = HumRP.CFrame
			Emitline.Parent = workspace.Thrown
			ParticlesModule.Emit(Emitline)
			Debris:AddItem(Emitline, 5)


			if Character == LocalCharacter or (HumRP.Position - LocalCharacter:GetPivot().Position).Magnitude <= 60 then
				shared.addshake(2.5, 0.25)
			end


			TS:Create(RunVelocity, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
				VectorVelocity = Vector3.zAxis * -100
			}):Play()


			local Speedlines = AssetsFolder.Speedlines:Clone()
			Speedlines.Parent = Character
			Debris:AddItem(Speedlines, 2.65)

			local SpeedlinesWeld = Instance.new("Weld")
			SpeedlinesWeld.Part0 = HumRP
			SpeedlinesWeld.Part1 = Speedlines
			SpeedlinesWeld.Parent = Speedlines


			task.wait(2.65)


			if not Bind then return end

			if Character == LocalCharacter or (HumRP.Position - LocalCharacter:GetPivot().Position).Magnitude <= 60 then
				shared.addshake(2.5, 0.25)
			end


			RunVelocity.VectorVelocity = Vector3.zAxis * -250
			TS:Create(RunVelocity, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				VectorVelocity = Vector3.zero
			}):Play()


			task.wait(1)


			if not Bind then return end

			RunVelocity:Destroy()


			if Character == LocalCharacter or (HumRP.Position - LocalCharacter:GetPivot().Position).Magnitude <= 60 then
				shared.addshake(2.5, 0.75)
			end


			local groundRay = raycast(HumRP.Position, Vector3.new(0, -7.5, 0), MapRayParams)
			if groundRay then
				local Land = AssetsFolder.Land:Clone()
				Land.Position = groundRay.Position
				Land.Parent = workspace.Thrown
				ParticlesModule.Emit(Land)
				Debris:AddItem(Land, 5)
			end

		elseif Stage == "Hit" then
			local EnemyCharacter: Model = Params.EChar

			local Player = Players:GetPlayerFromCharacter(Character)
			local EnemyPlayer = Players:GetPlayerFromCharacter(EnemyCharacter)


			if LocalPlayer == Player or LocalPlayer == EnemyPlayer then
				shared.triggerHotbar(false)
				shared.triggerAwkbar(false)

				CameraHandler:PlayCameraAnimation("TurboSavage", HumRP, nil, true)
				CameraTableAnims:PlayAnimation("TurboSavage")

				SoundAssets.TurboSavageHit.TimePosition = 0
				SoundAssets.TurboSavageHit:Play()

				local TurboGranny = Character:FindFirstChild("TurboGranny")
				if TurboGranny then
					TurboGranny:Destroy()
				end

			else
				SoundsModule:AddSound(SoundAssets.TurboSavageHit, HumRP)

			end


			local Emit2 = AssetsFolder.Emit["2"]:Clone()
			Emit2.Parent = Character

			local Emit2Weld = Instance.new("Weld")
			Emit2Weld.Part0 = Character.Head
			Emit2Weld.Part1 = Emit2
			Emit2Weld.C0 = CFrame.Angles(0, -1.5707963267948966, 0)
			Emit2Weld.Parent = Emit2

			ParticlesModule.Emit(Emit2)
			Debris:AddItem(Emit2, 5.7)


			local SK = AssetsFolder.SK:Clone()
			SK.Parent = Character
			SK:PivotTo(HumRP.CFrame)
			Debris:AddItem(SK, 8.7)

			EnemyCharacter["Left Arm"].Transparency = 1

			local FakeArm = AssetsFolder.FakeArm:Clone()
			FakeArm.Parent = Character

			local FakeArmWeld = Instance.new("Weld")
			FakeArmWeld.Part0 = Character.Head
			FakeArmWeld.Part1 = FakeArm.Head
			FakeArmWeld.Parent = FakeArm

			if EnemyCharacter:FindFirstChildOfClass("Shirt") then
				EnemyCharacter:FindFirstChildOfClass("Shirt"):Clone().Parent = FakeArm.Leftarm
				FakeArm.Leftarm["Left Arm"].Color = EnemyCharacter["Left Arm"].Color
			end

			Debris:AddItem(FakeArm, 2.7)


			task.wait(2.7)


			ParticlesModule.Emit(SK.TP)
			ParticlesModule.Emit(SK.TP2)
			ParticlesModule.Enabled(SK.AURA, true)


			SK:PivotTo(HumRP.CFrame)


			task.wait(1.15)


			SK:PivotTo(HumRP.CFrame)


			task.delay(0.1, function()
				ParticlesModule.Emit(SK.Step)

				task.delay(0.11, function()
					ParticlesModule.Emit(SK.Step2)

					task.delay(0.11, function()
						ParticlesModule.Emit(SK.Step3)

					end)
				end)
			end)


			ParticlesModule.Enabled(SK.AURA, false)


			local flash = AssetsFolder.flash:Clone()
			flash.Parent = Character

			local flashWeld = Instance.new("Weld")
			flashWeld.Part0 = Character["Left Leg"]
			flashWeld.Part1 = flash
			flashWeld.Parent = flash

			ParticlesModule.Enabled(flash, true)
			Debris:AddItem(flash, 3.35)


			local humRPCF = HumRP.CFrame


			task.wait(1.35)


			ParticlesModule.Enabled(flash, false)


			SK:PivotTo(humRPCF * CFrame.Angles(0, rad(-90), 0))


			ParticlesModule.Emit(SK.Kick)


			if LocalPlayer == Player or LocalPlayer == EnemyPlayer then
				task.delay(0.5, function()
					shared.triggerHotbar(true)
					shared.triggerAwkbar(true)
				end)

				shared.ActivateiFrames("turbosavage")
			end


			task.wait(0.5)


			if Character == LocalCharacter or EnemyCharacter == LocalCharacter or (HumRP.Position - LocalCharacter:GetPivot().Position).Magnitude <= 60 then
				shared.addshake(2.5, 0.75)
			end

			EnemyCharacter["Left Arm"].Transparency = 0
			Debris:AddItem(SK, 3)
		end
	end,

	turborush = function(Params)
		local Character: Model = Params.Char
		local HumRP: BasePart, Humanoid: Humanoid
		if Character then
			HumRP = Character.HumanoidRootPart
			Humanoid = Character.Humanoid
		end

		local EnemyCharacter: Model = Params.EChar
		local EnemyHumRP: BasePart, EnemyHead: BasePart, EnemyTorso: BasePart, EnemyHumanoid: Humanoid
		if EnemyCharacter then
			EnemyHumRP = EnemyCharacter.HumanoidRootPart
			EnemyHead = EnemyCharacter.Head
			EnemyTorso = EnemyCharacter.Torso
			EnemyHumanoid = EnemyCharacter.Humanoid
		end


		local Stage = Params.Stage
		local AssetsFolder = Resources.Okarun.rush

		if Stage == "FlashStep" then
			local FlashStep = AssetsFolder.FlashStep:Clone()
			FlashStep.Parent = Character
			FlashStep.CFrame = HumRP.CFrame * CFrame.new(0, -2.5, 0)
			Debris:AddItem(FlashStep, 4.5)

			local CFrameStep = RNS.PreRender:Connect(function(deltaTime)
				FlashStep.CFrame = FlashStep.CFrame:Lerp(HumRP.CFrame, deltaTime * 15)
			end)


			task.delay(1.5, function()
				CFrameStep:Disconnect()

				for _, ParticleEmitter in FlashStep:GetDescendants() do
					if ParticleEmitter:IsA("ParticleEmitter") then
						ParticleEmitter.Enabled = false
					end
				end
			end)


			for RockValue = 1, 3 do
				local Position = {
					Seed = math.random(1, 8) + RockValue, 
					start = HumRP.Position + Vector3.new(0, 0.10000000149011612, 0, 0), 
					["end"] = Vector3.new(0, -14, 0, 0), 
					amount = 3 + RockValue / 2, 
					nosound = true, 
					nosmoke = RockValue > 2
				}

				local minusValue = false
				if RockValue <= 2 then
					minusValue = {
						minus = 0
					}
				end

				Position.stronger = minusValue
				Position.sizemult = 0.55 * RockValue
				Position.size = 0.85 * RockValue

				shared.repfire('Ground Crater', Position)
			end


			if Character == LocalCharacter then
				shared.addshake(5, 0.55)
			end

		elseif Stage == "TP" then
			local MainCF: CFrame = Params.MainCF


			local PunchImpact2 = Resources.Okarun.rush.PunchImpact2:Clone()
			PunchImpact2.CFrame = MainCF
			PunchImpact2.Parent = workspace.Thrown
			ParticlesModule.Emit(PunchImpact2)
			Debris:AddItem(PunchImpact2, 3)


			local Cylinder = Resources.Okarun.rush.Cylinder:Clone()
			Cylinder.Parent = workspace.Thrown
			Cylinder.CFrame = MainCF

			TS:Create(Cylinder, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				Transparency = 1,
				Size = Vector3.new(50, 50, 150),
				CFrame = Cylinder.CFrame * CFrame.new(0, 0, -65) * CFrame.Angles(0, 0, 3.141592653589793)
			}):Play()

			Debris:AddItem(Cylinder, 1)


			BodyPositionForwardVelocity(HumRP, 15, 0.3, { 0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out }, { D = 2500, P = 500 })

			if Character == LocalCharacter then
				shared.addshake(5, 0.55)
			end

		elseif Stage == "Weld" then
			local Connections = {}

			local function DestroyWeld()
				for _,v in Connections do
					v:Disconnect()
				end
			end


			table.insert(Connections, RNS.PreRender:Connect(function()
				EnemyHumRP.CFrame = HumRP.CFrame * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.pi, 0)
			end))

			table.insert(Connections, Humanoid.Died:Once(DestroyWeld))
			table.insert(Connections, EnemyHumanoid.Died:Once(DestroyWeld))

			table.insert(Connections, Character.Destroying:Once(DestroyWeld))
			table.insert(Connections, EnemyCharacter.Destroying:Once(DestroyWeld))


			task.delay(8.5, function()
				DestroyWeld()
			end)

		elseif Stage == "StartUp1" then
			if Character == LocalCharacter or (HumRP.Position - LocalCharacter:GetPivot().Position).Magnitude <= 15 then
				shared.addshake(5, 1.15)
			end


