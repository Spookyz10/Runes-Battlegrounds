	-- Client-side replication handler for Upper Slash
	-- ["UpperSlash"] = function(Params) ... end

	UpperSlash = function(Params)
		local Character: Model = Params.Char
		local Humanoid: Humanoid = Character.Humanoid
		local HumRP: BasePart = Character.HumanoidRootPart

		local Stage = Params.Stage

		local UpperAssets = RS.Resources.Vergil.UpperSlash

		local isAttacker = LocalPlayer == Players:GetPlayerFromCharacter(Character)
		local isVictim   = Params.Victim and LocalPlayer == Players:GetPlayerFromCharacter(Params.Victim)
		local isInvolved = isAttacker or isVictim

		local function emitAll(parent)
			if not parent then return end
			for _, v in parent:GetDescendants() do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 1)
				end
			end
		end

		local function weldTo(part, target)
			local w = Instance.new("ManualWeld", part)
			w.Part0 = target
			w.Part1 = part
			w.C0 = CFrame.new(0, 0, 0)
			return w
		end


		-- // STAGE: "pa" — Anim starts; spawn arm VFX immediately \\ --

		if Stage == "pa" then

			local rightArm = Character:FindFirstChild("Right Arm")
			local leftArm  = Character:FindFirstChild("Left Arm")
			if not rightArm or not leftArm then return end

			local RA = UpperAssets["Right Arm"]:Clone()
			RA.Parent = rightArm
			RA.CFrame = rightArm.CFrame
			weldTo(RA, rightArm)

			local LA = UpperAssets["Left Arm"]:Clone()
			LA.Parent = leftArm
			LA.CFrame = leftArm.CFrame
			weldTo(LA, leftArm)

			-- Store refs by name so later stages can clean up
			RA.Name = "UpperSlash_RA_" .. Character.Name
			LA.Name = "UpperSlash_LA_" .. Character.Name

			if isAttacker then
				shared.repfire("ShakeCamera", { Magnitude = 3, Roughness = 8, FadeInTime = 0, FadeOutTime = 0.2 })
			end


			-- // STAGE: "hit" — Enemy hit; blood VFX \\ --

		elseif Stage == "hit" then
			local Victim: Model = Params.Victim
			local VictimHumRP = Victim and Victim:FindFirstChild("HumanoidRootPart")

			local blood = UpperAssets.HitBlood.Blood:Clone()
			blood.Parent = VictimHumRP or HumRP
			task.delay(0.02, function()
				emitAll(blood)
			end)
			Debris:AddItem(blood, 2)

			if isInvolved then
				shared.repfire("ShakeCamera", { Magnitude = 10, Roughness = 16, FadeInTime = 0, FadeOutTime = 0.45 })
				TS:Create(CurrentCamera, TweenInfo.new(0.08), { FieldOfView = 88 }):Play()
				task.delay(0.08, function()
					TS:Create(CurrentCamera, TweenInfo.new(0.35), { FieldOfView = 70 }):Play()
				end)
			end


			-- // STAGE: "slash_fx" — Main UpperSlash VFX + Shaker \\ --

		elseif Stage == "slash_fx" then

			-- UpperSlash VFX
			local UpperSlashFX = UpperAssets.UpperSlash:Clone()
			UpperSlashFX.Parent = workspace
			UpperSlashFX.CFrame = HumRP.CFrame * CFrame.Angles(0, math.rad(-90), 0)
			task.delay(0.02, function()
				emitAll(UpperSlashFX)
			end)
			Debris:AddItem(UpperSlashFX, 2)

			if isInvolved then
				shared.repfire("ShakeCamera", { Magnitude = 14, Roughness = 18, FadeInTime = 0, FadeOutTime = 0.5 })

				game.Lighting.Blur.Size = 12
				TS:Create(game.Lighting.Blur, TweenInfo.new(0.4), { Size = 0 }):Play()

				TS:Create(CurrentCamera, TweenInfo.new(0.08), { FieldOfView = 90 }):Play()
				task.delay(0.08, function()
					TS:Create(CurrentCamera, TweenInfo.new(0.4), { FieldOfView = 70 }):Play()
				end)
			end


			-- // STAGE: "idk_fx" — Destroy arms, spawn idk on left arm, fade out \\ --

		elseif Stage == "idk_fx" then
			local leftArm = Character:FindFirstChild("Left Arm")

			-- Destroy arm VFX parts
			local ra = Character:FindFirstChild("UpperSlash_RA_" .. Character.Name, true)
			local la = Character:FindFirstChild("UpperSlash_LA_" .. Character.Name, true)
			if ra then ra:Destroy() end
			if la then la:Destroy() end

			-- Spawn idk on left arm
			if leftArm then
				local idk = UpperAssets.idk:Clone()
				idk.Parent = leftArm
				idk.CFrame = leftArm.CFrame
				Debris:AddItem(idk, 1.75)
				weldTo(idk, leftArm)

				-- Fade out after 0.75s
				task.delay(0.75, function()
					for _, particle in idk:GetDescendants() do
						if particle:IsA("BasePart") then
							TS:Create(particle, TweenInfo.new(0.4), { Transparency = 1 }):Play()
						end
					end
				end)
			end

		end
	end,

	-- Client-side replication handler for Slash Barrage
	-- ["SlashBarrage"] = function(Params) ... end

	SlashBarrage = function(Params)
		local Character: Model = Params.Char
		local Humanoid: Humanoid = Character.Humanoid
		local HumRP: BasePart = Character.HumanoidRootPart

		local Stage = Params.Stage

		local BarrageAssets = RS.Resources.Vergil.Barrage

		local isAttacker = LocalPlayer == Players:GetPlayerFromCharacter(Character)
		local isVictim   = Params.Victim and LocalPlayer == Players:GetPlayerFromCharacter(Params.Victim)
		local isInvolved = isAttacker or isVictim

		local function emitAll(parent)
			if not parent then return end
			for _, v in parent:GetDescendants() do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 1)
				end
			end
		end

		local function weldTo(part, target, offset, angles)
			local w = Instance.new("ManualWeld", part)
			w.Part0 = target
			w.Part1 = part
			w.C0 = (offset or CFrame.new()) * (angles and CFrame.Angles(0, math.rad(angles), 0) or CFrame.new())
			return w
		end


		-- // STAGE: "pa" — Anim starts; spawn arm VFX + sound \\ --

		if Stage == "pa" then
			local rightArm = Character:FindFirstChild("Right Arm")
			local leftArm  = Character:FindFirstChild("Left Arm")
			if not rightArm or not leftArm then return end

			local RA = BarrageAssets["Right Arm"]:Clone()
			RA.Parent = rightArm
			RA.CFrame = rightArm.CFrame
			weldTo(RA, rightArm)
			RA.Name = "SlashBarrage_RA_" .. Character.Name

			local LA = BarrageAssets["Left Arm"]:Clone()
			LA.Parent = leftArm
			LA.CFrame = leftArm.CFrame
			weldTo(LA, leftArm)
			LA.Name = "SlashBarrage_LA_" .. Character.Name

			if isAttacker then
				TS:Create(CurrentCamera, TweenInfo.new(0.15), { FieldOfView = 80 }):Play()
				task.delay(0.15, function()
					TS:Create(CurrentCamera, TweenInfo.new(0.3), { FieldOfView = 70 }):Play()
				end)
			end


			-- // STAGE: "barrage_fx" — Slashh VFX welded to HRP \\ --

		elseif Stage == "barrage_fx" then
			local SlashB = BarrageAssets.Slashh:Clone()
			SlashB.Parent = workspace
			SlashB.CFrame = HumRP.CFrame

			local w = Instance.new("ManualWeld", SlashB)
			w.Part0 = HumRP
			w.Part1 = SlashB
			w.C0 = CFrame.new(0, 0, 1) * CFrame.Angles(0, math.rad(-90), 0)

			-- Enable particles for 2.35s then disable
			for _, part in SlashB:GetDescendants() do
				if part:IsA("ParticleEmitter") then
					part.Enabled = true
					task.delay(2.35, function()
						if part and part.Parent then
							part.Enabled = false
						end
					end)
				end
			end

			SlashB.Name = "SlashBarrage_Slashh_" .. Character.Name
			Debris:AddItem(SlashB, 4)

			if isAttacker then
				shared.repfire("ShakeCamera", { Magnitude = 5, Roughness = 12, FadeInTime = 0, FadeOutTime = 2.4 })
			end


			-- // STAGE: "barrage_hit" — Per-tick hit; blood + random hit anim \\ --

		elseif Stage == "barrage_hit" then
			local Victim: Model = Params.Victim
			local VictimHumRP = Victim and Victim:FindFirstChild("HumanoidRootPart")
			local VictimHumanoid = Victim and Victim:FindFirstChildOfClass("Humanoid")

			if VictimHumRP then
				local blood = BarrageAssets.HitBlood.Blood:Clone()
				blood.Parent = VictimHumRP
				task.delay(0.02, function() emitAll(blood) end)
				Debris:AddItem(blood, 2)
			end

			-- Play random Hit1/Hit2 anim on victim locally
			if VictimHumanoid and isVictim then
				local animRef = math.random(1, 2) == 1 and BarrageAssets.Hit1 or BarrageAssets.Hit2
				if animRef then
					local hitTrack = VictimHumanoid.Animator:LoadAnimation(animRef)
					hitTrack:Play()
				end
			end


			-- // STAGE: "last_slash_fx" — LastSlash VFX + white + Shaker2 \\ --

		elseif Stage == "last_slash_fx" then
