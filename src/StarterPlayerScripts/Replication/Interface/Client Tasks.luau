	DioTimestop = function(Params)
		local Stage     = Params.Stage
		local Character = Params.char

		local TweenService = game:GetService("TweenService")
		local Debris       = game:GetService("Debris")
		local Lighting     = game:GetService("Lighting")
		local Players      = game:GetService("Players")
		local LocalPlayer  = Players.LocalPlayer

		local isOwner = Character and LocalPlayer.Character == Character

		local Timestop = Resources["Dio"].Timestop
		local hrpCF    = Params.hrpCF
		local HRP      = Character and Character:FindFirstChild("HumanoidRootPart")

		local function emitAttachment(template, parent)
			if not template or not parent then return end
			local clone = template:Clone()
			clone.Parent = parent
			for _, v in ipairs(clone:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					v:Emit(v:GetAttribute("EmitCount") or 25)
				end
			end
			Debris:AddItem(clone, 1)
		end

		local function applyBW(duration)
			local existing = Lighting:FindFirstChild("TimeStopFilter")
			if existing then existing:Destroy() end
			local cc = Instance.new("ColorCorrectionEffect")
			cc.Name       = "TimeStopFilter"
			cc.Saturation = 0
			cc.Parent     = Lighting
			TweenService:Create(cc, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Saturation = -1 }):Play()
		end

		local function removeBW(duration)
			local existing = Lighting:FindFirstChild("TimeStopFilter")
			if not existing then return end
			local tween = TweenService:Create(existing, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { Saturation = 0 })
			tween:Play()
			tween.Completed:Once(function() existing:Destroy() end)
		end

		local function camZoom(targetFOV, time)
			if not isOwner then return end
			local Camera = workspace.CurrentCamera
			TweenService:Create(Camera, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = targetFOV }):Play()
		end

		-- ── Stages ────────────────────────────────────────────────────────

		if Stage == "startup" then
			-- TW sound on animation start (owner only)
			if isOwner then
				local sfx = Timestop:FindFirstChild("Tw")
				if sfx then
					local clone = sfx:Clone()
					clone.Parent = HRP
					clone:Play()
					Debris:AddItem(clone, 7)
				end
			end

		elseif Stage == "stop" then
			-- Timestop sound + VFX + B&W for everyone
			local sfx = Timestop:FindFirstChild("Timestop")
			if sfx and HRP then
				local clone = sfx:Clone()
				clone.Parent = HRP
				clone:Play()
				Debris:AddItem(clone, 7)
			end

			emitAttachment(Timestop.Emit:FindFirstChild("Timestop"), HRP)
			applyBW(1)

			-- FOV punch for owner
			if isOwner then
				local defaultFOV = workspace.CurrentCamera.FieldOfView
				camZoom(90, 0.1)
				task.wait(0.1)
				camZoom(defaultFOV, 0.3)
			end

		elseif Stage == "end" then
			-- End sound + remove B&W
			local sfx = Timestop:FindFirstChild("End")
			if sfx and HRP then
				local clone = sfx:Clone()
				clone.Parent = HRP
				clone:Play()
				Debris:AddItem(clone, 7)
			end

			task.wait(2)
			removeBW(1)
		end
	end,

