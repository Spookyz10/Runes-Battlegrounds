	LightAxes = function(Params) -- client task btw
		local Character = Params.char
		local HRP = Character.HumanoidRootPart
		local Humanoid = Character.Humanoid

		local effectsFolder = workspace.Effects
		local Assets = Resources.LightAxes

		local function PlaySound(soundName, parent, speed)
			local sound = Assets:FindFirstChild(soundName)
			if not sound then return end
			local s = sound:Clone()
			if speed then s.PlaybackSpeed = speed end
			s.Parent = parent
			s:Play()
			game.Debris:AddItem(s, s.TimeLength)
			return s
		end

		local function EmitDescendants(Object, Count)
			for _, v in pairs(Object:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					task.delay(v:GetAttribute("EmitDelay") or 0, function()
						v:Emit(Count or v:GetAttribute("EmitCount") or 30)
					end)
				end
			end
		end

		local function DisableTrails(Object, Destroy)
			for _, v in pairs(Object:GetDescendants()) do
				if v:IsA("Trail") then
					v.Enabled = false
					if Destroy ~= false then
						task.delay(v.Lifetime, function() v:Destroy() end)
					end
				end
			end
		end

		local function EnableTrails(Object)
			for _, v in pairs(Object:GetDescendants()) do
				if v:IsA("Trail") then v.Enabled = true end
			end
		end

		local function DisableDescendants(Object, Destroy)
			for _, v in pairs(Object:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					v.Enabled = false
					if Destroy ~= false then
						task.delay(v.Lifetime.Max + 2, function() v:Destroy() end)
					end
				end
			end
		end

		local function EnableDescendants(Object)
			for _, v in pairs(Object:GetDescendants()) do
				if v:IsA("ParticleEmitter") then v.Enabled = true end
			end
		end

		local function WeldTo(a, b)
			local wc = Instance.new("WeldConstraint")
			wc.Part0 = a
			wc.Part1 = b
			wc.Parent = a
			return wc
		end

		local PTrack = Humanoid:LoadAnimation(Assets.axe)
		PTrack:Play()

		local axes = {}
		for i = 1, 2 do
			local hand = i == 1 and Character["Right Arm"] or Character["Left Arm"]
			local Axe = Assets.RealAxe:Clone()
			Axe.CFrame = hand.CFrame * CFrame.new(0, -1, -2) * CFrame.Angles(math.rad(180), 0, 0)
			Axe.Parent = effectsFolder
			game.Debris:AddItem(Axe, 3)
			WeldTo(Axe, hand)
			EnableDescendants(Axe)
			EnableTrails(Axe)
			table.insert(axes, Axe)
		end

		PlaySound("axestart", HRP)

		task.wait(0.25)

		local Disappear = Assets.disappear:Clone()
		Disappear.CFrame = HRP.CFrame * CFrame.new(0, -2, 0)
		Disappear.Parent = effectsFolder
		game.Debris:AddItem(Disappear, 3)
		EmitDescendants(Disappear)
		game:GetService("TweenService"):Create(Disappear.PointLight, TweenInfo.new(0.225, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { Brightness = 0 }):Play()

		local transp_parts = {}
		for _, Part in pairs(Character:GetDescendants()) do
			if (Part:IsA("BasePart") or Part:IsA("Decal")) and Part ~= Character.PrimaryPart and Part.Transparency < 1 then
				transp_parts[Part] = (Part.Parent == Character and Part.Name ~= "Head") and 0 or Part.Transparency
				game:GetService("TweenService"):Create(Part, TweenInfo.new(0.075, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
			end
		end
		for _, Part in ipairs(axes) do
			transp_parts[Part] = Part.Transparency
			game:GetService("TweenService"):Create(Part, TweenInfo.new(0.075, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
			DisableTrails(Part, false)
			DisableDescendants(Part, false)
		end

		PTrack:AdjustSpeed(0)
		task.wait(0.145)
		PlaySound("lightningdash", HRP)

		local EndCF = HRP.CFrame * CFrame.new(0, 0, -20)
		game:GetService("TweenService"):Create(HRP, TweenInfo.new(0.175, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = EndCF }):Play()

		local trail = Assets.trail:Clone()
		trail.CFrame = HRP.CFrame
		trail.Parent = effectsFolder
		game.Debris:AddItem(trail, 1)
		EmitDescendants(trail, 3)
		WeldTo(trail, HRP)

		task.wait(0.155)

		local Reappear = Assets.reappear:Clone()
		Reappear.CFrame = HRP.CFrame
		Reappear.Parent = effectsFolder
		game.Debris:AddItem(Reappear, 3)
		EmitDescendants(Reappear)
		game:GetService("TweenService"):Create(Reappear.PointLight, TweenInfo.new(0.225, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Brightness = 0 }):Play()

		PTrack.TimePosition = 0.167
		PTrack:AdjustSpeed(1)
		DisableDescendants(trail)

		for Part, Orig in pairs(transp_parts) do
			game:GetService("TweenService"):Create(Part, TweenInfo.new(0.065, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = Orig }):Play()
		end
		for _, Part in ipairs(axes) do
			game:GetService("TweenService"):Create(Part, TweenInfo.new(0.065, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 0 }):Play()
			EnableDescendants(Part)
			EnableTrails(Part)

			local Appear = Assets.appear:Clone()
			Appear.CFrame = Part.CFrame * CFrame.new(0, 0.4, 1)
			Appear.Parent = effectsFolder
			game.Debris:AddItem(Appear, 3)
			EmitDescendants(Appear)

			local Appearhandle = Assets.appearhandle:Clone()
			Appearhandle.CFrame = Part.CFrame * CFrame.new(0, 0, -2) * CFrame.Angles(0, math.rad(180), 0)
			Appearhandle.Parent = effectsFolder
			game.Debris:AddItem(Appearhandle, 3)
			EmitDescendants(Appearhandle)
		end

		PlaySound("spinaroundsonny", HRP)

		task.wait(0.02)
		task.wait(0.28)

		for _, obj in ipairs(axes) do
			for _, particle in pairs(obj:GetDescendants()) do
				if particle:IsA("ParticleEmitter") then
					particle.Rate *= 5.5
				end
			end
		end

		local EndCF2 = HRP.CFrame * CFrame.new(0, 0, -30)
		game:GetService("TweenService"):Create(HRP, TweenInfo.new(0.533, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = EndCF2 }):Play()
		task.wait(0.533)

		for _, obj in ipairs(axes) do
			for _, fx in pairs(obj:GetDescendants()) do
				if fx:IsA("ParticleEmitter") then
					fx.Rate /= 5.5
					task.delay(0.35, function() fx.LockedToPart = true end)
				end
			end
			task.delay(0.2, function()
				game:GetService("TweenService"):Create(obj.fx.PointLight, TweenInfo.new(0.225, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Brightness = 0 }):Play()
				DisableDescendants(obj)
				DisableTrails(obj)
			end)
		end

		task.wait(0.5)

		for _, Axe in ipairs(axes) do
			DisableDescendants(Axe)
			task.delay(0.5, function()
				local Appear = Assets.appear:Clone()
				Appear.CFrame = Axe.CFrame * CFrame.new(0, 0.4, 1)
				Appear.Parent = effectsFolder
				game.Debris:AddItem(Appear, 3)
				EmitDescendants(Appear)

				PlaySound("removal", HRP)

				local Appearhandle = Assets.appearhandle:Clone()
				Appearhandle.CFrame = Axe.CFrame * CFrame.new(0, 0, -2) * CFrame.Angles(0, math.rad(180), 0)
				Appearhandle.Parent = effectsFolder
				game.Debris:AddItem(Appearhandle, 3)
				EmitDescendants(Appearhandle)

				game:GetService("TweenService"):Create(Axe, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()

				task.wait(0.65)
				Axe:Destroy()
			end)
		end
	end,

