local function AnimateWithMoonFile(Params)
	local Immune = true
	local startTime = tick()
	local connection = nil
	local isCleaned = false

	local function Clean()
		if isCleaned then
			return
		else
			isCleaned = true
			connection:Disconnect()
			workspace.CurrentCamera.FieldOfView = 70
			Immune = false
			return
		end
	end

	local totalFrames = #Params:GetChildren()
	connection = game:GetService("RunService").PreRender:Connect(function()
		local elapsedFrames = math.ceil((tick() - startTime) / 0.016666666666666666)

		if totalFrames <= elapsedFrames then
			return Clean()
		else
			workspace.CurrentCamera.FieldOfView = Params[elapsedFrames].Value
			return
		end
	end)

	return Clean
end

local function createAfterimage(characterModel, tweenInfo1, tweenInfo2, timeDelay)
	local position = characterModel.HumanoidRootPart.Position
	local model = Instance.new("Model")
	model.Name = "Afterimage"

	local humanoid = Instance.new("Humanoid")
	humanoid.DisplayDistanceType = "None"
	humanoid.HealthDisplayType = "AlwaysOff"
	humanoid.BreakJointsOnDeath = false
	humanoid.EvaluateStateMachine = false
	humanoid.RequiresNeck = false
	humanoid.AutomaticScalingEnabled = false

	local shirt = characterModel:FindFirstChildOfClass("Shirt")
	local pants = characterModel:FindFirstChildOfClass("Pants")
	if shirt then
		shirt:Clone().Parent = model
	end
	if pants then
		pants:Clone().Parent = model
	end

	for _, part in ipairs(characterModel:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and not part:HasTag("RagdollCollider") then
			local clonePart = part:Clone()
			for _, child in ipairs(clonePart:GetChildren()) do
				if not child:IsA("SpecialMesh") then
					child:Destroy()
				end
			end

			clonePart.CollisionGroup = "NonPColDebri"
			clonePart.Anchored = true
			clonePart.CanCollide = false
			clonePart.CanTouch = false
			clonePart.CanQuery = false
			clonePart.Massless = true
			clonePart.CastShadow = false
			clonePart.Archivable = true
			clonePart.Transparency = 0
			clonePart.Parent = model

			TS:Create(clonePart, TweenInfo.new(table.unpack(tweenInfo1)), {
				Transparency = 1
			}):Play()

			task.delay(timeDelay / 60, function()
				TS:Create(clonePart, TweenInfo.new(table.unpack(tweenInfo2)), {
					CFrame = part.CFrame - (characterModel.HumanoidRootPart.Position - position)
				}):Play()
			end)
		elseif part:IsA("CharacterMesh") then
			part:Clone().Parent = model
		end
	end

	humanoid.Parent = model
	model.Parent = workspace.Thrown
	task.delay(tweenInfo1[1], model.Destroy, model)
end

