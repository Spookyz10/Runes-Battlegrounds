local function calculateBoundingBox(objects, referenceFrame)
	if typeof(objects) == "Instance" then
		objects = objects:GetDescendants()
	end

	if not referenceFrame then
		referenceFrame = CFrame.new()
	end

	local absValue = math.abs
	local minX, minY, minZ = 1e999, 1e999, 1e999
	local maxX, maxY, maxZ = -1e999, -1e999, -1e999

	for _, object in pairs(objects) do
		if object:IsA("BasePart") then
			local localCFrame = referenceFrame:toObjectSpace(object.CFrame)
			local size = object.Size
			local sizeX, sizeY, sizeZ = size.X, size.Y, size.Z

			local posX, posY, posZ, rX1, rX2, rX3, rY1, rY2, rY3, rZ1, rZ2, rZ3 = localCFrame:components()

			local halfX = 0.5 * (absValue(rX1) * sizeX + absValue(rX2) * sizeY + absValue(rX3) * sizeZ)
			local halfY = 0.5 * (absValue(rY1) * sizeX + absValue(rY2) * sizeY + absValue(rY3) * sizeZ)
			local halfZ = 0.5 * (absValue(rZ1) * sizeX + absValue(rZ2) * sizeY + absValue(rZ3) * sizeZ)

			minX = math.min(minX, posX - halfX)
			minY = math.min(minY, posY - halfY)
			minZ = math.min(minZ, posZ - halfZ)
			maxX = math.max(maxX, posX + halfX)
			maxY = math.max(maxY, posY + halfY)
			maxZ = math.max(maxZ, posZ + halfZ)
		end
	end

	local minVector = Vector3.new(minX, minY, minZ)
	local maxVector = Vector3.new(maxX, maxY, maxZ)

	return referenceFrame - referenceFrame.p + referenceFrame:pointToWorldSpace((maxVector + minVector) / 2), maxVector - minVector
end

local function deltaTimeWait(waitTime)
